# ── MCP Agent Toolkit – API keys ──────────────────────────────────────────
# Copy this file to `.env` and fill in your real keys.
#   cp .env.example .env
#
# Only Perplexity, Firecrawl and Glif need keys.
# Chrome DevTools and Playwright need no key (they drive a local browser).

# Perplexity – search the web / ask questions
# Get it at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Firecrawl – scrape / crawl / extract data from websites
# Get it at: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Glif – generate images and run Glif workflows
# Get it at: https://glif.app/settings/api-tokens
GLIF_API_TOKEN=
