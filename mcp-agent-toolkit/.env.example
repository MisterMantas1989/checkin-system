# ── MCP Agent Toolkit – API keys ──────────────────────────────────────────
# Copy this file to `.env` and fill in your real keys.
#   cp .env.example .env
#
# Perplexity, Firecrawl, Glif and Notion need keys.
# Chrome DevTools and Playwright need no key (they drive a local browser).

# Perplexity – search the web / ask questions
# Get it at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Firecrawl – scrape / crawl / extract data from websites
# Get it at: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Glif – generate images and run Glif workflows
# Get it at: https://glif.app/settings/api-tokens
GLIF_API_TOKEN=

# Notion – read/write pages & databases (e.g. publish a finished proposal)
# Create an integration and copy its token (starts with "ntn_"):
#   https://www.notion.so/profile/integrations
# Then share the target page/database with the integration in Notion.
NOTION_TOKEN=
