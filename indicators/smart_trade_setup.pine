//@version=6
// =============================================================================
//  Smart Trade Setup  —  Order Blocks + Fibonacci + Risk/Reward
// -----------------------------------------------------------------------------
//  Clean, readable trade-setup tool inspired by the reference video.
//
//  Readability first:
//   - The trade setup is projected to the RIGHT of the last candle (like the
//     TradingView position tool) so it never covers price history.
//   - By default only the latest signal is shown ("Both sides" optional).
//   - Zones are highly transparent, lines are thin, levels are labelled.
//
//  Elements:
//   1. Swing structure (pivots)
//   2. Faint supply/demand order blocks at swing tips
//   3. Thin Support / Resistance lines at the active levels
//   4. Optional Fibonacci retracement on the latest swing leg
//   5. Trade setup: Entry / Stop-Loss (risk) / Target (reward) projected forward
// =============================================================================
indicator("Smart Trade Setup", "Smart Trade Setup", overlay = true, max_boxes_count = 200, max_lines_count = 200, max_labels_count = 200)

// ===================== Inputs ================================================
g_str = "Structure"
pivLen = input.int(5, "Swing strength", minval = 1, group = g_str, tooltip = "Higher = only larger swings are detected.")

g_ob = "Order blocks"
showOB   = input.bool(true, "Show order blocks", group = g_ob)
obMax    = input.int(4, "How many to keep", minval = 1, maxval = 20, group = g_ob)
obTransp = input.int(90, "Transparency", minval = 50, maxval = 100, group = g_ob)

g_sr = "Support / Resistance"
showSR = input.bool(true, "Show S/R lines", group = g_sr)

g_fib = "Fibonacci"
showFib = input.bool(false, "Show Fibonacci (last swing)", group = g_fib)

g_set = "Trade setup (risk / reward)"
setupMode  = input.string("Auto (nearest level)", "Show setup", options = ["Auto (nearest level)", "Both sides", "Off"], group = g_set)
rrRatio    = input.float(2.0, "Reward : Risk", minval = 0.1, step = 0.1, group = g_set)
stopMult   = input.float(1.0, "Stop buffer (ATR ×)", minval = 0.0, step = 0.1, group = g_set)
setupFwd   = input.int(30, "Setup width (bars, drawn to the right)", minval = 5, maxval = 300, group = g_set)
zoneTransp = input.int(85, "Zone transparency", minval = 50, maxval = 100, group = g_set)

// ===================== Derived colours =======================================
atr     = ta.atr(14)
cOB     = color.new(color.gray, obTransp)
cRisk   = color.new(color.red,  zoneTransp)
cReward = color.new(color.teal, zoneTransp)

// ===================== State =================================================
var box[] obBoxes = array.new<box>()

var float lastHigh    = na
var int   lastHighBar = na
var float lastLow     = na
var int   lastLowBar  = na

// two most recent pivots (for the Fibonacci leg)
var float prevSig    = na
var int   prevSigBar = na
var float lastSig    = na
var int   lastSigBar = na

// live drawing handles (redrawn on the last bar)
var line  srResLine = na
var label srResLbl  = na
var line  srSupLine = na
var label srSupLbl  = na
var line[]  fibLines  = array.new<line>()
var label[] fibLabels = array.new<label>()
var box[]   setBoxes  = array.new<box>()
var line[]  setLines  = array.new<line>()
var label[] setLabels = array.new<label>()

// ===================== Pivots ================================================
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)

if not na(ph)
    lastHigh    := ph
    lastHighBar := bar_index - pivLen
    prevSig     := lastSig
    prevSigBar  := lastSigBar
    lastSig     := ph
    lastSigBar  := bar_index - pivLen

if not na(pl)
    lastLow    := pl
    lastLowBar := bar_index - pivLen
    prevSig    := lastSig
    prevSigBar := lastSigBar
    lastSig    := pl
    lastSigBar := bar_index - pivLen

// ===================== Order blocks (faint, body-sized) ======================
if showOB and (not na(ph) or not na(pl))
    bTop = math.max(open[pivLen], close[pivLen])
    bBot = math.min(open[pivLen], close[pivLen])
    bx = box.new(bar_index - pivLen, bTop, bar_index - pivLen + 5, bBot, border_color = color.new(color.gray, 70), bgcolor = cOB)
    array.push(obBoxes, bx)
    if array.size(obBoxes) > obMax
        box.delete(array.shift(obBoxes))

// ===================== Setup drawing helper ==================================
drawSetup(bool isSell, float entry, int fromX, int toX, float risk) =>
    sl  = isSell ? entry + risk : entry - risk
    tgt = isSell ? entry - risk * rrRatio : entry + risk * rrRatio
    rb = box.new(fromX, math.max(entry, sl),  toX, math.min(entry, sl),  border_color = color.new(color.red, 55),  bgcolor = cRisk)
    tb = box.new(fromX, math.max(entry, tgt), toX, math.min(entry, tgt), border_color = color.new(color.teal, 55), bgcolor = cReward)
    el = line.new(fromX, entry, toX, entry, color = color.new(color.gray, 0), width = 1, style = line.style_dashed)
    array.push(setBoxes, rb)
    array.push(setBoxes, tb)
    array.push(setLines, el)
    side = isSell ? "Sell" : "Buy"
    array.push(setLabels, label.new(toX, entry, side + " Entry " + str.tostring(entry, format.mintick), style = label.style_label_left, color = color.new(isSell ? color.red : color.green, 15), textcolor = color.white, size = size.small))
    array.push(setLabels, label.new(toX, sl,  "Stop-Loss " + str.tostring(sl,  format.mintick), style = label.style_label_left, color = color.new(color.red, 25),  textcolor = color.white, size = size.small))
    array.push(setLabels, label.new(toX, tgt, "Target " + str.tostring(tgt, format.mintick), style = label.style_label_left, color = color.new(color.teal, 25), textcolor = color.white, size = size.small))

// ===================== Live layer (drawn on the last bar) ====================
if barstate.islast
    // ---- clear previous handles ----
    line.delete(srResLine)
    label.delete(srResLbl)
    line.delete(srSupLine)
    label.delete(srSupLbl)
    for l in fibLines
        line.delete(l)
    for lb in fibLabels
        label.delete(lb)
    array.clear(fibLines)
    array.clear(fibLabels)
    for b in setBoxes
        box.delete(b)
    for l in setLines
        line.delete(l)
    for lb in setLabels
        label.delete(lb)
    array.clear(setBoxes)
    array.clear(setLines)
    array.clear(setLabels)

    rightX = bar_index + setupFwd

    // ---- Support / Resistance ----
    if showSR and not na(lastHigh)
        srResLine := line.new(lastHighBar, lastHigh, rightX, lastHigh, color = color.new(color.red, 0), width = 1)
        srResLbl  := label.new(rightX, lastHigh, "Resistance", style = label.style_label_left, color = color.new(color.red, 80), textcolor = color.white, size = size.small)
    if showSR and not na(lastLow)
        srSupLine := line.new(lastLowBar, lastLow, rightX, lastLow, color = color.new(color.green, 0), width = 1)
        srSupLbl  := label.new(rightX, lastLow, "Support", style = label.style_label_left, color = color.new(color.green, 80), textcolor = color.white, size = size.small)

    // ---- Fibonacci on the most recent swing leg ----
    if showFib and not na(prevSig) and not na(lastSig)
        levels = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0)
        topPx = math.max(prevSig, lastSig)
        botPx = math.min(prevSig, lastSig)
        xL = math.min(prevSigBar, lastSigBar)
        for i = 0 to array.size(levels) - 1
            lvl = array.get(levels, i)
            px  = botPx + (topPx - botPx) * lvl
            ln  = line.new(xL, px, rightX, px, color = color.new(color.gray, 40), width = 1, style = line.style_dotted)
            lb  = label.new(xL, px, str.tostring(lvl, "0.###"), style = label.style_label_right, color = color.new(color.gray, 80), textcolor = color.white, size = size.tiny)
            array.push(fibLines, ln)
            array.push(fibLabels, lb)

    // ---- Trade setup (projected to the right) ----
    if setupMode != "Off"
        risk = atr * stopMult
        risk := risk <= 0 ? syminfo.mintick * 10 : risk
        fromX = bar_index
        haveH = not na(lastHigh)
        haveL = not na(lastLow)
        if setupMode == "Both sides"
            if haveH
                drawSetup(true, lastHigh, fromX, rightX, risk)
            if haveL
                drawSetup(false, lastLow, fromX, rightX, risk)
        else  // Auto: anchor on the S/R level price is closest to
            if haveH and haveL
                if math.abs(close - lastHigh) <= math.abs(close - lastLow)
                    drawSetup(true, lastHigh, fromX, rightX, risk)
                else
                    drawSetup(false, lastLow, fromX, rightX, risk)
            else if haveH
                drawSetup(true, lastHigh, fromX, rightX, risk)
            else if haveL
                drawSetup(false, lastLow, fromX, rightX, risk)

// ===================== Alerts ================================================
alertcondition(not na(ph), "Sell setup", "New swing high — sell setup updated.")
alertcondition(not na(pl), "Buy setup",  "New swing low — buy setup updated.")
