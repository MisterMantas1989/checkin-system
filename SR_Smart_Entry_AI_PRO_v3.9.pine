preBuyColor = color.new(color.aqua, 25)
preSellColor = color.new(color.orange, 25)

// CONSTANTS moved earlier

//======================================================
// HELPERS
//======================================================
safeDiv(float num, float den, float fallback) =>
    den != 0 and not na(den) ? num / den : fallback

safeAtrNorm(float value, float atr_) =>
    safeDiv(value, math.max(atr_, syminfo.mintick), 0.0)

clamp(float v, float lo, float hi) =>
    math.max(lo, math.min(v, hi))

isValidPrice(float v) =>
    not na(v) and v > 0

signedBarVolume() =>
    close >= open ? volume : -volume

minAbove(float entry, float a, float b, float c, float d, float e, float f, float g, float h) =>
    float[] candidates = array.from(a, b, c, d, e, f, g, h)
    float result = na
    for i = 0 to array.size(candidates) - 1
        float v = array.get(candidates, i)
        if isValidPrice(v) and v > entry
            result := na(result) ? v : math.min(result, v)
    result

maxBelow(float entry, float a, float b, float c, float d, float e, float f, float g, float h) =>
    float[] candidates = array.from(a, b, c, d, e, f, g, h)
    float result = na
    for i = 0 to array.size(candidates) - 1
        float v = array.get(candidates, i)
        if isValidPrice(v) and v < entry
            result := na(result) ? v : math.max(result, v)
    result

zoneDistanceAtr(float price_, float zoneTop_, float zoneBottom_, float atr_) =>
    float dist_ = 99.0
    if not na(zoneTop_) and not na(zoneBottom_)
        float zLo = math.min(zoneTop_, zoneBottom_)
        float zHi = math.max(zoneTop_, zoneBottom_)
        if price_ >= zLo and price_ <= zHi
            dist_ := 0.0
        else if price_ < zLo
            dist_ := safeAtrNorm(zLo - price_, atr_)
        else
            dist_ := safeAtrNorm(price_ - zHi, atr_)
    dist_

clearLine(line ln) =>
    if not na(ln)
        line.delete(ln)

clearLabel(label lb) =>
    if not na(lb)
        label.delete(lb)

gradeFromScore(float score) =>
    string g = "C"
    if score >= 9.0
        g := "A+"
    else if score >= 6.8
        g := "A"
    else if score >= 5.4
        g := "B"
    g

confFromScore(float score) =>
    string c = "LOW"
    if score >= 9.0
        c := "HIGH"
    else if score >= 7.2
        c := "MED"
    c

intentText(int intent) =>
    string txt = "NONE"
    if intent == INTENT_REVERSAL
        txt := "REVERSAL"
    else if intent == INTENT_CONTINUATION
        txt := "CONT"
    else if intent == INTENT_SCALP
        txt := "SCALP"
    else if intent == INTENT_EXPANSION
        txt := "EXPANSION"
    else if intent == INTENT_LIQUIDITY
        txt := "LIQUIDITY"
    txt

zoneText(float zq) =>
    string txt = "WEAK"
    if zq >= 2.8
        txt := "STRONG"
    else if zq >= 1.6
        txt := "MED"
    txt

regimeText(int regime) =>
    string txt = "RANGE"
    if regime == REGIME_TREND_UP
        txt := "TREND UP"
    else if regime == REGIME_TREND_DOWN
        txt := "TREND DOWN"
    else if regime == REGIME_COMPRESSION
        txt := "COMPRESSION"
    else if regime == REGIME_EXPANSION
        txt := "EXPANSION"
    else if regime == REGIME_CHAOTIC
        txt := "CHAOTIC"
    txt

coinProfileText(int profile) =>
    string txt = "NEUTRAL"
    if profile == COIN_PROFILE_TREND
        txt := "TREND"
    else if profile == COIN_PROFILE_WICKY
        txt := "WICKY"
    else if profile == COIN_PROFILE_CHOPPY
        txt := "CHOPPY"
    else if profile == COIN_PROFILE_EXPLOSIVE
        txt := "EXPLOSIVE"
    txt

marketStructureText(int state) =>
    string txt = "NEUTRAL"
    if state == 1
        txt := "BULLISH"
    else if state == -1
        txt := "BEARISH"
    txt

coinDnaText(int dna) =>
    string txt = "HYBRID"
    if dna == COIN_DNA_TREND_DRIVER
        txt := "TREND_DRIVER"
    else if dna == COIN_DNA_LIQUIDITY_HUNTER
        txt := "LIQ_HUNTER"
    else if dna == COIN_DNA_MEAN_REVERTER
        txt := "MEAN_REV"
    else if dna == COIN_DNA_MOMENTUM_EXPLOSIVE
        txt := "MOMO_EXP"
    txt

dnaCodeFromProfile(int profile) =>
    int dna = COIN_DNA_HYBRID
    if profile == COIN_PROFILE_TREND
        dna := COIN_DNA_TREND_DRIVER
    else if profile == COIN_PROFILE_WICKY
        dna := COIN_DNA_LIQUIDITY_HUNTER
    else if profile == COIN_PROFILE_CHOPPY
        dna := COIN_DNA_MEAN_REVERTER
    else if profile == COIN_PROFILE_EXPLOSIVE
        dna := COIN_DNA_MOMENTUM_EXPLOSIVE
    dna

preSweepText(int bias) =>
    string txt = "NONE"
    if bias == 1
        txt := "UP"
    else if bias == -1
        txt := "DOWN"
    txt


d1_zoneMid(float zTop, float zBottom) =>
    not na(zTop) and not na(zBottom) ? (zTop + zBottom) * 0.5 : na

d1_zoneHalfWidth(float zTop, float zBottom, float atr_) =>
    not na(zTop) and not na(zBottom) ? math.max(math.abs(zTop - zBottom) * 0.5, atr_ * 0.18) : na

d1_dynamicZoneWidth(float atr_, float wickinessScore_, float fakeoutScore_, float continuationScore_, bool bullImpulse_, bool bearImpulse_) =>
    float mult = ZONE_WIDTH_ATR_MULT
    mult += wickinessScore_ > 1.10 ? 0.08 : 0.0
    mult += fakeoutScore_ > 0.24 ? 0.06 : 0.0
    mult += continuationScore_ > 0.40 ? 0.03 : 0.0
    mult += (bullImpulse_ or bearImpulse_) ? 0.03 : 0.0
    atr_ * clamp(mult, is5m ? 0.42 : 0.50, is5m ? 0.95 : 1.05)

//======================================================
// CACHED CORE SERIES
//======================================================
volSma20 = ta.sma(volume, 20)

high3Prev = ta.highest(high[1], 3)
low3Prev = ta.lowest(low[1], 3)
high4Prev = ta.highest(high[1], 4)
low4Prev = ta.lowest(low[1], 4)
high5Now = ta.highest(high, 5)
low5Now = ta.lowest(low, 5)
high5Prev = ta.highest(high[1], 5)
low5Prev = ta.lowest(low[1], 5)

signedVol = signedBarVolume()

//======================================================
// ENGINE HELPERS
//======================================================
d1_sessionFlags(int hr) =>
    bool asia = hr >= 1 and hr < 8
    bool london = hr >= 8 and hr < 14
    bool ny = hr >= 14 and hr < 23

    int sc = asia ? SESSION_ASIA : london ? SESSION_LONDON : (hr >= 14 and hr < 17 ? SESSION_NY_OPEN : ny ? SESSION_NY_LATE : SESSION_OFF)

    bool asiaPrev = bar_index > 0 ? asia[1] : false
    bool londonPrev = bar_index > 0 ? london[1] : false
    bool nyPrev = bar_index > 0 ? ny[1] : false

    bool newAsia = asia and not asiaPrev
    bool newLondon = london and not londonPrev
    bool newNy = ny and not nyPrev

    bool asiaC = not asia and asiaPrev
    bool londonC = not london and londonPrev
    bool nyC = not ny and nyPrev

    [sc, asia, london, ny, newAsia, newLondon, newNy, asiaC, londonC, nyC]

//======================================================
// PROFILE ENGINE
//======================================================
d1_profileEngine(float close_, float open_, float high_, float low_, float emaFast_, float atr_) =>
    float candleBody_ = math.abs(close_ - open_)
    float upperWick_ = math.max(high_ - math.max(open_, close_), 0.0)
    float lowerWick_ = math.max(math.min(open_, close_) - low_, 0.0)
    float barRange_ = math.max(high_ - low_, syminfo.mintick)
    float bodyBase_ = math.max(candleBody_, syminfo.mintick)

    bool bodyOk_ = not USE_BODY_FILTER or candleBody_ >= atr_ * MIN_BODY_ATR

    [candleBody_, upperWick_, lowerWick_, barRange_, bodyBase_, bodyOk_]

//======================================================
// MARKET ENGINE
//======================================================
d1_marketEngine(float close_, float open_, float high_, float low_, float emaFast_, float emaSlow_, float atr_, float atrSlow_, float candleBody_, float upperWick_, float lowerWick_, float barRange_) =>
    bool trendUpBasic_ = close_ > emaSlow_ and emaFast_ >= emaSlow_
    bool trendDownBasic_ = close_ < emaSlow_ and emaFast_ <= emaSlow_

    float volatilityRatio_ = atrSlow_ > 0 ? atr_ / atrSlow_ : 1.0
    float avgRange20_ = ta.sma(barRange_, 20)
    float compressionScore_ = avgRange20_ > 0 ? math.max(0.0, 1.0 - math.min(barRange_ / avgRange20_, 1.2)) : 0.0
    float expansionScoreRaw_ = avgRange20_ > 0 ? math.min(barRange_ / avgRange20_, 2.0) : 1.0

    float emaFastSlope_ = emaFast_ - nz(emaFast_[5], emaFast_)
    float emaSlowSlope_ = emaSlow_ - nz(emaSlow_[5], emaSlow_)
    float overlapRaw_ = math.min(high_, nz(high_[1], high_)) - math.max(low_, nz(low_[1], low_))
    float overlapPct_ = barRange_ > 0 ? math.max(overlapRaw_, 0) / barRange_ : 0.0
    float noiseScoreRegime_ = ta.sma(overlapPct_, 10)

    int regimeCode_ = REGIME_RANGE
    if volatilityRatio_ < 0.82 and compressionScore_ > 0.35
        regimeCode_ := REGIME_COMPRESSION
    else if volatilityRatio_ > 1.14 and expansionScoreRaw_ > 1.20
        regimeCode_ := REGIME_EXPANSION
    else if trendUpBasic_ and emaFastSlope_ > 0 and emaSlowSlope_ >= 0
        regimeCode_ := REGIME_TREND_UP
    else if trendDownBasic_ and emaFastSlope_ < 0 and emaSlowSlope_ <= 0
        regimeCode_ := REGIME_TREND_DOWN
    else if noiseScoreRegime_ > 0.65
        regimeCode_ := REGIME_CHAOTIC
    else
        regimeCode_ := REGIME_RANGE

    float avgUpperWick_ = ta.sma(upperWick_, 20)
    float avgLowerWick_ = ta.sma(lowerWick_, 20)
    float avgBody_ = ta.sma(candleBody_, 20)
    float wickinessScore_ = avgBody_ > syminfo.mintick ? (avgUpperWick_ + avgLowerWick_) / avgBody_ : 0.0

    float bodyEfficiency_ = barRange_ > syminfo.mintick ? candleBody_ / barRange_ : 0.0
    float avgBodyEfficiency_ = ta.sma(bodyEfficiency_, 20)

    bool bullFakeout_ = high_ > nz(high_[1], high_) and close_ < nz(high_[1], high_)
    bool bearFakeout_ = low_ < nz(low_[1], low_) and close_ > nz(low_[1], low_)
    float fakeoutScore_ = ta.sma((bullFakeout_ or bearFakeout_) ? 1.0 : 0.0, 30)

    bool bullContinuation_ = close_ > nz(high_[1], high_)
    bool bearContinuation_ = close_ < nz(low_[1], low_)
    float continuationScore_ = ta.sma((bullContinuation_ or bearContinuation_) ? 1.0 : 0.0, 30)

    float noiseScoreMarket_ = 1.0 - avgBodyEfficiency_

    bool bodyShrink_ = candleBody_ < nz(candleBody_[1], candleBody_) and nz(candleBody_[1], candleBody_) < nz(candleBody_[2], candleBody_)
    bool rangeShrink_ = barRange_ < nz(barRange_[1], barRange_) and nz(barRange_[1], barRange_) < nz(barRange_[2], barRange_)
    bool weakBullClose_ = close_ < high_ - barRange_ * 0.45
    bool weakBearClose_ = close_ > low_ + barRange_ * 0.45
    bool efficiencyDrop_ = avgBodyEfficiency_ < nz(avgBodyEfficiency_[3], avgBodyEfficiency_)

    [trendUpBasic_, trendDownBasic_, volatilityRatio_, avgRange20_, compressionScore_, regimeCode_, wickinessScore_, avgBodyEfficiency_, fakeoutScore_, continuationScore_, noiseScoreMarket_, bodyShrink_, rangeShrink_, weakBullClose_, weakBearClose_, efficiencyDrop_]

//======================================================
// COIN BEHAVIOR ENGINE
//======================================================
d1_coinBehaviorEngine(float close_, float atr_, float barRange_, float wickinessScore_, float noiseScoreMarket_, float continuationScore_, float fakeoutScore_, float avgBodyEfficiency_) =>
    float coinAtrPct_ = close_ != 0 ? atr_ / close_ : 0.0
    float coinAtrPctBase_ = ta.sma(coinAtrPct_, CB_LOOKBACK)
    float coinAtrPctRel_ = coinAtrPctBase_ > 0 ? coinAtrPct_ / coinAtrPctBase_ : 1.0

    float wickinessBase_ = ta.sma(wickinessScore_, CB_LOOKBACK)
    float wickinessRel_ = wickinessBase_ > 0 ? wickinessScore_ / wickinessBase_ : 1.0

    float noiseBase_ = ta.sma(noiseScoreMarket_, CB_LOOKBACK)
    float noiseRel_ = noiseBase_ > 0 ? noiseScoreMarket_ / noiseBase_ : 1.0

    float continuationBase_ = ta.sma(continuationScore_, CB_LOOKBACK)
    float continuationRel_ = continuationBase_ > 0 ? continuationScore_ / continuationBase_ : 1.0

    float fakeoutBase_ = ta.sma(fakeoutScore_, CB_LOOKBACK)
    float fakeoutRel_ = fakeoutBase_ > 0 ? fakeoutScore_ / fakeoutBase_ : 1.0

    float efficiencyBase_ = ta.sma(avgBodyEfficiency_, CB_LOOKBACK)
    float efficiencyRel_ = efficiencyBase_ > 0 ? avgBodyEfficiency_ / efficiencyBase_ : 1.0

    float rangeBase_ = ta.sma(barRange_, CB_LOOKBACK)
    float rangeRel_ = rangeBase_ > 0 ? barRange_ / rangeBase_ : 1.0

    float liqProxy_ = ta.sma(volume * close_, 20)
    float liqProxyBase_ = ta.sma(volume * close_, CB_LOOKBACK)
    float liqProxyRel_ = liqProxyBase_ > 0 ? liqProxy_ / liqProxyBase_ : 1.0

    bool isWickyCoin_ = ENABLE_COIN_BEHAVIOR_ENGINE and wickinessRel_ > 1.08 and fakeoutRel_ > 1.05 and efficiencyRel_ < 1.00
    bool isTrendCoin_ = ENABLE_COIN_BEHAVIOR_ENGINE and continuationRel_ > 1.06 and noiseRel_ < 1.02 and efficiencyRel_ > 1.01 and fakeoutRel_ <= 1.06
    bool isChoppyCoin_ = ENABLE_COIN_BEHAVIOR_ENGINE and noiseRel_ > 1.08 and continuationRel_ < 1.00 and fakeoutRel_ >= 1.00
    bool isExplosiveCoin_ = ENABLE_COIN_BEHAVIOR_ENGINE and coinAtrPctRel_ > 1.10 and rangeRel_ > 1.05
    bool isLowLiquidityCoin_ = ENABLE_COIN_BEHAVIOR_ENGINE and liqProxyRel_ < 0.92 and wickinessRel_ > 1.02

    int coinProfileCode_ = COIN_PROFILE_NEUTRAL
    if isTrendCoin_
        coinProfileCode_ := COIN_PROFILE_TREND
    else if isWickyCoin_
        coinProfileCode_ := COIN_PROFILE_WICKY
    else if isChoppyCoin_
        coinProfileCode_ := COIN_PROFILE_CHOPPY
    else if isExplosiveCoin_
        coinProfileCode_ := COIN_PROFILE_EXPLOSIVE
    else
        coinProfileCode_ := COIN_PROFILE_NEUTRAL

    float cbSpaceRelax_ = 0.0
    float cbStopBoost_ = 0.0
    float cbRetestBoost_ = 0.0
    float cbSweepBoost_ = 0.0
    float cbRrRelax_ = 0.0
    float cbLiqRelax_ = 0.0
    float cbBreakoutBias_ = 0.0
    float cbReversalBias_ = 0.0
    float cbLateEntryBoost_ = 0.0
    float cbWickAllowance_ = 0.0

    if ENABLE_COIN_BEHAVIOR_ENGINE
        if isWickyCoin_
            cbSpaceRelax_ += 0.04
            cbStopBoost_ += 0.05
            cbRetestBoost_ += 0.03
            cbSweepBoost_ += 0.03
            cbRrRelax_ += 0.03
            cbLiqRelax_ += 0.22
            cbReversalBias_ += 0.18
            cbBreakoutBias_ -= 0.08
            cbWickAllowance_ += 0.22
        if isChoppyCoin_
            cbSpaceRelax_ += 0.08
            cbStopBoost_ += 0.03
            cbRetestBoost_ += 0.04
            cbSweepBoost_ += 0.02
            cbRrRelax_ += 0.05
            cbLiqRelax_ += 0.18
            cbReversalBias_ += 0.20
            cbBreakoutBias_ -= 0.15
            cbLateEntryBoost_ += 0.06
        if isTrendCoin_
            cbSpaceRelax_ -= 0.03
            cbStopBoost_ -= 0.01
            cbRetestBoost_ -= 0.01
            cbSweepBoost_ -= 0.01
            cbRrRelax_ -= 0.02
            cbBreakoutBias_ += 0.18
            cbReversalBias_ -= 0.08
            cbLateEntryBoost_ += 0.08
        if isExplosiveCoin_
            cbSpaceRelax_ -= 0.03
            cbStopBoost_ += 0.03
            cbRetestBoost_ += 0.01
            cbSweepBoost_ += 0.02
            cbRrRelax_ -= 0.02
            cbBreakoutBias_ += 0.15
            cbLateEntryBoost_ += 0.08
        if isLowLiquidityCoin_
            cbSpaceRelax_ += 0.04
            cbStopBoost_ += 0.05
            cbRetestBoost_ += 0.02
            cbSweepBoost_ += 0.03
            cbRrRelax_ += 0.03
            cbLiqRelax_ += 0.18
            cbWickAllowance_ += 0.12

    cbSpaceRelax_ := clamp(cbSpaceRelax_, -CB_SPACE_RELAX_MAX, CB_SPACE_RELAX_MAX)
    cbStopBoost_ := clamp(cbStopBoost_, -CB_STOPPAD_MAX, CB_STOPPAD_MAX)
    cbRetestBoost_ := clamp(cbRetestBoost_, -CB_RETEST_MAX, CB_RETEST_MAX)
    cbSweepBoost_ := clamp(cbSweepBoost_, -CB_SWEEP_MAX, CB_SWEEP_MAX)
    cbRrRelax_ := clamp(cbRrRelax_, -CB_RR_RELAX_MAX, CB_RR_RELAX_MAX)
    cbLiqRelax_ := clamp(cbLiqRelax_, -CB_LIQ_RELAX_MAX, CB_LIQ_RELAX_MAX)

    float dynamicMaxWickToBody_ = clamp(MAX_WICK_TO_BODY + cbWickAllowance_, 0.5, 5.0)
    float dynamicLateEntryAtr_ = clamp(MAX_DISTANCE_FROM_EMA_ATR + cbLateEntryBoost_, 0.2, 5.0)
    float minValidRrDynamic_ = clamp(math.max(0.60, MIN_VALID_RR - cbRrRelax_), 0.60, 3.0)
    float liqThresholdDynamic_ = clamp(math.max(2.5, LIQUIDITY_SCORE_THRESHOLD - cbLiqRelax_), 1.0, 20.0)
    float lmThresholdDynamic_ = clamp(math.max(3.8, LM_PLOT_SCORE_THRESHOLD - cbLiqRelax_ * 0.6), 1.0, 20.0)
    float preScoreThresholdDynamic_ = clamp(math.max(1.2, PRE_SWEEP_SCORE_THRESHOLD - cbLiqRelax_ * 0.35), 1.2, 20.0)

    [coinProfileCode_, cbSpaceRelax_, cbStopBoost_, cbRetestBoost_, cbSweepBoost_, cbBreakoutBias_, cbReversalBias_, dynamicMaxWickToBody_, dynamicLateEntryAtr_, minValidRrDynamic_, liqThresholdDynamic_, lmThresholdDynamic_, preScoreThresholdDynamic_]

//======================================================
// CROWDING ENGINE
//======================================================
//======================================================
// STRUCTURE ENGINE
//======================================================
d1_structureEngine() =>
    float structurePivotHigh_ = ta.pivothigh(high, STRUCTURE_PIVOT_LEN, STRUCTURE_PIVOT_LEN)
    float structurePivotLow_ = ta.pivotlow(low, STRUCTURE_PIVOT_LEN, STRUCTURE_PIVOT_LEN)
    [structurePivotHigh_, structurePivotLow_]

//======================================================
// MICRO RANGE ENGINE
//======================================================
d1_microRangeEngine(float atr_) =>
    float microRangeHigh_ = ta.highest(high, MICRO_RANGE_LOOKBACK)
    float microRangeLow_ = ta.lowest(low, MICRO_RANGE_LOOKBACK)
    float microRangeWidth_ = microRangeHigh_ - microRangeLow_

    bool microCompression_ = true
    int compBars_ = math.min(MICRO_RANGE_COMP_BARS, bar_index + 1)

    for i = 0 to compBars_ - 1
        float rangeI = high[i] - low[i]
        float atrI = nz(atr_[i], atr_)
        microCompression_ := microCompression_ and (rangeI < atrI * 0.85)

    bool microRangeActive_ = ENABLE_MICRO_RANGE_ENGINE and not na(microRangeWidth_) and microRangeWidth_ < atr_ * MICRO_RANGE_ATR_FRAC and microCompression_
    microRangeActive_

//======================================================
// DNA ENGINE
//======================================================
// HTF ENGINE
//======================================================
d1_htfEngine() =>
    [htfClose_, htfEmaFast_, htfEmaSlow_] = request.security(
        syminfo.tickerid,
        HTF_TF,
        [close, ta.ema(close, EMA_FAST_LEN), ta.ema(close, EMA_SLOW_LEN)],
        gaps=barmerge.gaps_off,
        lookahead=barmerge.lookahead_off
    )

    [htfLastPivotHigh_, htfLastPivotLow_] = request.security(
        syminfo.tickerid,
        HTF_TF,
        [
            ta.valuewhen(not na(ta.pivothigh(high, HTF_PIVOT_LEN, HTF_PIVOT_LEN)), ta.pivothigh(high, HTF_PIVOT_LEN, HTF_PIVOT_LEN), 0),
            ta.valuewhen(not na(ta.pivotlow(low, HTF_PIVOT_LEN, HTF_PIVOT_LEN)), ta.pivotlow(low, HTF_PIVOT_LEN, HTF_PIVOT_LEN), 0)
        ],
        gaps=barmerge.gaps_off,
        lookahead=barmerge.lookahead_off
    )

    bool htfTrendUp_ = ENABLE_HTF_ALIGNMENT and htfClose_ > htfEmaSlow_ and htfEmaFast_ >= htfEmaSlow_
    bool htfTrendDown_ = ENABLE_HTF_ALIGNMENT and htfClose_ < htfEmaSlow_ and htfEmaFast_ <= htfEmaSlow_

    bool htfBullBos_ = ENABLE_HTF_ALIGNMENT and not na(htfLastPivotHigh_) and htfClose_ > htfLastPivotHigh_
    bool htfBearBos_ = ENABLE_HTF_ALIGNMENT and not na(htfLastPivotLow_) and htfClose_ < htfLastPivotLow_

    int htfBias_ = htfTrendUp_ ? 1 : htfTrendDown_ ? -1 : 0
    int htfStructureBias_ = htfBullBos_ ? 1 : htfBearBos_ ? -1 : htfBias_

    [htfLastPivotHigh_, htfLastPivotLow_, htfStructureBias_]

//======================================================
// TRUE LIQUIDITY ENGINE
//======================================================
d1_trueLiquidityEngine(float resistanceTop_, float resistanceBottom_, float supportTop_, float supportBottom_, float lastPivotHigh_, float lastPivotLow_, float htfLastPivotHigh_, float htfLastPivotLow_, float atr_) =>
    [dayHighPrev_, dayLowPrev_] = request.security(
        syminfo.tickerid,
        "D",
        [high[1], low[1]],
        gaps=barmerge.gaps_off,
        lookahead=barmerge.lookahead_off
    )

    [weekHighPrev_, weekLowPrev_] = request.security(
        syminfo.tickerid,
        "W",
        [high[1], low[1]],
        gaps=barmerge.gaps_off,
        lookahead=barmerge.lookahead_off
    )

    float rangePoolHigh_ = ta.highest(high, TLP_RANGE_LOOKBACK)
    float rangePoolLow_ = ta.lowest(low, TLP_RANGE_LOOKBACK)

    float upperClusterCount_ = 0.0
    float lowerClusterCount_ = 0.0
    int clusterLookback_ = math.min(10, bar_index)

    for i = 1 to clusterLookback_
        if not na(lastPivotHigh_)
            upperClusterCount_ += math.abs(high[i] - lastPivotHigh_) <= atr_ * TLP_CLUSTER_TOL_ATR ? 1.0 : 0.0
        if not na(lastPivotLow_)
            lowerClusterCount_ += math.abs(low[i] - lastPivotLow_) <= atr_ * TLP_CLUSTER_TOL_ATR ? 1.0 : 0.0

    bool majorUpperCluster_ = upperClusterCount_ >= 2
    bool majorLowerCluster_ = lowerClusterCount_ >= 2

    float trueLiquidityHigh_ = minAbove(close, resistanceTop_, resistanceBottom_, lastPivotHigh_, dayHighPrev_, weekHighPrev_, rangePoolHigh_, htfLastPivotHigh_, float(na))
    float trueLiquidityLow_ = maxBelow(close, supportTop_, supportBottom_, lastPivotLow_, dayLowPrev_, weekLowPrev_, rangePoolLow_, htfLastPivotLow_, float(na))

    float distToTrueLiqHighAtr_ = na(trueLiquidityHigh_) ? 99.0 : safeAtrNorm(trueLiquidityHigh_ - close, atr_)
    float distToTrueLiqLowAtr_ = na(trueLiquidityLow_) ? 99.0 : safeAtrNorm(close - trueLiquidityLow_, atr_)

    bool nearTrueUpperPool_ = ENABLE_TRUE_LIQUIDITY_POOLS and distToTrueLiqHighAtr_ <= TLP_NEAR_POOL_ATR
    bool nearTrueLowerPool_ = ENABLE_TRUE_LIQUIDITY_POOLS and distToTrueLiqLowAtr_ <= TLP_NEAR_POOL_ATR

    float liquidityPoolScoreUp_ = 0.0
    liquidityPoolScoreUp_ += nearTrueUpperPool_ ? 1.0 : 0.0
    liquidityPoolScoreUp_ += majorUpperCluster_ ? 0.6 : 0.0
    liquidityPoolScoreUp_ += not na(dayHighPrev_) and safeAtrNorm(math.abs(dayHighPrev_ - close), atr_) <= TLP_NEAR_POOL_ATR ? 0.4 : 0.0
    liquidityPoolScoreUp_ += not na(weekHighPrev_) and safeAtrNorm(math.abs(weekHighPrev_ - close), atr_) <= TLP_NEAR_POOL_ATR * 1.8 ? 0.4 : 0.0

    float liquidityPoolScoreDown_ = 0.0
    liquidityPoolScoreDown_ += nearTrueLowerPool_ ? 1.0 : 0.0
    liquidityPoolScoreDown_ += majorLowerCluster_ ? 0.6 : 0.0
    liquidityPoolScoreDown_ += not na(dayLowPrev_) and safeAtrNorm(math.abs(close - dayLowPrev_), atr_) <= TLP_NEAR_POOL_ATR ? 0.4 : 0.0
    liquidityPoolScoreDown_ += not na(weekLowPrev_) and safeAtrNorm(math.abs(close - weekLowPrev_), atr_) <= TLP_NEAR_POOL_ATR * 1.8 ? 0.4 : 0.0

    [dayHighPrev_, dayLowPrev_, weekHighPrev_, weekLowPrev_, trueLiquidityHigh_, trueLiquidityLow_, distToTrueLiqHighAtr_, distToTrueLiqLowAtr_, nearTrueUpperPool_, nearTrueLowerPool_, liquidityPoolScoreUp_, liquidityPoolScoreDown_]

//======================================================
// SPACE ENGINE
//======================================================
d1_spaceEngine(float atr_, int regimeCode_, float volatilityRatio_, float wickinessScore_, float noiseScoreMarket_, float continuationScore_, float cbSpaceRelax_, bool coinCrowdedMarket_, bool coinVeryCrowdedMarket_, int coinProfileCode_) =>
    float adaptiveSpaceMult_ = BASE_MIN_SPACE_R_MULT
    float adaptiveMinSpaceAbs_ = atr_ * (is5m ? SPACE_ATR_MIN_5M : SPACE_ATR_MIN_15M)

    if ENABLE_ADAPTIVE_SPACE
        if regimeCode_ == REGIME_COMPRESSION
            adaptiveSpaceMult_ -= 0.06
            adaptiveMinSpaceAbs_ -= atr_ * 0.02
        if regimeCode_ == REGIME_RANGE
            adaptiveSpaceMult_ -= 0.04
            adaptiveMinSpaceAbs_ -= atr_ * 0.01
        if regimeCode_ == REGIME_CHAOTIC
            adaptiveSpaceMult_ -= 0.02
        if regimeCode_ == REGIME_TREND_UP or regimeCode_ == REGIME_TREND_DOWN
            adaptiveSpaceMult_ += 0.02
        if regimeCode_ == REGIME_EXPANSION
            adaptiveSpaceMult_ += 0.05
            adaptiveMinSpaceAbs_ += atr_ * 0.03
        if volatilityRatio_ < 0.90
            adaptiveSpaceMult_ -= 0.03
            adaptiveMinSpaceAbs_ -= atr_ * 0.01
        else if volatilityRatio_ > 1.20
            adaptiveSpaceMult_ += 0.03
            adaptiveMinSpaceAbs_ += atr_ * 0.02
        if wickinessScore_ > 1.20
            adaptiveSpaceMult_ -= 0.02
        if noiseScoreMarket_ > 0.58
            adaptiveSpaceMult_ -= 0.02
        if continuationScore_ > 0.45
            adaptiveSpaceMult_ += 0.02

    adaptiveSpaceMult_ -= cbSpaceRelax_
    adaptiveMinSpaceAbs_ -= atr_ * cbSpaceRelax_ * 0.50

    if coinCrowdedMarket_
        adaptiveSpaceMult_ += 0.06
        adaptiveMinSpaceAbs_ += atr_ * 0.10

    if coinVeryCrowdedMarket_
        adaptiveSpaceMult_ += 0.10
        adaptiveMinSpaceAbs_ += atr_ * 0.16

    if coinProfileCode_ == COIN_PROFILE_TREND and not coinCrowdedMarket_
        adaptiveSpaceMult_ -= 0.03
        adaptiveMinSpaceAbs_ -= atr_ * 0.03

    if coinProfileCode_ == COIN_PROFILE_WICKY or coinProfileCode_ == COIN_PROFILE_CHOPPY
        adaptiveMinSpaceAbs_ += atr_ * 0.04

    adaptiveSpaceMult_ := clamp(adaptiveSpaceMult_, SPACE_MULT_FLOOR, SPACE_MULT_CEIL)
    adaptiveMinSpaceAbs_ := math.max(atr_ * 0.10, adaptiveMinSpaceAbs_)

    [adaptiveSpaceMult_, adaptiveMinSpaceAbs_]

//======================================================
// PRE-SETUP DISTANCE ENGINE
//======================================================
d1_preSetupDistanceEngine(
    float atr_,
    int regimeCode_,
    float wickinessScore_,
    float fakeoutScore_,
    float continuationScore_,
    float cbRetestBoost_,
    float cbSweepBoost_,
    float cbStopBoost_,
    float supportTop_,
    float supportBottom_,
    float resistanceTop_,
    float resistanceBottom_,
    float currentSessionHighRef_,
    float currentSessionLowRef_,
    float prevSessionHighRef_,
    float prevSessionLowRef_,
    float relayHighRef_,
    float relayLowRef_,
    float trueLiquidityHigh_,
    float trueLiquidityLow_,
    float lastPivotHigh_,
    float lastPivotLow_
) =>
    float tol_ = atr_ * RETEST_TOL_ATR
    float sweepTol_ = atr_ * SWEEP_TOL_ATR
    float entryBuffer_ = atr_ * ENTRY_BUFFER_ATR
    float minRisk_ = atr_ * MIN_RISK_ATR
    float maxRisk_ = atr_ * MAX_RISK_ATR
    float minSLDist_ = atr_ * MIN_SL_DISTANCE_ATR
    float tpBuffer_ = atr_ * TP_ZONE_BUFFER_ATR

    float adaptiveEntryBuffer_ = entryBuffer_
    float adaptiveRetestTol_ = tol_
    float adaptiveSweepTol_ = sweepTol_
    float adaptiveStopPad_ = atr_ * SL_ATR_BUFFER

    if regimeCode_ == REGIME_COMPRESSION
        adaptiveEntryBuffer_ += atr_ * 0.01
        adaptiveRetestTol_ += atr_ * 0.03
        adaptiveStopPad_ += atr_ * 0.03

    if regimeCode_ == REGIME_EXPANSION
        adaptiveStopPad_ += atr_ * 0.06
        adaptiveSweepTol_ += atr_ * 0.02

    if regimeCode_ == REGIME_CHAOTIC
        adaptiveStopPad_ += atr_ * 0.08
        adaptiveEntryBuffer_ += atr_ * 0.02

    if wickinessScore_ > 1.20
        adaptiveStopPad_ += atr_ * 0.06

    if fakeoutScore_ > 0.35
        adaptiveStopPad_ += atr_ * 0.05
        adaptiveEntryBuffer_ += atr_ * 0.01

    if continuationScore_ > 0.45
        adaptiveRetestTol_ += atr_ * 0.02
        adaptiveStopPad_ += atr_ * 0.02

    adaptiveRetestTol_ += atr_ * cbRetestBoost_
    adaptiveSweepTol_ += atr_ * cbSweepBoost_
    adaptiveStopPad_ += atr_ * cbStopBoost_

    bool zoneNearSupport_ =
         not na(supportTop_) and
         not na(supportBottom_) and
         low <= supportTop_ + adaptiveRetestTol_ and
         low >= supportBottom_ - adaptiveRetestTol_

    bool zoneNearResistance_ =
         not na(resistanceTop_) and
         not na(resistanceBottom_) and
         high >= resistanceTop_ - adaptiveRetestTol_ and
         high <= resistanceBottom_ + adaptiveRetestTol_

    float fastShelfLow_ = ta.lowest(low, FAST_SR_LOOKBACK)
    float fastShelfHigh_ = ta.highest(high, FAST_SR_LOOKBACK)

    float fastSupportRef_ = maxBelow(close, currentSessionLowRef_, prevSessionLowRef_, relayLowRef_, supportBottom_, supportTop_, lastPivotLow_, trueLiquidityLow_, fastShelfLow_)
    float fastResistanceRef_ = minAbove(close, currentSessionHighRef_, prevSessionHighRef_, relayHighRef_, resistanceBottom_, resistanceTop_, lastPivotHigh_, trueLiquidityHigh_, fastShelfHigh_)

    float fastSupportPad_ = math.max(adaptiveRetestTol_, atr_ * FAST_ZONE_PAD_ATR)
    float fastResistancePad_ = math.max(adaptiveRetestTol_, atr_ * FAST_ZONE_PAD_ATR)

    bool fastNearSupportRef_ =
         not na(fastSupportRef_) and
         low <= fastSupportRef_ + fastSupportPad_ and
         low >= fastSupportRef_ - fastSupportPad_ * 1.10

    bool fastNearResistanceRef_ =
         not na(fastResistanceRef_) and
         high >= fastResistanceRef_ - fastResistancePad_ and
         high <= fastResistanceRef_ + fastResistancePad_ * 1.10

    bool fastNearSessionLow_ =
         (not na(currentSessionLowRef_) and safeAtrNorm(math.abs(low - currentSessionLowRef_), atr_) <= FAST_SESSION_NEAR_ATR) or
         (not na(prevSessionLowRef_) and safeAtrNorm(math.abs(low - prevSessionLowRef_), atr_) <= FAST_SESSION_NEAR_ATR) or
         (not na(relayLowRef_) and safeAtrNorm(math.abs(low - relayLowRef_), atr_) <= FAST_SESSION_NEAR_ATR)

    bool fastNearSessionHigh_ =
         (not na(currentSessionHighRef_) and safeAtrNorm(math.abs(high - currentSessionHighRef_), atr_) <= FAST_SESSION_NEAR_ATR) or
         (not na(prevSessionHighRef_) and safeAtrNorm(math.abs(high - prevSessionHighRef_), atr_) <= FAST_SESSION_NEAR_ATR) or
         (not na(relayHighRef_) and safeAtrNorm(math.abs(high - relayHighRef_), atr_) <= FAST_SESSION_NEAR_ATR)

    bool fastNearTrueLowerPool_ =
         not na(trueLiquidityLow_) and safeAtrNorm(math.abs(low - trueLiquidityLow_), atr_) <= FAST_TRUE_POOL_NEAR_ATR

    bool fastNearTrueUpperPool_ =
         not na(trueLiquidityHigh_) and safeAtrNorm(math.abs(high - trueLiquidityHigh_), atr_) <= FAST_TRUE_POOL_NEAR_ATR

    bool nearSupport_ = zoneNearSupport_ or fastNearSupportRef_ or fastNearSessionLow_ or fastNearTrueLowerPool_
    bool nearResistance_ = zoneNearResistance_ or fastNearResistanceRef_ or fastNearSessionHigh_ or fastNearTrueUpperPool_

    [minRisk_, maxRisk_, minSLDist_, tpBuffer_, adaptiveEntryBuffer_, adaptiveRetestTol_, adaptiveSweepTol_, adaptiveStopPad_, nearSupport_, nearResistance_]

//======================================================
// LIQUIDITY MAP ENGINE
//======================================================
d1_liquidityMapEngine(float emaFast_, float atr_, float bodyBase_, float upperWick_, float lowerWick_, float barRange_, bool trendUpBasic_, bool trendDownBasic_, int bullRunBars_, int bearRunBars_, bool nearSupport_, bool nearResistance_, float liquidityPoolScoreUp_, float liquidityPoolScoreDown_, float liqThresholdDynamic_, float lmThresholdDynamic_, bool nearTrueUpperPool_, bool nearTrueLowerPool_, bool bullMacd_, bool bearMacd_) =>
    bool softResistanceReject_ =
         upperWick_ >= bodyBase_ * 1.20 and
         close < open and
         high > emaFast_ + atr_ * 0.30 and
         close < high - barRange_ * 0.45

    bool softSupportReject_ =
         lowerWick_ >= bodyBase_ * 1.20 and
         close > open and
         low < emaFast_ - atr_ * 0.30 and
         close > low + barRange_ * 0.45

    bool localBlowoffSell_ =
         bullRunBars_ >= 4 and
         upperWick_ > bodyBase_ and
         close < nz(close[1], close) and
         close < high - barRange_ * 0.48

    bool localFlushBuy_ =
         bearRunBars_ >= 4 and
         lowerWick_ > bodyBase_ and
         close > nz(close[1], close) and
         close > low + barRange_ * 0.48

    bool microClusterHigh_ =
         high >= high4Prev and
         (upperWick_ > bodyBase_ * 0.8 or close < open)

    bool microClusterLow_ =
         low <= low4Prev and
         (lowerWick_ > bodyBase_ * 0.8 or close > open)

    int liquidityLookback_ = is5m ? 5 : 4
    float equalTolAtr_ = is5m ? 0.10 : 0.14
    int clusterBars_ = is5m ? 4 : 3

    float prevShelfHigh_ = ta.highest(high[1], liquidityLookback_)
    float prevShelfLow_ = ta.lowest(low[1], liquidityLookback_)

    bool equalHighShelf_ = USE_LIQUIDITY_MAP and math.abs(high - prevShelfHigh_) <= atr_ * equalTolAtr_
    bool equalLowShelf_ = USE_LIQUIDITY_MAP and math.abs(low - prevShelfLow_) <= atr_ * equalTolAtr_

    float upperWickClusterCount_ = 0.0
    float lowerWickClusterCount_ = 0.0
    int wickClusterLoop_ = math.min(clusterBars_, bar_index + 1)

    for i = 0 to wickClusterLoop_ - 1
        upperWickClusterCount_ += (upperWick_[i] > bodyBase_[i] * 0.75 or upperWick_[i] > atr_[i] * 0.18) ? 1.0 : 0.0
        lowerWickClusterCount_ += (lowerWick_[i] > bodyBase_[i] * 0.75 or lowerWick_[i] > atr_[i] * 0.18) ? 1.0 : 0.0

    bool wickClusterHigh_ = USE_LIQUIDITY_MAP and upperWickClusterCount_ >= 2 and high >= ta.highest(high, clusterBars_) - atr_ * 0.12
    bool wickClusterLow_ = USE_LIQUIDITY_MAP and lowerWickClusterCount_ >= 2 and low <= ta.lowest(low, clusterBars_) + atr_ * 0.12

    bool failedBreakoutHigh_ = USE_LIQUIDITY_MAP and high > prevShelfHigh_ and close < prevShelfHigh_ and close < open
    bool failedBreakdownLow_ = USE_LIQUIDITY_MAP and low < prevShelfLow_ and close > prevShelfLow_ and close > open

    bool hiddenLiquiditySell_ =
         USE_LIQUIDITY_MAP and
         trendUpBasic_ and
         bullRunBars_ >= 4 and
         high > emaFast_ + atr_ * 0.50 and
         upperWick_ > bodyBase_ * 1.30 and
         close < open and
         close < high - barRange_ * 0.48 and
         close <= emaFast_ + atr_ * 0.08 and
         high >= high3Prev

    bool hiddenLiquidityBuy_ =
         USE_LIQUIDITY_MAP and
         trendDownBasic_ and
         bearRunBars_ >= 4 and
         low < emaFast_ - atr_ * 0.50 and
         lowerWick_ > bodyBase_ * 1.30 and
         close > open and
         close > low + barRange_ * 0.48 and
         close >= emaFast_ - atr_ * 0.08 and
         low <= low3Prev

    bool liquidityMapSell_ =
         USE_LIQUIDITY_MAP and
         (
             failedBreakoutHigh_ or
             (equalHighShelf_ and upperWick_ > bodyBase_ * 1.0 and close < open and high >= high3Prev) or
             (wickClusterHigh_ and close < open and high > emaFast_) or
             softResistanceReject_ or
             (microClusterHigh_ and close < open and upperWick_ > bodyBase_ * 0.9) or
             hiddenLiquiditySell_
         )

    bool liquidityMapBuy_ =
         USE_LIQUIDITY_MAP and
         (
             failedBreakdownLow_ or
             (equalLowShelf_ and lowerWick_ > bodyBase_ * 1.0 and close > open and low <= low3Prev) or
             (wickClusterLow_ and close > open and low < emaFast_) or
             softSupportReject_ or
             (microClusterLow_ and close > open and lowerWick_ > bodyBase_ * 0.9) or
             hiddenLiquidityBuy_
         )

    int poolLookback_ = is5m ? 8 : 6
    float poolTol_ = atr_ * (is5m ? 0.08 : 0.10)

    float eqHighCount_ = 0.0
    float eqLowCount_ = 0.0
    int poolLoop_ = math.min(poolLookback_, bar_index)

    for i = 1 to poolLoop_
        eqHighCount_ += math.abs(high[i] - high) <= poolTol_ ? 1.0 : 0.0
        eqLowCount_ += math.abs(low[i] - low) <= poolTol_ ? 1.0 : 0.0

    bool bigStopClusterHigh_ = ENABLE_LIQUIDITY_ENGINE and eqHighCount_ >= 2 and high >= ta.highest(high, math.min(poolLookback_ + 1, 9)) - poolTol_
    bool bigStopClusterLow_ = ENABLE_LIQUIDITY_ENGINE and eqLowCount_ >= 2 and low <= ta.lowest(low, math.min(poolLookback_ + 1, 9)) + poolTol_

    bool trapSell_ =
         ENABLE_LIQUIDITY_ENGINE and
         bigStopClusterHigh_ and
         high > high3Prev and
         close < open and
         close < high - barRange_ * 0.45

    bool trapBuy_ =
         ENABLE_LIQUIDITY_ENGINE and
         bigStopClusterLow_ and
         low < low3Prev and
         close > open and
         close > low + barRange_ * 0.45

    bool volumeSpike_ = volume > volSma20 * 1.35
    bool strongUpperWick_ = upperWick_ > bodyBase_ * 1.20
    bool strongLowerWick_ = lowerWick_ > bodyBase_ * 1.20

    float liquidityScoreSell_ = 0.0
    liquidityScoreSell_ += liquidityMapSell_ ? 1.0 : 0.0
    liquidityScoreSell_ += strongUpperWick_ ? 0.9 : 0.0
    liquidityScoreSell_ += failedBreakoutHigh_ ? 1.2 : 0.0
    liquidityScoreSell_ += bigStopClusterHigh_ ? 1.2 : 0.0
    liquidityScoreSell_ += trapSell_ ? 1.8 : 0.0
    liquidityScoreSell_ += hiddenLiquiditySell_ ? 1.0 : 0.0
    liquidityScoreSell_ += nearResistance_ ? 1.0 : 0.0
    liquidityScoreSell_ += bearMacd_ ? 0.6 : 0.0
    liquidityScoreSell_ += close < open ? 0.4 : 0.0
    liquidityScoreSell_ += volumeSpike_ ? 0.65 : 0.0
    liquidityScoreSell_ += trendUpBasic_ and close < emaFast_ ? 0.4 : 0.0
    liquidityScoreSell_ += liquidityPoolScoreUp_ * 0.55

    float liquidityScoreBuy_ = 0.0
    liquidityScoreBuy_ += liquidityMapBuy_ ? 1.0 : 0.0
    liquidityScoreBuy_ += strongLowerWick_ ? 0.9 : 0.0
    liquidityScoreBuy_ += failedBreakdownLow_ ? 1.2 : 0.0
    liquidityScoreBuy_ += bigStopClusterLow_ ? 1.2 : 0.0
    liquidityScoreBuy_ += trapBuy_ ? 1.8 : 0.0
    liquidityScoreBuy_ += hiddenLiquidityBuy_ ? 1.0 : 0.0
    liquidityScoreBuy_ += nearSupport_ ? 1.0 : 0.0
    liquidityScoreBuy_ += bullMacd_ ? 0.6 : 0.0
    liquidityScoreBuy_ += close > open ? 0.4 : 0.0
    liquidityScoreBuy_ += volumeSpike_ ? 0.65 : 0.0
    liquidityScoreBuy_ += trendDownBasic_ and close > emaFast_ ? 0.4 : 0.0
    liquidityScoreBuy_ += liquidityPoolScoreDown_ * 0.55

    bool strongLiquiditySell_ = ENABLE_LIQUIDITY_RANKING ? liquidityScoreSell_ >= liqThresholdDynamic_ : liquidityMapSell_
    bool strongLiquidityBuy_ = ENABLE_LIQUIDITY_RANKING ? liquidityScoreBuy_ >= liqThresholdDynamic_ : liquidityMapBuy_

    bool eliteLiquiditySell_ =
         strongLiquiditySell_ and
         liquidityScoreSell_ >= lmThresholdDynamic_ and
         (trapSell_ or failedBreakoutHigh_ or strongUpperWick_ or hiddenLiquiditySell_) and
         (nearResistance_ or bigStopClusterHigh_ or high >= high5Now - atr_ * 0.15 or nearTrueUpperPool_) and
         (close < open or bearMacd_ or close < emaFast_)

    bool eliteLiquidityBuy_ =
         strongLiquidityBuy_ and
         liquidityScoreBuy_ >= lmThresholdDynamic_ and
         (trapBuy_ or failedBreakdownLow_ or strongLowerWick_ or hiddenLiquidityBuy_) and
         (nearSupport_ or bigStopClusterLow_ or low <= low5Now + atr_ * 0.15 or nearTrueLowerPool_) and
         (close > open or bullMacd_ or close > emaFast_)

    [softResistanceReject_, softSupportReject_, localBlowoffSell_, localFlushBuy_, microClusterHigh_, microClusterLow_, hiddenLiquiditySell_, hiddenLiquidityBuy_, trapSell_, trapBuy_, volumeSpike_, liquidityScoreSell_, liquidityScoreBuy_, strongLiquiditySell_, strongLiquidityBuy_, eliteLiquiditySell_, eliteLiquidityBuy_]

//======================================================
// TREND CONTINUATION ENGINE
//======================================================
d1_trendContinuationEngine(bool trendUpBasic_, bool trendDownBasic_, float emaFast_, bool bullMacd_, bool bearMacd_, int regimeCode_, bool microRangeActive_) =>
    bool trendPullbackBuy_ =
         ENABLE_TREND_CONTINUATION_ENGINE and
         trendUpBasic_ and
         ta.lowest(low, TREND_PULLBACK_LOOKBACK) <= emaFast_ and
         close > emaFast_ and
         close > open and
         bullMacd_

    bool trendPullbackSell_ =
         ENABLE_TREND_CONTINUATION_ENGINE and
         trendDownBasic_ and
         ta.highest(high, TREND_PULLBACK_LOOKBACK) >= emaFast_ and
         close < emaFast_ and
         close < open and
         bearMacd_

    bool trendContinuationBuy_ = trendPullbackBuy_ and regimeCode_ != REGIME_CHAOTIC and not microRangeActive_
    bool trendContinuationSell_ = trendPullbackSell_ and regimeCode_ != REGIME_CHAOTIC and not microRangeActive_

    [trendContinuationBuy_, trendContinuationSell_]

//======================================================
// VOL EXP ENGINE
//======================================================
d1_volExpEngine(float atr_, float atrSlow_, float avgRange20_, float barRange_, bool microRangeActive_, int sessionCode_, bool nearTrueUpperPool_, bool nearTrueLowerPool_, float liquidityScoreBuy_, float liquidityScoreSell_) =>
    float atrCompression_ = atrSlow_ > 0 ? atr_ / atrSlow_ : 1.0
    float rangeCompressionRatio_ = avgRange20_ > 0 ? barRange_ / avgRange20_ : 1.0
    float volBuildRatio_ = volSma20 > 0 ? volume / volSma20 : 1.0

    float volExpScore_ = 0.0
    volExpScore_ += atrCompression_ < VOL_EXP_ATR_CONTRACTION ? 0.8 : 0.0
    volExpScore_ += rangeCompressionRatio_ < VOL_EXP_RANGE_COMPRESSION ? 0.8 : 0.0
    volExpScore_ += volBuildRatio_ > VOL_EXP_VOL_BUILD ? 0.7 : 0.0
    volExpScore_ += microRangeActive_ ? 0.5 : 0.0
    volExpScore_ += (sessionCode_ == SESSION_LONDON or sessionCode_ == SESSION_NY_OPEN) ? 0.35 : 0.0
    volExpScore_ += (nearTrueUpperPool_ or nearTrueLowerPool_) ? 0.25 : 0.0
    volExpScore_ += math.abs(liquidityScoreBuy_ - liquidityScoreSell_) > 1.2 ? 0.20 : 0.0

    bool volatilityExpansionReady_ = ENABLE_VOL_EXP_PREDICTOR and volExpScore_ >= VOL_EXP_SCORE_THRESHOLD
    [volExpScore_, volatilityExpansionReady_]

//======================================================
// SESSION REFS ENGINE
//======================================================
d1_sessionRefsEngine(float currentSessionHighRef_, float currentSessionLowRef_, float prevSessionHighRef_, float prevSessionLowRef_, float relayHighRef_, float relayLowRef_, float atr_, float lowerWick_, float upperWick_, float bodyBase_, float barRange_, float emaFast_, float continuationScore_, float resistanceTop_, float resistanceBottom_, float supportTop_, float supportBottom_, float lastPivotHigh_, float lastPivotLow_, float dayHighPrev_, float dayLowPrev_, float weekHighPrev_, float weekLowPrev_, float emaSlow_) =>

    float distToCurrentSessionHighAtr_ = na(currentSessionHighRef_) ? 99.0 : safeAtrNorm(math.abs(currentSessionHighRef_ - close), atr_)
    float distToCurrentSessionLowAtr_ = na(currentSessionLowRef_) ? 99.0 : safeAtrNorm(math.abs(close - currentSessionLowRef_), atr_)
    float distToPrevSessionHighAtr_ = na(prevSessionHighRef_) ? 99.0 : safeAtrNorm(math.abs(prevSessionHighRef_ - close), atr_)
    float distToPrevSessionLowAtr_ = na(prevSessionLowRef_) ? 99.0 : safeAtrNorm(math.abs(close - prevSessionLowRef_), atr_)
    float distToRelayHighAtr_ = na(relayHighRef_) ? 99.0 : safeAtrNorm(math.abs(relayHighRef_ - close), atr_)
    float distToRelayLowAtr_ = na(relayLowRef_) ? 99.0 : safeAtrNorm(math.abs(close - relayLowRef_), atr_)

    bool nearCurrentSessionHigh_ = distToCurrentSessionHighAtr_ <= 0.45
    bool nearCurrentSessionLow_ = distToCurrentSessionLowAtr_ <= 0.45
    bool nearPrevSessionHigh_ = distToPrevSessionHighAtr_ <= 0.50
    bool nearPrevSessionLow_ = distToPrevSessionLowAtr_ <= 0.50
    bool nearRelayHigh_ = distToRelayHighAtr_ <= 0.50
    bool nearRelayLow_ = distToRelayLowAtr_ <= 0.50

    bool sessionSweepBelowCurrent_ = not na(currentSessionLowRef_) and low < currentSessionLowRef_ and close > currentSessionLowRef_
    bool sessionSweepAboveCurrent_ = not na(currentSessionHighRef_) and high > currentSessionHighRef_ and close < currentSessionHighRef_
    bool prevSessionSweepBelow_ = not na(prevSessionLowRef_) and low < prevSessionLowRef_ and close > prevSessionLowRef_
    bool prevSessionSweepAbove_ = not na(prevSessionHighRef_) and high > prevSessionHighRef_ and close < prevSessionHighRef_
    bool relaySweepBelow_ = not na(relayLowRef_) and low < relayLowRef_ and close > relayLowRef_
    bool relaySweepAbove_ = not na(relayHighRef_) and high > relayHighRef_ and close < relayHighRef_

    bool sessionReclaimBuyRef_ = sessionSweepBelowCurrent_ or prevSessionSweepBelow_ or relaySweepBelow_
    bool sessionReclaimSellRef_ = sessionSweepAboveCurrent_ or prevSessionSweepAbove_ or relaySweepAbove_

    bool sessionRejectBuyRef_ =
         (nearCurrentSessionLow_ or nearPrevSessionLow_ or nearRelayLow_) and
         lowerWick_ > bodyBase_ * 0.85 and
         close > open

    bool sessionRejectSellRef_ =
         (nearCurrentSessionHigh_ or nearPrevSessionHigh_ or nearRelayHigh_) and
         upperWick_ > bodyBase_ * 0.85 and
         close < open

    bool sessionBreakoutPressureBuyRef_ =
         (nearCurrentSessionHigh_ or nearPrevSessionHigh_ or nearRelayHigh_) and
         close > emaFast_ and
         close >= high - barRange_ * 0.40 and
         high >= nz(high[1], high) and
         continuationScore_ > 0.28

    bool sessionBreakoutPressureSellRef_ =
         (nearCurrentSessionLow_ or nearPrevSessionLow_ or nearRelayLow_) and
         close < emaFast_ and
         close <= low + barRange_ * 0.40 and
         low <= nz(low[1], low) and
         continuationScore_ > 0.28

    float sessionLocationScoreBuy_ = 0.0
    sessionLocationScoreBuy_ += nearCurrentSessionLow_ ? 1.0 : 0.0
    sessionLocationScoreBuy_ += nearPrevSessionLow_ ? 0.8 : 0.0
    sessionLocationScoreBuy_ += nearRelayLow_ ? 0.8 : 0.0
    sessionLocationScoreBuy_ += sessionReclaimBuyRef_ ? 0.8 : 0.0
    sessionLocationScoreBuy_ += sessionRejectBuyRef_ ? 0.4 : 0.0
    sessionLocationScoreBuy_ += sessionBreakoutPressureBuyRef_ ? 0.35 : 0.0

    float sessionLocationScoreSell_ = 0.0
    sessionLocationScoreSell_ += nearCurrentSessionHigh_ ? 1.0 : 0.0
    sessionLocationScoreSell_ += nearPrevSessionHigh_ ? 0.8 : 0.0
    sessionLocationScoreSell_ += nearRelayHigh_ ? 0.8 : 0.0
    sessionLocationScoreSell_ += sessionReclaimSellRef_ ? 0.8 : 0.0
    sessionLocationScoreSell_ += sessionRejectSellRef_ ? 0.4 : 0.0
    sessionLocationScoreSell_ += sessionBreakoutPressureSellRef_ ? 0.35 : 0.0

    float buySessionTargetRef_ = minAbove(close, currentSessionHighRef_, prevSessionHighRef_, relayHighRef_, resistanceTop_, resistanceBottom_, dayHighPrev_, weekHighPrev_, float(na))
    float sellSessionTargetRef_ = maxBelow(close, currentSessionLowRef_, prevSessionLowRef_, relayLowRef_, supportTop_, supportBottom_, dayLowPrev_, weekLowPrev_, float(na))

    [nearCurrentSessionHigh_, nearCurrentSessionLow_, nearPrevSessionHigh_, nearPrevSessionLow_, nearRelayHigh_, nearRelayLow_, relaySweepBelow_, relaySweepAbove_, sessionReclaimBuyRef_, sessionReclaimSellRef_, sessionRejectBuyRef_, sessionRejectSellRef_, sessionBreakoutPressureBuyRef_, sessionBreakoutPressureSellRef_, sessionLocationScoreBuy_, sessionLocationScoreSell_, buySessionTargetRef_, sellSessionTargetRef_]

//======================================================
// BREAKOUT ENGINE
//======================================================
d1_breakoutEngine(float currentSessionHighRef_, float currentSessionLowRef_, float prevSessionHighRef_, float prevSessionLowRef_, float relayHighRef_, float relayLowRef_, float resistanceTop_, float supportTop_, float lastPivotHigh_, float lastPivotLow_, float dayHighPrev_, float dayLowPrev_, float weekHighPrev_, float weekLowPrev_, float trueLiquidityHigh_, float trueLiquidityLow_, float atr_, float barRange_, float continuationScore_, float liquidityScoreSell_, float liquidityScoreBuy_, float liqThresholdDynamic_, bool eliteLiquiditySell_, bool eliteLiquidityBuy_, bool bearTrapConfirm_, bool bullTrapConfirm_, int preSweepBias_, float fakeoutScore_, float wickinessScore_, bool coinCrowdedMarket_, int regimeCode_, bool sessionReclaimSellRef_, bool sessionReclaimBuyRef_, float cbBreakoutBias_, bool trendContinuationBuy_, bool trendContinuationSell_, int marketMemoryBias_, int htfStructureBias_, bool volatilityExpansionReady_, int sessionCode_, bool sessionBreakoutPressureBuyRef_, bool sessionBreakoutPressureSellRef_, bool bullMacd_, bool bearMacd_, float emaFast_, float emaSlow_, float zoneCrowdingScore_) =>
    float nearestBreakoutRef_ = minAbove(close, currentSessionHighRef_, prevSessionHighRef_, relayHighRef_, resistanceTop_, lastPivotHigh_, dayHighPrev_, weekHighPrev_, trueLiquidityHigh_)
    float nearestBreakdownRef_ = maxBelow(close, currentSessionLowRef_, prevSessionLowRef_, relayLowRef_, supportTop_, lastPivotLow_, dayLowPrev_, weekLowPrev_, trueLiquidityLow_)

    float distToBreakoutRefAtr_ = na(nearestBreakoutRef_) ? 99.0 : safeAtrNorm(nearestBreakoutRef_ - close, atr_)
    float distToBreakdownRefAtr_ = na(nearestBreakdownRef_) ? 99.0 : safeAtrNorm(close - nearestBreakdownRef_, atr_)

    bool nearBreakoutRef_ = distToBreakoutRefAtr_ <= BREAK_NEAR_LEVEL_ATR
    bool nearBreakdownRef_ = distToBreakdownRefAtr_ <= BREAK_NEAR_LEVEL_ATR

    bool tightHighCompression_ = true
    bool tightLowCompression_ = true
    int breakLoop_ = math.min(BREAK_COMPRESSION_LOOKBACK, bar_index + 1)

    for i = 0 to breakLoop_ - 1
        tightHighCompression_ := tightHighCompression_ and (high[i] <= nz(nearestBreakoutRef_, high[i]) + atr_[i] * 0.18)
        tightLowCompression_ := tightLowCompression_ and (low[i] >= nz(nearestBreakdownRef_, low[i]) - atr_[i] * 0.18)

    bool bullCloseStrength_ = close >= high - barRange_ * 0.25
    bool bearCloseStrength_ = close <= low + barRange_ * 0.25

    float bullPressureBuild_ = 0.0
    bullPressureBuild_ += nearBreakoutRef_ ? 1.0 : 0.0
    bullPressureBuild_ += tightHighCompression_ ? 0.8 : 0.0
    bullPressureBuild_ += bullCloseStrength_ ? 0.50 : 0.0
    bullPressureBuild_ += close > emaFast_ ? 0.30 : 0.0
    bullPressureBuild_ += emaFast_ > emaSlow_ ? 0.30 : 0.0
    bullPressureBuild_ += bullMacd_ ? 0.35 : 0.0
    bullPressureBuild_ += continuationScore_ > 0.34 ? 0.40 : 0.0
    bullPressureBuild_ += trendContinuationBuy_ ? 0.50 : 0.0
    bullPressureBuild_ += marketMemoryBias_ == 1 ? 0.40 : 0.0
    bullPressureBuild_ += htfStructureBias_ == 1 ? BREAK_HTF_BOOST : 0.0
    bullPressureBuild_ += volatilityExpansionReady_ ? 0.30 : 0.0
    bullPressureBuild_ += (sessionCode_ == SESSION_LONDON or sessionCode_ == SESSION_NY_OPEN or sessionCode_ == SESSION_NY_LATE) ? BREAK_SESSION_BOOST : 0.0
    bullPressureBuild_ += sessionBreakoutPressureBuyRef_ ? 0.45 : 0.0
    bullPressureBuild_ += cbBreakoutBias_ > 0 ? cbBreakoutBias_ : 0.0

    float bearPressureBuild_ = 0.0
    bearPressureBuild_ += nearBreakdownRef_ ? 1.0 : 0.0
    bearPressureBuild_ += tightLowCompression_ ? 0.8 : 0.0
    bearPressureBuild_ += bearCloseStrength_ ? 0.50 : 0.0
    bearPressureBuild_ += close < emaFast_ ? 0.30 : 0.0
    bearPressureBuild_ += emaFast_ < emaSlow_ ? 0.30 : 0.0
    bearPressureBuild_ += bearMacd_ ? 0.35 : 0.0
    bearPressureBuild_ += continuationScore_ > 0.34 ? 0.40 : 0.0
    bearPressureBuild_ += trendContinuationSell_ ? 0.50 : 0.0
    bearPressureBuild_ += marketMemoryBias_ == -1 ? 0.40 : 0.0
    bearPressureBuild_ += htfStructureBias_ == -1 ? BREAK_HTF_BOOST : 0.0
    bearPressureBuild_ += volatilityExpansionReady_ ? 0.30 : 0.0
    bearPressureBuild_ += (sessionCode_ == SESSION_LONDON or sessionCode_ == SESSION_NY_OPEN or sessionCode_ == SESSION_NY_LATE) ? BREAK_SESSION_BOOST : 0.0
    bearPressureBuild_ += sessionBreakoutPressureSellRef_ ? 0.45 : 0.0
    bearPressureBuild_ += cbBreakoutBias_ < 0 ? math.abs(cbBreakoutBias_) : 0.0

    float bullFalseBreakRisk_ = 0.0
    bullFalseBreakRisk_ += liquidityScoreSell_ >= liqThresholdDynamic_ ? 0.7 : 0.0
    bullFalseBreakRisk_ += eliteLiquiditySell_ ? 0.8 : 0.0
    bullFalseBreakRisk_ += bearTrapConfirm_ ? 0.7 : 0.0
    bullFalseBreakRisk_ += preSweepBias_ == 1 ? 0.65 : 0.0
    bullFalseBreakRisk_ += fakeoutScore_ > 0.25 ? 0.30 : 0.0
    bullFalseBreakRisk_ += wickinessScore_ > 1.25 ? 0.20 : 0.0
    bullFalseBreakRisk_ += coinCrowdedMarket_ ? 0.30 : 0.0
    bullFalseBreakRisk_ += regimeCode_ == REGIME_CHAOTIC ? 0.40 : 0.0
    bullFalseBreakRisk_ += sessionReclaimSellRef_ ? 0.35 : 0.0
    bullFalseBreakRisk_ += cbBreakoutBias_ < 0 ? math.abs(cbBreakoutBias_) * 1.0 : 0.0

    float bearFalseBreakRisk_ = 0.0
    bearFalseBreakRisk_ += liquidityScoreBuy_ >= liqThresholdDynamic_ ? 0.7 : 0.0
    bearFalseBreakRisk_ += eliteLiquidityBuy_ ? 0.8 : 0.0
    bearFalseBreakRisk_ += bullTrapConfirm_ ? 0.7 : 0.0
    bearFalseBreakRisk_ += preSweepBias_ == -1 ? 0.65 : 0.0
    bearFalseBreakRisk_ += fakeoutScore_ > 0.25 ? 0.30 : 0.0
    bearFalseBreakRisk_ += wickinessScore_ > 1.25 ? 0.20 : 0.0
    bearFalseBreakRisk_ += coinCrowdedMarket_ ? 0.30 : 0.0
    bearFalseBreakRisk_ += regimeCode_ == REGIME_CHAOTIC ? 0.40 : 0.0
    bearFalseBreakRisk_ += sessionReclaimBuyRef_ ? 0.35 : 0.0
    bearFalseBreakRisk_ += cbBreakoutBias_ > 0 ? math.abs(cbBreakoutBias_) * 1.0 : 0.0

    bullFalseBreakRisk_ := math.min(bullFalseBreakRisk_, BREAK_FALSE_RISK_CAP)
    bearFalseBreakRisk_ := math.min(bearFalseBreakRisk_, BREAK_FALSE_RISK_CAP)

    float breakoutAnticipationBuy_ = 0.0
    breakoutAnticipationBuy_ += bullPressureBuild_
    breakoutAnticipationBuy_ -= bullFalseBreakRisk_
    breakoutAnticipationBuy_ -= math.max(liquidityScoreSell_ - liquidityScoreBuy_, 0.0) * BREAK_COUNTER_LIQ_PENALTY * 0.30

    float breakdownAnticipationSell_ = 0.0
    breakdownAnticipationSell_ += bearPressureBuild_
    breakdownAnticipationSell_ -= bearFalseBreakRisk_
    breakdownAnticipationSell_ -= math.max(liquidityScoreBuy_ - liquidityScoreSell_, 0.0) * BREAK_COUNTER_LIQ_PENALTY * 0.30

    breakoutAnticipationBuy_ := math.max(0.0, breakoutAnticipationBuy_)
    breakdownAnticipationSell_ := math.max(0.0, breakdownAnticipationSell_)

    bool smartBreakoutReadyBuy_ =
         ENABLE_BREAK_ANTICIPATION and
         breakoutAnticipationBuy_ >= BREAK_ANTICIPATION_THRESHOLD and
         nearBreakoutRef_ and
         not eliteLiquiditySell_ and
         not bearTrapConfirm_

    bool smartBreakdownReadySell_ =
         ENABLE_BREAK_ANTICIPATION and
         breakdownAnticipationSell_ >= BREAK_ANTICIPATION_THRESHOLD and
         nearBreakdownRef_ and
         not eliteLiquidityBuy_ and
         not bullTrapConfirm_

    [nearBreakoutRef_, nearBreakdownRef_, bullPressureBuild_, bearPressureBuild_, bullFalseBreakRisk_, bearFalseBreakRisk_, breakoutAnticipationBuy_, breakdownAnticipationSell_, smartBreakoutReadyBuy_, smartBreakdownReadySell_]

//======================================================
// CORE SERIES
//======================================================
[macdLine, signalLine, histLine] = ta.macd(close, FAST_MA, SLOW_MA, SIGNAL_LEN)
emaFast = ta.ema(close, EMA_FAST_LEN)
emaSlow = ta.ema(close, EMA_SLOW_LEN)
atrValue = ta.atr(ATR_LEN)
atrSlow = ta.sma(atrValue, 50)

warmupBars = math.max(CB_LOOKBACK, 250)
coreReady = not na(emaFast) and not na(emaSlow) and not na(atrValue) and not na(atrSlow) and bar_index > warmupBars

bullMacd = macdLine >= signalLine and histLine >= 0
bearMacd = macdLine <= signalLine and histLine <= 0

// RSI
rsiVal        = ta.rsi(close, RSI_LEN)
bool rsiOversold   = coreReady and rsiVal < RSI_OS
bool rsiOverbought = coreReady and rsiVal > RSI_OB
bool rsiBullDiv    = coreReady and rsiVal > nz(rsiVal[RSI_DIV_LB], rsiVal) and close < nz(close[RSI_DIV_LB], close)
bool rsiBearDiv    = coreReady and rsiVal < nz(rsiVal[RSI_DIV_LB], rsiVal) and close > nz(close[RSI_DIV_LB], close)
bool rsiRisingBull = coreReady and rsiVal > rsiVal[1] and rsiVal[1] > rsiVal[2]
bool rsiFallingBear = coreReady and rsiVal < rsiVal[1] and rsiVal[1] < rsiVal[2]

plot(SHOW_EMAS ? emaFast : na, "EMA Fast", color=color.new(color.aqua, 0), linewidth=2)
plot(SHOW_EMAS ? emaSlow : na, "EMA Slow", color=color.new(color.orange, 0), linewidth=2)

//======================================================
// SESSION FLAGS
//======================================================
hrSE = hour(time, SESSION_TZ)
[sessionCode, asiaSession, londonSession, nySession, newAsiaSession, newLondonSession, newNySession, asiaClosed, londonClosed, nyClosed] = d1_sessionFlags(hrSE)

//======================================================
// BASE ZONE INPUTS
//======================================================
Vol = signedVol
prevVolHi = ta.highest(Vol, DELTA_VOL_LEN)[1]
prevVolLo = ta.lowest(Vol, DELTA_VOL_LEN)[1]
bullVolImpulse = Vol > nz(prevVolHi, Vol)
bearVolImpulse = Vol < nz(prevVolLo, Vol)

zoneATR = ta.atr(200)
pivotIdx = PIVOT_LOOKBACK

pivotHigh = ta.pivothigh(high, PIVOT_LOOKBACK, PIVOT_LOOKBACK)
pivotLow = ta.pivotlow(low, PIVOT_LOOKBACK, PIVOT_LOOKBACK)

bullVolImpulsePivot = bar_index > pivotIdx and Vol[pivotIdx] > nz(prevVolHi[pivotIdx], Vol[pivotIdx])
bearVolImpulsePivot = bar_index > pivotIdx and Vol[pivotIdx] < nz(prevVolLo[pivotIdx], Vol[pivotIdx])

var float supportTop = na
var float supportBottom = na
var float resistanceTop = na
var float resistanceBottom = na

var int supportBar = na
var int resistanceBar = na
var int supportTouches = 0
var int resistanceTouches = 0
var float supportImpulseStrength = na
var float resistanceImpulseStrength = na
var float supportReactionStrength = na
var float resistanceReactionStrength = na

var box supportBox = na
var box resistanceBox = na

//======================================================
// PROFILE
//======================================================
[candleBody, upperWick, lowerWick, barRange, bodyBase, bodyOk] = d1_profileEngine(close, open, high, low, emaFast, atrValue)

//======================================================
// RUN MEMORY
//======================================================
var int bullRunBars = 0
var int bearRunBars = 0
bullRunBars := not na(close[1]) and close > close[1] ? nz(bullRunBars[1]) + 1 : 0
bearRunBars := not na(close[1]) and close < close[1] ? nz(bearRunBars[1]) + 1 : 0

chaseBuyOk = bullRunBars <= 6
chaseSellOk = bearRunBars <= 6

//======================================================
// MARKET ENGINE
//======================================================
[trendUpBasic, trendDownBasic, volatilityRatio, avgRange20, compressionScore, regimeCode, wickinessScore, avgBodyEfficiency, fakeoutScore, continuationScore, noiseScoreMarket, bodyShrink, rangeShrink, weakBullClose, weakBearClose, efficiencyDrop] = d1_marketEngine(close, open, high, low, emaFast, emaSlow, atrValue, atrSlow, candleBody, upperWick, lowerWick, barRange)

// Save raw regime before stabilisation override so the stabilisation block
// below can still read the true raw value via rawRegimeCode.
int rawRegimeCode = regimeCode
var int regimeCodeStable = REGIME_RANGE
// Apply previous bar's stable regime immediately so ALL downstream code uses
// the same stabilised value. (regimeCodeStable is updated each confirmed bar.)
regimeCode := regimeCodeStable

longExhaustion = bullRunBars >= (is5m ? 4 : 3) and bodyShrink and rangeShrink and weakBullClose and efficiencyDrop
shortExhaustion = bearRunBars >= (is5m ? 4 : 3) and bodyShrink and rangeShrink and weakBearClose and efficiencyDrop

// Pullback depth — measures how deep the current pullback is relative to last impulse
float impulseHighRef = ta.highest(high, 8)
float impulseLowRef  = ta.lowest(low, 8)
float impulseSizeRef = impulseHighRef - impulseLowRef
float pullbackDepthBuy  = impulseSizeRef > atrValue * 0.5 ? (impulseHighRef - close) / impulseSizeRef : 0.5
float pullbackDepthSell = impulseSizeRef > atrValue * 0.5 ? (close - impulseLowRef) / impulseSizeRef : 0.5

bool pullbackQualityBuy  = pullbackDepthBuy  >= 0.30 and pullbackDepthBuy  <= 0.68
bool pullbackQualitySell = pullbackDepthSell >= 0.30 and pullbackDepthSell <= 0.68
bool pullbackTooDeepBuy  = pullbackDepthBuy  > 0.75
bool pullbackTooDeepSell = pullbackDepthSell > 0.75

//======================================================
// ZONES
//======================================================
float pivotZoneAtr = nz(zoneATR[pivotIdx], atrValue)

float dynamicSupportWidth = d1_dynamicZoneWidth(pivotZoneAtr, nz(wickinessScore, 1.0), nz(fakeoutScore, 0.0), nz(continuationScore, 0.0), bullVolImpulsePivot, false)
float dynamicResistanceWidth = d1_dynamicZoneWidth(pivotZoneAtr, nz(wickinessScore, 1.0), nz(fakeoutScore, 0.0), nz(continuationScore, 0.0), false, bearVolImpulsePivot)

if not na(pivotLow) and bullVolImpulsePivot
    float newSupportTop = pivotLow
    float newSupportBottom = pivotLow - dynamicSupportWidth
    float oldSupportMid = d1_zoneMid(supportTop, supportBottom)
    float mergeTolSup = math.max(pivotZoneAtr * 0.35, syminfo.mintick * 10)

    bool mergeSupport =
         not na(supportTop) and
         not na(supportBottom) and
         not na(oldSupportMid) and
         math.abs(pivotLow - oldSupportMid) <= mergeTolSup + math.abs(supportTop - supportBottom) * 0.5

    if mergeSupport
        supportTop := math.max(supportTop, newSupportTop)
        supportBottom := math.min(supportBottom, newSupportBottom)
        supportBar := bar_index - pivotIdx
        supportImpulseStrength := math.max(nz(supportImpulseStrength, 0.0), math.min(safeDiv(math.abs(Vol[pivotIdx]), math.max(volSma20[pivotIdx], 1.0), 0.0), 3.0))
        supportReactionStrength := math.max(nz(supportReactionStrength, 0.0), math.min(safeAtrNorm(close[pivotIdx] - low[pivotIdx], atrValue[pivotIdx]), 3.0))
    else
        supportTop := newSupportTop
        supportBottom := newSupportBottom
        supportBar := bar_index - pivotIdx
        supportTouches := 0
        supportImpulseStrength := math.min(safeDiv(math.abs(Vol[pivotIdx]), math.max(volSma20[pivotIdx], 1.0), 0.0), 3.0)
        supportReactionStrength := math.min(safeAtrNorm(close[pivotIdx] - low[pivotIdx], atrValue[pivotIdx]), 3.0)

    if not na(supportBox)
        box.delete(supportBox)
        supportBox := na

    if SHOW_ZONES
        supportBox := box.new(bar_index - pivotIdx, supportTop, bar_index, supportBottom, xloc=xloc.bar_index, border_color=color.new(color.green, 0), bgcolor=color.new(color.green, 88), border_width=1)

if not na(pivotHigh) and bearVolImpulsePivot
    float newResistanceTop = pivotHigh
    float newResistanceBottom = pivotHigh + dynamicResistanceWidth
    float oldResistanceMid = d1_zoneMid(resistanceTop, resistanceBottom)
    float mergeTolRes = math.max(pivotZoneAtr * 0.35, syminfo.mintick * 10)

    bool mergeResistance =
         not na(resistanceTop) and
         not na(resistanceBottom) and
         not na(oldResistanceMid) and
         math.abs(pivotHigh - oldResistanceMid) <= mergeTolRes + math.abs(resistanceBottom - resistanceTop) * 0.5

    if mergeResistance
        resistanceTop := math.min(resistanceTop, newResistanceTop)
        resistanceBottom := math.max(resistanceBottom, newResistanceBottom)
        resistanceBar := bar_index - pivotIdx
        resistanceImpulseStrength := math.max(nz(resistanceImpulseStrength, 0.0), math.min(safeDiv(math.abs(Vol[pivotIdx]), math.max(volSma20[pivotIdx], 1.0), 0.0), 3.0))
        resistanceReactionStrength := math.max(nz(resistanceReactionStrength, 0.0), math.min(safeAtrNorm(high[pivotIdx] - close[pivotIdx], atrValue[pivotIdx]), 3.0))
    else
        resistanceTop := newResistanceTop
        resistanceBottom := newResistanceBottom
        resistanceBar := bar_index - pivotIdx
        resistanceTouches := 0
        resistanceImpulseStrength := math.min(safeDiv(math.abs(Vol[pivotIdx]), math.max(volSma20[pivotIdx], 1.0), 0.0), 3.0)
        resistanceReactionStrength := math.min(safeAtrNorm(high[pivotIdx] - close[pivotIdx], atrValue[pivotIdx]), 3.0)

    if not na(resistanceBox)
        box.delete(resistanceBox)
        resistanceBox := na

    if SHOW_ZONES
        resistanceBox := box.new(bar_index - pivotIdx, resistanceBottom, bar_index, resistanceTop, xloc=xloc.bar_index, border_color=color.new(color.red, 0), bgcolor=color.new(color.red, 88), border_width=1)

float supportOuterPad = atrValue * 0.18
float resistanceOuterPad = atrValue * 0.18


inSupportZoneCoarse = not na(supportTop) and not na(supportBottom) and low <= supportTop + supportOuterPad and high >= supportBottom - supportOuterPad
inResistanceZoneCoarse = not na(resistanceTop) and not na(resistanceBottom) and high >= resistanceTop - resistanceOuterPad and low <= resistanceBottom + resistanceOuterPad

bool prevInSupportZone = bar_index > 0 ? inSupportZoneCoarse[1] : false
bool prevInResistanceZone = bar_index > 0 ? inResistanceZoneCoarse[1] : false

newSupportTouch = inSupportZoneCoarse and not prevInSupportZone and barstate.isconfirmed
newResistanceTouch = inResistanceZoneCoarse and not prevInResistanceZone and barstate.isconfirmed

if newSupportTouch
    supportTouches += 1
if newResistanceTouch
    resistanceTouches += 1

if not na(supportBox)
    box.set_right(supportBox, bar_index + 1)
if not na(resistanceBox)
    box.set_right(resistanceBox, bar_index + 1)

supportAgeBars = na(supportBar) ? 999999 : (bar_index - supportBar)
resistanceAgeBars = na(resistanceBar) ? 999999 : (bar_index - resistanceBar)

supportMid = d1_zoneMid(supportTop, supportBottom)
resistanceMid = d1_zoneMid(resistanceTop, resistanceBottom)

supportHalfWidth = d1_zoneHalfWidth(supportTop, supportBottom, atrValue)
resistanceHalfWidth = d1_zoneHalfWidth(resistanceTop, resistanceBottom, atrValue)

supportZoneDepth = not na(supportTop) and not na(supportBottom) ? clamp((supportTop - math.max(low, supportBottom)) / math.max(supportTop - supportBottom, syminfo.mintick), 0.0, 2.0) : 0.0
resistanceZoneDepth = not na(resistanceTop) and not na(resistanceBottom) ? clamp((math.min(high, resistanceBottom) - resistanceTop) / math.max(resistanceBottom - resistanceTop, syminfo.mintick), 0.0, 2.0) : 0.0

if not na(supportBar) and supportAgeBars > ZONE_MAX_AGE_BARS and nz(supportTouches, 0) <= 1
    supportTop := na
    supportBottom := na
    supportBar := na
    supportTouches := 0
    supportImpulseStrength := na
    supportReactionStrength := na
    if not na(supportBox)
        box.delete(supportBox)
        supportBox := na

if not na(resistanceBar) and resistanceAgeBars > ZONE_MAX_AGE_BARS and nz(resistanceTouches, 0) <= 1
    resistanceTop := na
    resistanceBottom := na
    resistanceBar := na
    resistanceTouches := 0
    resistanceImpulseStrength := na
    resistanceReactionStrength := na
    if not na(resistanceBox)
        box.delete(resistanceBox)
        resistanceBox := na

supportAgeBars := na(supportBar) ? 999999 : (bar_index - supportBar)
resistanceAgeBars := na(resistanceBar) ? 999999 : (bar_index - resistanceBar)

supportFreshnessScore = supportAgeBars <= ZONE_OLD_AGE_BARS ? 1.0 : supportAgeBars <= ZONE_MAX_AGE_BARS ? 0.5 : 0.0
resistanceFreshnessScore = resistanceAgeBars <= ZONE_OLD_AGE_BARS ? 1.0 : resistanceAgeBars <= ZONE_MAX_AGE_BARS ? 0.5 : 0.0

supportTouchScore = supportTouches <= 2 ? 1.0 : supportTouches <= 4 ? 0.4 : 0.0
resistanceTouchScore = resistanceTouches <= 2 ? 1.0 : resistanceTouches <= 4 ? 0.4 : 0.0

lastPivotHigh = ta.valuewhen(not na(pivotHigh), pivotHigh, 0)
prevPivotHigh = ta.valuewhen(not na(pivotHigh), pivotHigh, 1)
olderPivotHigh = ta.valuewhen(not na(pivotHigh), pivotHigh, 2)

lastPivotLow = ta.valuewhen(not na(pivotLow), pivotLow, 0)
prevPivotLow = ta.valuewhen(not na(pivotLow), pivotLow, 1)
olderPivotLow = ta.valuewhen(not na(pivotLow), pivotLow, 2)

bool supportPivotCluster = (
    not na(lastPivotLow) and
    not na(prevPivotLow) and
    math.abs(lastPivotLow - prevPivotLow) <= atrValue * 0.30
)

bool resistancePivotCluster = (
    not na(lastPivotHigh) and
    not na(prevPivotHigh) and
    math.abs(lastPivotHigh - prevPivotHigh) <= atrValue * 0.30
)

float supportZoneQuality = nz(supportFreshnessScore) + nz(supportTouchScore) + math.min(nz(supportImpulseStrength, 0.0) * 0.5, 1.0) + math.min(nz(supportReactionStrength, 0.0) * 0.4, 1.0)
float resistanceZoneQuality = nz(resistanceFreshnessScore) + nz(resistanceTouchScore) + math.min(nz(resistanceImpulseStrength, 0.0) * 0.5, 1.0) + math.min(nz(resistanceReactionStrength, 0.0) * 0.4, 1.0)

//======================================================
// COIN BEHAVIOR ENGINE
//======================================================
[coinProfileCode, cbSpaceRelax, cbStopBoost, cbRetestBoost, cbSweepBoost, cbBreakoutBias, cbReversalBias, dynamicMaxWickToBody, dynamicLateEntryAtr, minValidRrDynamicBase, liqThresholdDynamic, lmThresholdDynamic, preScoreThresholdDynamic] = d1_coinBehaviorEngine(close, atrValue, barRange, wickinessScore, noiseScoreMarket, continuationScore, fakeoutScore, avgBodyEfficiency)

wickOkBuy = not USE_WICK_FILTER or candleBody <= syminfo.mintick or safeDiv(upperWick, bodyBase, 999.0) <= dynamicMaxWickToBody
wickOkSell = not USE_WICK_FILTER or candleBody <= syminfo.mintick or safeDiv(lowerWick, bodyBase, 999.0) <= dynamicMaxWickToBody
lateEntryOk = not USE_LATE_ENTRY_FILTER or math.abs(close - emaFast) <= atrValue * dynamicLateEntryAtr

//======================================================
// CROWDING inline
//======================================================
float nearestResDistAtr = zoneDistanceAtr(close, resistanceTop, resistanceBottom, atrValue)
float nearestSupDistAtr = zoneDistanceAtr(close, supportTop, supportBottom, atrValue)

float pivotDensityRaw = 0.0
pivotDensityRaw += not na(lastPivotHigh) ? 1.0 : 0.0
pivotDensityRaw += not na(prevPivotHigh) ? 1.0 : 0.0
pivotDensityRaw += not na(olderPivotHigh) ? 1.0 : 0.0
pivotDensityRaw += not na(lastPivotLow) ? 1.0 : 0.0
pivotDensityRaw += not na(prevPivotLow) ? 1.0 : 0.0
pivotDensityRaw += not na(olderPivotLow) ? 1.0 : 0.0

float zoneCrowdingScore = 0.0
zoneCrowdingScore += nearestResDistAtr <= 1.2 ? 1.0 : 0.0
zoneCrowdingScore += nearestSupDistAtr <= 1.2 ? 1.0 : 0.0
zoneCrowdingScore += supportTouches >= 3 ? 0.6 : 0.0
zoneCrowdingScore += resistanceTouches >= 3 ? 0.6 : 0.0
zoneCrowdingScore += noiseScoreMarket > 0.55 ? 0.7 : 0.0
zoneCrowdingScore += fakeoutScore > 0.30 ? 0.7 : 0.0
zoneCrowdingScore += wickinessScore > 1.15 ? 0.5 : 0.0
zoneCrowdingScore += pivotDensityRaw >= 5 ? 0.5 : 0.0

bool coinCrowdedMarket = zoneCrowdingScore >= 2.1
bool coinVeryCrowdedMarket = zoneCrowdingScore >= 3.1

minValidRrDynamic = minValidRrDynamicBase
if coinProfileCode == COIN_PROFILE_TREND and not coinCrowdedMarket
    minValidRrDynamic -= 0.03
if coinProfileCode == COIN_PROFILE_WICKY
    minValidRrDynamic += 0.04
if coinProfileCode == COIN_PROFILE_CHOPPY
    minValidRrDynamic += 0.06
if coinVeryCrowdedMarket
    minValidRrDynamic += 0.08
minValidRrDynamic := math.max(0.60, minValidRrDynamic)

//======================================================
// FAIR VALUE GAP (FVG) ENGINE
//======================================================
// Bull FVG: current low > high 2 bars ago — upward imbalance
bool bullFvgFormed = low > high[2] and barRange > atrValue * 0.40 and close > open
// Bear FVG: current high < low 2 bars ago — downward imbalance
bool bearFvgFormed = high < low[2] and barRange > atrValue * 0.40 and close < open

// Track most recent FVG mid-points
var float lastBullFvgHigh = na
var float lastBullFvgLow  = na
var float lastBearFvgHigh = na
var float lastBearFvgLow  = na
var int   lastBullFvgBar  = na
var int   lastBearFvgBar  = na

if bullFvgFormed
    lastBullFvgLow  := high[2]
    lastBullFvgHigh := low
    lastBullFvgBar  := bar_index

if bearFvgFormed
    lastBearFvgHigh := low[2]
    lastBearFvgLow  := high
    lastBearFvgBar  := bar_index

float lastBullFvgMid = na(lastBullFvgHigh) ? na : (lastBullFvgHigh + lastBullFvgLow) / 2
float lastBearFvgMid = na(lastBearFvgHigh) ? na : (lastBearFvgHigh + lastBearFvgLow) / 2

// FVG still valid: not too old (max 15 bars), price hasn't closed through it
bool bullFvgValid = coreReady and not na(lastBullFvgBar) and bar_index - lastBullFvgBar <= 15 and close > lastBullFvgLow

bool bearFvgValid = coreReady and not na(lastBearFvgBar) and bar_index - lastBearFvgBar <= 15 and close < lastBearFvgHigh

bool nearBullFvg = bullFvgValid and not na(lastBullFvgMid) and close <= lastBullFvgHigh and close >= lastBullFvgLow

bool nearBearFvg = bearFvgValid and not na(lastBearFvgMid) and close >= lastBearFvgLow and close <= lastBearFvgHigh

// FVG retest — strong buy/sell signal when price retests FVG from correct side
bool fvgRetestBuy  = nearBullFvg and close > open and lowerWick > bodyBase * WICK_SIGNIF_RATIO
bool fvgRetestSell = nearBearFvg and close < open and upperWick > bodyBase * WICK_SIGNIF_RATIO
[structurePivotHigh, structurePivotLow] = d1_structureEngine()

var float msLastHigh = na
var float msLastLow = na
var int marketStructureBias = 0
var int bullStructureMemory = 0
var int bearStructureMemory = 0

if not na(structurePivotHigh)
    msLastHigh := structurePivotHigh
if not na(structurePivotLow)
    msLastLow := structurePivotLow

bullBos = ENABLE_MARKET_STRUCTURE_MEMORY and not na(msLastHigh) and close > msLastHigh
bearBos = ENABLE_MARKET_STRUCTURE_MEMORY and not na(msLastLow) and close < msLastLow

bullChoch = ENABLE_MARKET_STRUCTURE_MEMORY and marketStructureBias == -1 and bullBos
bearChoch = ENABLE_MARKET_STRUCTURE_MEMORY and marketStructureBias == 1 and bearBos

bullStructureMemory := math.max(0, bullStructureMemory - 1)
bearStructureMemory := math.max(0, bearStructureMemory - 1)

if bullBos
    marketStructureBias := 1
    bullStructureMemory := STRUCTURE_MEMORY_BARS

if bearBos
    marketStructureBias := -1
    bearStructureMemory := STRUCTURE_MEMORY_BARS

marketMemoryBias = bullStructureMemory > bearStructureMemory ? 1 : bearStructureMemory > bullStructureMemory ? -1 : 0

//======================================================
// MICRO RANGE
//======================================================
microRangeActive = d1_microRangeEngine(atrValue)

//======================================================
// DNA (mapped from Coin Profile)
//======================================================
int coinDnaCode = dnaCodeFromProfile(coinProfileCode)

//======================================================
// HTF
//======================================================
[htfLastPivotHigh, htfLastPivotLow, htfStructureBias] = d1_htfEngine()

//======================================================
// TRUE LIQUIDITY
//======================================================
[dayHighPrev, dayLowPrev, weekHighPrev, weekLowPrev, trueLiquidityHigh, trueLiquidityLow, distToTrueLiqHighAtr, distToTrueLiqLowAtr, nearTrueUpperPool, nearTrueLowerPool, liquidityPoolScoreUp, liquidityPoolScoreDown] = d1_trueLiquidityEngine(resistanceTop, resistanceBottom, supportTop, supportBottom, lastPivotHigh, lastPivotLow, htfLastPivotHigh, htfLastPivotLow, atrValue)

bool supportTruePoolOverlap = (
    not na(trueLiquidityLow) and
    not na(supportTop) and
    not na(supportBottom) and
    trueLiquidityLow <= supportTop + atrValue * ZONE_PROX_ATR and
    trueLiquidityLow >= supportBottom - atrValue * ZONE_PROX_ATR
)

bool resistanceTruePoolOverlap = (
    not na(trueLiquidityHigh) and
    not na(resistanceTop) and
    not na(resistanceBottom) and
    trueLiquidityHigh >= resistanceTop - atrValue * ZONE_PROX_ATR and
    trueLiquidityHigh <= resistanceBottom + atrValue * ZONE_PROX_ATR
)

supportZoneQuality := supportZoneQuality + (supportPivotCluster ? 0.35 : 0.0)
supportZoneQuality := supportZoneQuality + (supportZoneDepth >= 0.70 ? 0.25 : 0.0)
supportZoneQuality := supportZoneQuality + (supportTruePoolOverlap ? 0.35 : 0.0)

resistanceZoneQuality := resistanceZoneQuality + (resistancePivotCluster ? 0.35 : 0.0)
resistanceZoneQuality := resistanceZoneQuality + (resistanceZoneDepth >= 0.70 ? 0.25 : 0.0)
resistanceZoneQuality := resistanceZoneQuality + (resistanceTruePoolOverlap ? 0.35 : 0.0)

//======================================================
// REGIME STABILISATION (hysteresis - 2-bar confirm)
//======================================================
var float regimeConfidence = 0.0
var int regimePendingCode = REGIME_RANGE
var int regimePendingBars = 0

if barstate.isconfirmed
    int rawRegime = rawRegimeCode
    if rawRegime == regimeCodeStable
        regimePendingCode := rawRegime
        regimePendingBars := 0
        regimeConfidence  := 1.0
    else
        if rawRegime == regimePendingCode
            regimePendingBars := regimePendingBars + 1
            if regimePendingBars >= 2
                regimeCodeStable  := rawRegime
                regimePendingBars := 0
                regimeConfidence  := 0.5
        else
            regimePendingCode := rawRegime
            regimePendingBars := 1

// regimeCode already overridden to regimeCodeStable above (after d1_marketEngine call)

//======================================================
// SPACE ENGINE
//======================================================
[adaptiveSpaceMult, adaptiveMinSpaceAbs] = d1_spaceEngine(atrValue, regimeCode, volatilityRatio, wickinessScore, noiseScoreMarket, continuationScore, cbSpaceRelax, coinCrowdedMarket, coinVeryCrowdedMarket, coinProfileCode)

if regimeCode == REGIME_CHAOTIC
    adaptiveSpaceMult += clamp(regimeConfidence * 0.05, 0.0, 0.06)
    adaptiveMinSpaceAbs += atrValue * clamp(regimeConfidence * 0.10, 0.0, 0.12)
else if regimeCode == REGIME_EXPANSION
    adaptiveSpaceMult += clamp(regimeConfidence * 0.03, 0.0, 0.04)
    adaptiveMinSpaceAbs += atrValue * clamp(regimeConfidence * 0.06, 0.0, 0.08)
else if regimeCode == REGIME_COMPRESSION
    adaptiveSpaceMult -= clamp(regimeConfidence * 0.03, 0.0, 0.04)
    adaptiveMinSpaceAbs -= atrValue * clamp(regimeConfidence * 0.04, 0.0, 0.05)

adaptiveSpaceMult := clamp(adaptiveSpaceMult, SPACE_MULT_FLOOR, SPACE_MULT_CEIL)
adaptiveMinSpaceAbs := math.max(atrValue * 0.06, adaptiveMinSpaceAbs)

//======================================================
// SESSION RELAY HIGH/LOW
//======================================================
var float asiaHigh = na
var float asiaLow = na
var float londonHigh = na
var float londonLow = na
var float nyHigh = na
var float nyLow = na

var float savedAsiaHigh = na
var float savedAsiaLow = na
var float savedLondonHigh = na
var float savedLondonLow = na
var float savedNyHigh = na
var float savedNyLow = na

var line relayHighLine = na
var line relayLowLine = na
var string relaySource = ""

if newAsiaSession
    asiaHigh := high
    asiaLow := low
if asiaSession
    asiaHigh := na(asiaHigh) ? high : math.max(asiaHigh, high)
    asiaLow := na(asiaLow) ? low : math.min(asiaLow, low)

if newLondonSession
    londonHigh := high
    londonLow := low
if londonSession
    londonHigh := na(londonHigh) ? high : math.max(londonHigh, high)
    londonLow := na(londonLow) ? low : math.min(londonLow, low)

if newNySession
    nyHigh := high
    nyLow := low
if nySession
    nyHigh := na(nyHigh) ? high : math.max(nyHigh, high)
    nyLow := na(nyLow) ? low : math.min(nyLow, low)

if asiaClosed
    savedAsiaHigh := asiaHigh
    savedAsiaLow := asiaLow
    asiaHigh := na
    asiaLow := na

if londonClosed
    savedLondonHigh := londonHigh
    savedLondonLow := londonLow
    londonHigh := na
    londonLow := na

if nyClosed
    savedNyHigh := nyHigh
    savedNyLow := nyLow
    nyHigh := na
    nyLow := na

if asiaClosed or londonClosed or nyClosed
    clearLine(relayHighLine)
    relayHighLine := na
    clearLine(relayLowLine)
    relayLowLine := na
    relaySource := ""

if newAsiaSession and showRelayHL and not na(savedNyHigh) and not na(savedNyLow)
    clearLine(relayHighLine)
    relayHighLine := na
    clearLine(relayLowLine)
    relayLowLine := na
    relayHighLine := line.new(bar_index, savedNyHigh, bar_index + relayLineExtendBars, savedNyHigh, xloc=xloc.bar_index, color=color.new(color.orange, 10), width=1, style=line.style_dashed)
    relayLowLine := line.new(bar_index, savedNyLow, bar_index + relayLineExtendBars, savedNyLow, xloc=xloc.bar_index, color=color.new(color.orange, 10), width=1, style=line.style_dashed)
    relaySource := "NY"

if newLondonSession and showRelayHL and not na(savedAsiaHigh) and not na(savedAsiaLow)
    clearLine(relayHighLine)
    relayHighLine := na
    clearLine(relayLowLine)
    relayLowLine := na
    relayHighLine := line.new(bar_index, savedAsiaHigh, bar_index + relayLineExtendBars, savedAsiaHigh, xloc=xloc.bar_index, color=color.new(color.blue, 10), width=1, style=line.style_dashed)
    relayLowLine := line.new(bar_index, savedAsiaLow, bar_index + relayLineExtendBars, savedAsiaLow, xloc=xloc.bar_index, color=color.new(color.blue, 10), width=1, style=line.style_dashed)
    relaySource := "ASIA"

if newNySession and showRelayHL and not na(savedLondonHigh) and not na(savedLondonLow)
    clearLine(relayHighLine)
    relayHighLine := na
    clearLine(relayLowLine)
    relayLowLine := na
    relayHighLine := line.new(bar_index, savedLondonHigh, bar_index + relayLineExtendBars, savedLondonHigh, xloc=xloc.bar_index, color=color.new(color.green, 10), width=1, style=line.style_dashed)
    relayLowLine := line.new(bar_index, savedLondonLow, bar_index + relayLineExtendBars, savedLondonLow, xloc=xloc.bar_index, color=color.new(color.green, 10), width=1, style=line.style_dashed)
    relaySource := "LONDON"

//======================================================
// SESSION CURRENT / PREV REFS
//======================================================
float currentSessionHighRef = na
float currentSessionLowRef = na
string currentSessionNameRef = "OFF"

if asiaSession
    currentSessionHighRef := asiaHigh
    currentSessionLowRef := asiaLow
    currentSessionNameRef := "ASIA"
else if londonSession
    currentSessionHighRef := londonHigh
    currentSessionLowRef := londonLow
    currentSessionNameRef := "LONDON"
else if nySession
    currentSessionHighRef := nyHigh
    currentSessionLowRef := nyLow
    currentSessionNameRef := "NEW YORK"
else
    currentSessionHighRef := na
    currentSessionLowRef := na
    currentSessionNameRef := "OFF"

float prevSessionHighRef = na
float prevSessionLowRef = na

if asiaSession
    prevSessionHighRef := savedNyHigh
    prevSessionLowRef := savedNyLow
else if londonSession
    prevSessionHighRef := savedAsiaHigh
    prevSessionLowRef := savedAsiaLow
else if nySession
    prevSessionHighRef := savedLondonHigh
    prevSessionLowRef := savedLondonLow
else
    prevSessionHighRef := na
    prevSessionLowRef := na

float relayHighRef = prevSessionHighRef
float relayLowRef = prevSessionLowRef

[nearCurrentSessionHigh, nearCurrentSessionLow, nearPrevSessionHigh, nearPrevSessionLow, nearRelayHigh, nearRelayLow, relaySweepBelow, relaySweepAbove, sessionReclaimBuyRef, sessionReclaimSellRef, sessionRejectBuyRef, sessionRejectSellRef, sessionBreakoutPressureBuyRef, sessionBreakoutPressureSellRef, sessionLocationScoreBuy, sessionLocationScoreSell, buySessionTargetRef, sellSessionTargetRef] = d1_sessionRefsEngine(currentSessionHighRef, currentSessionLowRef, prevSessionHighRef, prevSessionLowRef, relayHighRef, relayLowRef, atrValue, lowerWick, upperWick, bodyBase, barRange, emaFast, continuationScore, resistanceTop, resistanceBottom, supportTop, supportBottom, lastPivotHigh, lastPivotLow, dayHighPrev, dayLowPrev, weekHighPrev, weekLowPrev, emaSlow)

supportZoneQuality += ((not na(currentSessionLowRef) and currentSessionLowRef <= supportTop + atrValue * ZONE_PROX_ATR and currentSessionLowRef >= supportBottom - atrValue * ZONE_PROX_ATR) or (not na(prevSessionLowRef) and prevSessionLowRef <= supportTop + atrValue * ZONE_PROX_ATR and prevSessionLowRef >= supportBottom - atrValue * ZONE_PROX_ATR)) ? 0.30 : 0.0
resistanceZoneQuality += ((not na(currentSessionHighRef) and currentSessionHighRef >= resistanceTop - atrValue * ZONE_PROX_ATR and currentSessionHighRef <= resistanceBottom + atrValue * ZONE_PROX_ATR) or (not na(prevSessionHighRef) and prevSessionHighRef >= resistanceTop - atrValue * ZONE_PROX_ATR and prevSessionHighRef <= resistanceBottom + atrValue * ZONE_PROX_ATR)) ? 0.30 : 0.0

//======================================================
// PRE-SETUP DISTANCE
//======================================================
[minRisk, maxRisk, minSLDist, tpBuffer, adaptiveEntryBuffer, adaptiveRetestTol, adaptiveSweepTol, adaptiveStopPad, nearSupport, nearResistance] = d1_preSetupDistanceEngine(
    atrValue,
    regimeCode,
    wickinessScore,
    fakeoutScore,
    continuationScore,
    cbRetestBoost,
    cbSweepBoost,
    cbStopBoost,
    supportTop,
    supportBottom,
    resistanceTop,
    resistanceBottom,
    currentSessionHighRef,
    currentSessionLowRef,
    prevSessionHighRef,
    prevSessionLowRef,
    relayHighRef,
    relayLowRef,
    trueLiquidityHigh,
    trueLiquidityLow,
    lastPivotHigh,
    lastPivotLow
)

//======================================================
// COARSE LEVEL FLAGS
//======================================================
bool nearCoarseSupport = (
    not na(supportMid) and
    not na(supportHalfWidth) and
    math.abs(close - supportMid) <= supportHalfWidth + atrValue * 0.22
)

bool nearCoarseResistance = (
    not na(resistanceMid) and
    not na(resistanceHalfWidth) and
    math.abs(close - resistanceMid) <= resistanceHalfWidth + atrValue * 0.22
)

bool insideCoarseSupport = (
    not na(supportMid) and
    not na(supportHalfWidth) and
    low <= supportMid + supportHalfWidth and
    high >= supportMid - supportHalfWidth
)

bool insideCoarseResistance = (
    not na(resistanceMid) and
    not na(resistanceHalfWidth) and
    high >= resistanceMid - resistanceHalfWidth and
    low <= resistanceMid + resistanceHalfWidth
)

float coarseSupportScore = 0.0
coarseSupportScore := coarseSupportScore + (nearCoarseSupport ? 0.8 : 0.0)
coarseSupportScore := coarseSupportScore + (insideCoarseSupport ? 0.5 : 0.0)
coarseSupportScore := coarseSupportScore + (supportPivotCluster ? 0.4 : 0.0)
coarseSupportScore := coarseSupportScore + (supportTruePoolOverlap ? 0.35 : 0.0)
coarseSupportScore := coarseSupportScore + (supportZoneQuality >= 2.0 ? 0.35 : 0.0)
coarseSupportScore := coarseSupportScore + (nearCurrentSessionLow ? 0.25 : 0.0)
coarseSupportScore := coarseSupportScore + (nearPrevSessionLow ? 0.20 : 0.0)
coarseSupportScore := coarseSupportScore + (nearRelayLow ? 0.20 : 0.0)

float coarseResistanceScore = 0.0
coarseResistanceScore := coarseResistanceScore + (nearCoarseResistance ? 0.8 : 0.0)
coarseResistanceScore := coarseResistanceScore + (insideCoarseResistance ? 0.5 : 0.0)
coarseResistanceScore := coarseResistanceScore + (resistancePivotCluster ? 0.4 : 0.0)
coarseResistanceScore := coarseResistanceScore + (resistanceTruePoolOverlap ? 0.35 : 0.0)
coarseResistanceScore := coarseResistanceScore + (resistanceZoneQuality >= 2.0 ? 0.35 : 0.0)
coarseResistanceScore := coarseResistanceScore + (nearCurrentSessionHigh ? 0.25 : 0.0)
coarseResistanceScore := coarseResistanceScore + (nearPrevSessionHigh ? 0.20 : 0.0)
coarseResistanceScore := coarseResistanceScore + (nearRelayHigh ? 0.20 : 0.0)

//======================================================
// LIQUIDITY MAP
//======================================================
[softResistanceReject, softSupportReject, localBlowoffSell, localFlushBuy, microClusterHigh, microClusterLow, hiddenLiquiditySell, hiddenLiquidityBuy, trapSell, trapBuy, volumeSpike, liquidityScoreSell, liquidityScoreBuy, strongLiquiditySell, strongLiquidityBuy, eliteLiquiditySell, eliteLiquidityBuy] = d1_liquidityMapEngine(emaFast, atrValue, bodyBase, upperWick, lowerWick, barRange, trendUpBasic, trendDownBasic, bullRunBars, bearRunBars, nearSupport or nearCoarseSupport, nearResistance or nearCoarseResistance, liquidityPoolScoreUp, liquidityPoolScoreDown, liqThresholdDynamic, lmThresholdDynamic, nearTrueUpperPool, nearTrueLowerPool, bullMacd, bearMacd)

//======================================================
// LIQUIDITY SWEEP + TRAP CONFIRMATION
//======================================================
avgVol20 = volSma20

bullSweepLiq =
     ENABLE_LIQUIDITY_SWEEP_ENGINE and
     coreReady and
     not na(lastPivotLow) and
     low < lastPivotLow - atrValue * 0.02 and
     close > lastPivotLow and
     lowerWick > atrValue * SWEEP_WICK_ATR_MIN

bearSweepLiq =
     ENABLE_LIQUIDITY_SWEEP_ENGINE and
     coreReady and
     not na(lastPivotHigh) and
     high > lastPivotHigh + atrValue * 0.02 and
     close < lastPivotHigh and
     upperWick > atrValue * SWEEP_WICK_ATR_MIN

bullTrapConfirm = coreReady and bullSweepLiq and close > open and volume > avgVol20 * TRAP_VOL_MULT
bearTrapConfirm = coreReady and bearSweepLiq and close < open and volume > avgVol20 * TRAP_VOL_MULT

//======================================================
// TREND CONTINUATION
//======================================================
[trendContinuationBuy, trendContinuationSell] = d1_trendContinuationEngine(trendUpBasic, trendDownBasic, emaFast, bullMacd, bearMacd, regimeCode, microRangeActive)
trendContinuationBuy  := coreReady and trendContinuationBuy
trendContinuationSell := coreReady and trendContinuationSell

//======================================================
// VOL EXP
//======================================================
[volExpScore, volatilityExpansionReady] = d1_volExpEngine(atrValue, atrSlow, avgRange20, barRange, microRangeActive, sessionCode, nearTrueUpperPool, nearTrueLowerPool, liquidityScoreBuy, liquidityScoreSell)
volatilityExpansionReady := coreReady and volatilityExpansionReady

//======================================================
// SESSION VWAP ENGINE (pre-sweep bias still computed below - NOT replaced)
//======================================================
var float vwapNum = 0.0
var float vwapDen = 0.0
var float sessionVwap = na

bool newSession = newAsiaSession or newLondonSession or newNySession

if newSession
    vwapNum := 0.0
    vwapDen := 0.0

float typicalPrice = (high + low + close) / 3.0
vwapNum := vwapNum + typicalPrice * volume
vwapDen := vwapDen + volume
sessionVwap := vwapDen > 0 ? vwapNum / vwapDen : close

float vwapDistAtr  = safeAtrNorm(math.abs(close - sessionVwap), atrValue)
bool priceAboveVwap = coreReady and close > sessionVwap
bool priceBelowVwap = coreReady and close < sessionVwap
bool nearVwap       = coreReady and vwapDistAtr <= 0.25
bool vwapRejBull    = coreReady and priceBelowVwap and lowerWick > bodyBase * WICK_STRONG_RATIO and close > open and nearVwap
bool vwapRejBear    = coreReady and priceAboveVwap and upperWick > bodyBase * WICK_STRONG_RATIO and close < open and nearVwap

plot(SHOW_EMAS and not na(sessionVwap) ? sessionVwap : na, "Session VWAP", color=color.new(color.white, 40), linewidth=1, style=plot.style_circles)

//======================================================
// PRE-SWEEP (inline)
//======================================================
float liqImbalanceUp   = liquidityScoreSell - liquidityScoreBuy
float liqImbalanceDown = liquidityScoreBuy  - liquidityScoreSell
bool nearUpperPool     = distToTrueLiqHighAtr <= PRE_SWEEP_NEAR_POOL_ATR
bool nearLowerPool     = distToTrueLiqLowAtr  <= PRE_SWEEP_NEAR_POOL_ATR
bool sweepWindow       = sessionCode == SESSION_LONDON or sessionCode == SESSION_NY_OPEN or sessionCode == SESSION_NY_LATE

float preSweepUpRisk = 0.0
preSweepUpRisk += liqImbalanceUp   >= PRE_SWEEP_LIQ_IMBALANCE_MIN ? 1.0 : 0.0
preSweepUpRisk += nearUpperPool    ? 0.9 : 0.0
preSweepUpRisk += upperWick > bodyBase * WICK_SIGNIF_RATIO and candleBody < atrValue * SMALL_BODY_ATR and nearUpperPool ? 0.6 : 0.0
preSweepUpRisk += zoneCrowdingScore >= 3.0 ? 0.4 : 0.0
preSweepUpRisk += fakeoutScore     > 0.24 ? 0.35 : 0.0
preSweepUpRisk += sweepWindow      ? 0.30 : 0.0
preSweepUpRisk += microRangeActive ? 0.20 : 0.0

float preSweepDownRisk = 0.0
preSweepDownRisk += liqImbalanceDown  >= PRE_SWEEP_LIQ_IMBALANCE_MIN ? 1.0 : 0.0
preSweepDownRisk += nearLowerPool     ? 0.9 : 0.0
preSweepDownRisk += lowerWick > bodyBase * WICK_SIGNIF_RATIO and candleBody < atrValue * SMALL_BODY_ATR and nearLowerPool ? 0.6 : 0.0
preSweepDownRisk += zoneCrowdingScore >= 3.0 ? 0.4 : 0.0
preSweepDownRisk += fakeoutScore      > 0.24 ? 0.35 : 0.0
preSweepDownRisk += sweepWindow       ? 0.30 : 0.0
preSweepDownRisk += microRangeActive  ? 0.20 : 0.0

int preSweepBias = 0
if ENABLE_PRE_SWEEP_ENGINE and coreReady
    if preSweepUpRisk >= preScoreThresholdDynamic and preSweepUpRisk > preSweepDownRisk
        preSweepBias := 1
    else if preSweepDownRisk >= preScoreThresholdDynamic and preSweepDownRisk > preSweepUpRisk
        preSweepBias := -1

//======================================================
// BREAKOUT / BREAKDOWN ANTICIPATION
//======================================================
[nearBreakoutRef, nearBreakdownRef, bullPressureBuild, bearPressureBuild, bullFalseBreakRisk, bearFalseBreakRisk, breakoutAnticipationBuy, breakdownAnticipationSell, smartBreakoutReadyBuy, smartBreakdownReadySell] = d1_breakoutEngine(
    currentSessionHighRef,
    currentSessionLowRef,
    prevSessionHighRef,
    prevSessionLowRef,
    relayHighRef,
    relayLowRef,
    resistanceTop,
    supportTop,
    lastPivotHigh,
    lastPivotLow,
    dayHighPrev,
    dayLowPrev,
    weekHighPrev,
    weekLowPrev,
    trueLiquidityHigh,
    trueLiquidityLow,
    atrValue,
    barRange,
    continuationScore,
    liquidityScoreSell,
    liquidityScoreBuy,
    liqThresholdDynamic,
    eliteLiquiditySell,
    eliteLiquidityBuy,
    bearTrapConfirm,
    bullTrapConfirm,
    preSweepBias,
    fakeoutScore,
    wickinessScore,
    coinCrowdedMarket,
    regimeCode,
    sessionReclaimSellRef,
    sessionReclaimBuyRef,
    cbBreakoutBias,
    trendContinuationBuy,
    trendContinuationSell,
    marketMemoryBias,
    htfStructureBias,
    volatilityExpansionReady,
    sessionCode,
    sessionBreakoutPressureBuyRef,
    sessionBreakoutPressureSellRef,
    bullMacd,
    bearMacd,
    emaFast,
    emaSlow,
    zoneCrowdingScore
)
smartBreakoutReadyBuy  := coreReady and smartBreakoutReadyBuy
smartBreakdownReadySell := coreReady and smartBreakdownReadySell

//======================================================
// BREAKOUT V2 (minimal) - tidig squeeze + PRIMED/TRIGGER markorer
// Additivt: markorer + trigger-alerts, driver INTE signaler.
//======================================================
d1_breakoutMiniV2(float atr_, float barRange_, float volSma20_, bool coreReady_, int htfBias_, bool poolUp_, bool poolDn_) =>
    [_, bbUp_, bbLow_] = ta.bb(close, 20, 2.0)
    [_, kcUp_, kcLow_] = ta.kc(close, 20, 1.5)
    bool  squeeze_ = bbUp_ < kcUp_ and bbLow_ > kcLow_
    bool  volDry_  = ta.sma(volume, 5) < ta.sma(volume, 20) * 0.85
    float rngTop_  = ta.highest(high[1], 20)
    float rngBot_  = ta.lowest(low[1],  20)
    float rngHAtr_ = safeAtrNorm(rngTop_ - rngBot_, atr_)
    bool  definedRange_ = not na(rngTop_) and not na(rngBot_) and rngHAtr_ <= 3.0
    float posInRng_ = safeDiv(close - rngBot_, rngTop_ - rngBot_, 0.5)
    bool  biasUp_  = htfBias_ == 1  or poolUp_ or posInRng_ > 0.60
    bool  biasDn_  = htfBias_ == -1 or poolDn_ or posInRng_ < 0.40
    bool  primedBuy_  = coreReady_ and definedRange_ and volDry_ and squeeze_ and biasUp_ and not biasDn_
    bool  primedSell_ = coreReady_ and definedRange_ and volDry_ and squeeze_ and biasDn_ and not biasUp_
    bool  expBar_ = barRange_ > atr_ * 1.2 and volume > volSma20_ * 1.3
    bool  trigBuy_  = ta.barssince(primedBuy_)  <= 20 and close > rngTop_ and expBar_
    bool  trigSell_ = ta.barssince(primedSell_) <= 20 and close < rngBot_ and expBar_
    [primedBuy_, primedSell_, trigBuy_, trigSell_]

[v2PrimedBuy, v2PrimedSell, v2TrigBuy, v2TrigSell] = d1_breakoutMiniV2(atrValue, barRange, volSma20, coreReady, htfStructureBias, nearTrueUpperPool, nearTrueLowerPool)

plotshape(v2PrimedBuy,  title="V2 Primed Buy",   style=shape.circle,       location=location.belowbar, color=color.new(color.aqua, 0),   size=size.tiny)
plotshape(v2TrigBuy,    title="V2 Trigger Buy",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0),   size=size.small)
plotshape(v2PrimedSell, title="V2 Primed Sell",  style=shape.circle,       location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny)
plotshape(v2TrigSell,   title="V2 Trigger Sell", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),    size=size.small)

alertcondition(v2TrigBuy,  title="BO V2 Trigger Long",  message="Breakout V2 confirmed LONG")
alertcondition(v2TrigSell, title="BO V2 Trigger Short", message="Breakout V2 confirmed SHORT")

//======================================================
// DEL 1 TELEMETRY / BRIDGE FOR DEL 2 + DEL 3
//======================================================
float buyBreakAntScore = nz(breakoutAnticipationBuy, 0.0)
float sellBreakAntScore = nz(breakdownAnticipationSell, 0.0)

float breakAntEarlyThreshold = BREAK_ANTICIPATION_THRESHOLD * 0.74
float breakAntStrongThreshold = BREAK_ANTICIPATION_THRESHOLD + 0.55

bool buyBreakAntEarly =
     coreReady and
     ENABLE_BREAK_ANTICIPATION and
     nearBreakoutRef and
     buyBreakAntScore >= breakAntEarlyThreshold and
     nz(bullPressureBuild, 0.0) > nz(bullFalseBreakRisk, 0.0) * 0.75

bool sellBreakAntEarly =
     coreReady and
     ENABLE_BREAK_ANTICIPATION and
     nearBreakdownRef and
     sellBreakAntScore >= breakAntEarlyThreshold and
     nz(bearPressureBuild, 0.0) > nz(bearFalseBreakRisk, 0.0) * 0.75

bool buyBreakAntStrong =
     coreReady and
     ENABLE_BREAK_ANTICIPATION and
     smartBreakoutReadyBuy and
     buyBreakAntScore >= breakAntStrongThreshold

bool sellBreakAntStrong =
     coreReady and
     ENABLE_BREAK_ANTICIPATION and
     smartBreakdownReadySell and
     sellBreakAntScore >= breakAntStrongThreshold

int marketStructureProxy = nz(marketMemoryBias, 0)
int htfProxyBias = nz(htfStructureBias, 0)

///======================================================
///======================================================
// DEL 2 - CLEAN REWRITE / FULL SYNC WITH DEL 1
// QUALITY / PERMISSION / BUILD SELECTION ENGINE
// PINE v6 SAFE VERSION
//======================================================

//======================================================
// INPUTS - PRO ENGINES
//======================================================
ENABLE_LIQUIDITY_PATH_ENGINE = input.bool(true, "Enable Liquidity Path Predictor")
ENABLE_FALSE_BREAKOUT_FILTER = input.bool(true, "Enable False Breakout Filter")
ENABLE_WHALE_VOLUME_ENGINE   = input.bool(true, "Enable Whale Volume Detector")

LIQ_PATH_NEAR_POOL_ATR = input.float(0.85, "Liquidity Path Near Pool ATR", step=0.05)
LIQ_PATH_IMBALANCE_MIN = input.float(0.80, "Liquidity Path Imbalance Min", step=0.05)
LIQ_PATH_STRONG_TH     = input.float(2.1, "Liquidity Path Strong Threshold", step=0.1)

FALSE_BO_SCORE_TH = input.float(1.55, "False Breakout Score Threshold", step=0.1)
WHALE_VOL_MULT    = input.float(1.80, "Whale Volume Mult", step=0.05)
WHALE_RANGE_MULT  = input.float(1.25, "Whale Range Mult", step=0.05)

TC_COOLDOWN_BARS   = input.int(5, "TC Cooldown Bars", minval=1, maxval=20)
LS_COOLDOWN_BARS   = input.int(4, "LS Cooldown Bars", minval=1, maxval=20)
TRAP_COOLDOWN_BARS = input.int(5, "Trap Cooldown Bars", minval=1, maxval=20)

TC_MIN_CONT_SCORE   = input.float(0.42, "TC Min Continuation Score", step=0.01)
TC_MAX_EMA_DIST_ATR = input.float(0.90, "TC Max EMA Dist ATR", step=0.05)

LS_MIN_WICK_BODY = input.float(1.05, "LS Min Wick/Body", step=0.05)
LS_MIN_SWEEP_ATR = input.float(0.08, "LS Min Sweep ATR", step=0.01)


//======================================================
// EARLY BUILD / EARLY LEVELS
//======================================================
ENABLE_EARLY_LEVEL_BUILD = input.bool(true, "Enable Early Level Build")
EARLY_PRE_SCORE_PAD      = input.float(0.35, "Early PRE Score Pad", step=0.05)
EARLY_ENTRY_BUFFER_MULT  = input.float(0.72, "Early Entry Buffer Mult", step=0.05)
EARLY_STOP_PAD_MULT      = input.float(1.08, "Early Stop Pad Mult", step=0.05)
EARLY_SPACE_RELAX_MULT   = input.float(0.88, "Early Space Relax Mult", step=0.05)
EARLY_RR_RELAX           = input.float(0.04, "Early RR Relax", step=0.01)

STRUCT_CONT_LOOKBACK    = input.int(3, "Continuation Structure Lookback", minval=2, maxval=10)
STRUCT_RECLAIM_LOOKBACK = input.int(4, "Reclaim Structure Lookback", minval=2, maxval=10)
STRUCT_SWEEP_LOOKBACK   = input.int(6, "Sweep Structure Lookback", minval=3, maxval=12)

//======================================================
// SESSION BIAS / CONFLUENCE / VISUAL TUNING
//======================================================
ENABLE_SESSION_BIAS_ENGINE = input.bool(true, "Enable Session Bias Engine")
ENABLE_CONFLUENCE_ENGINE   = input.bool(true, "Enable Confluence Engine")

SESSION_BIAS_WEIGHT             = input.float(0.34, "Session Bias Weight", step=0.01)
SESSION_LOCATION_WEIGHT         = input.float(0.22, "Session Location Weight", step=0.01)
SESSION_BREAKOUT_PRESSURE_BONUS = input.float(0.24, "Session Breakout Pressure Bonus", step=0.01)
SESSION_RECLAIM_BONUS           = input.float(0.28, "Session Reclaim Bonus", step=0.01)

CONFLUENCE_READY_TH      = input.float(2.20, "Confluence Ready Threshold", step=0.05)
CONFLUENCE_STRONG_TH     = input.float(3.20, "Confluence Strong Threshold", step=0.05)
CONFLUENCE_SCORE_MULT    = input.float(0.16, "Confluence Score Mult", step=0.01)
CONFLUENCE_CONTEXT_MULT  = input.float(0.12, "Confluence Context Mult", step=0.01)

EARLY_BUILD_PERSIST_BARS  = input.int(2, "Early Build Persist Bars", minval=1, maxval=5)
EARLY_BUILD_MIN_CONFL     = input.float(1.60, "Early Build Min Confluence", step=0.05)
EARLY_BUILD_SCORE_HOLD    = input.float(0.12, "Early Build Score Hold", step=0.01)
EARLY_BUILD_SESSION_BOOST = input.float(0.18, "Early Build Session Boost", step=0.01)
EARLY_BUILD_PATH_BOOST    = input.float(0.14, "Early Build Path Boost", step=0.01)

//======================================================
// CONSTANTS
//======================================================
EXEC_MODE_SKIP     = 0
EXEC_MODE_CONT     = 1
EXEC_MODE_RECLAIM  = 2
EXEC_MODE_SWEEP    = 3
EXEC_MODE_BREAKOUT = 4

STATUS_NONE   = 0
STATUS_PRE    = 1
STATUS_READY  = 2
STATUS_ACTIVE = 3

SETUP_NONE           = 0
SETUP_RECLAIM        = 1
SETUP_SWEEP          = 2
SETUP_CONTINUATION   = 3
SETUP_BREAKOUT_BUILD = 4
SETUP_LIQUIDITY_TRAP = 5
SETUP_REVERSAL       = 6
SETUP_VWAP_REVERSION = 7
SETUP_OPEN_MOMENTUM  = 8
SETUP_FAILED_BREAKOUT = 9

SIDE_BUY  = 1
SIDE_SELL = -1

//======================================================
// HELPERS
//======================================================
d2_isBuy(int side) =>
    side == SIDE_BUY




d2_clamp(float v, float lo, float hi) =>
    math.max(lo, math.min(hi, v))

liquidityPathText(int pathBias, float pathStrength) =>
    string txt = "NEUTRAL"
    if pathBias == -1
        txt := pathStrength >= LIQ_PATH_STRONG_TH + 0.8 ? "UP STRONG" : "UP"
    else if pathBias == 1
        txt := pathStrength >= LIQ_PATH_STRONG_TH + 0.8 ? "DOWN STRONG" : "DOWN"
    txt

whaleText(int wb) =>
    string txt = "NONE"
    if wb == 1
        txt := "BULL"
    else if wb == -1
        txt := "BEAR"
    txt

falseBreakoutText(bool buyRisk, bool sellRisk) =>
    string txt = "OFF"
    if buyRisk and not sellRisk
        txt := "BUY RISK"
    else if sellRisk and not buyRisk
        txt := "SELL RISK"
    else if buyRisk and sellRisk
        txt := "BOTH"
    txt

statusTextMain(int s) =>
    string txt = "NONE"
    if s == STATUS_PRE
        txt := "PRE"
    else if s == STATUS_READY
        txt := "READY"
    else if s == STATUS_ACTIVE
        txt := "ACTIVE"
    txt


d3_adaptiveExitProfile(int regime_, int intent_, int setupType_, float score_, bool strongReject_) =>
    float tp1Mul_ = 1.0
    float tp2Mul_ = 1.0
    float tp3Mul_ = 1.0
    float beOffsetR_ = 0.0

    if regime_ == REGIME_CHAOTIC
        tp1Mul_ := 0.96
        tp2Mul_ := 0.86
        tp3Mul_ := 0.78
        beOffsetR_ := 0.00
    else if regime_ == REGIME_COMPRESSION
        tp1Mul_ := 0.94
        tp2Mul_ := 0.84
        tp3Mul_ := 0.76
        beOffsetR_ := 0.01
    else if regime_ == REGIME_RANGE
        tp1Mul_ := 0.99
        tp2Mul_ := 0.92
        tp3Mul_ := 0.88
        beOffsetR_ := 0.01
    else if regime_ == REGIME_EXPANSION
        tp1Mul_ := 1.06
        tp2Mul_ := 1.18
        tp3Mul_ := 1.42
        beOffsetR_ := 0.08
    else if regime_ == REGIME_TREND_UP or regime_ == REGIME_TREND_DOWN
        tp1Mul_ := 1.03
        tp2Mul_ := 1.10
        tp3Mul_ := 1.26
        beOffsetR_ := 0.05

    if intent_ == INTENT_EXPANSION
        tp2Mul_ += 0.08
        tp3Mul_ += 0.14
    else if intent_ == INTENT_SCALP
        tp1Mul_ -= 0.04
        tp2Mul_ -= 0.08
        tp3Mul_ -= 0.12
    else if intent_ == INTENT_CONTINUATION
        tp2Mul_ += 0.04
        tp3Mul_ += 0.08
        beOffsetR_ += 0.01

    if setupType_ == SETUP_BREAKOUT_BUILD or setupType_ == SETUP_CONTINUATION
        tp2Mul_ += 0.06
        tp3Mul_ += 0.10
    else if setupType_ == SETUP_LIQUIDITY_TRAP or setupType_ == SETUP_REVERSAL or setupType_ == SETUP_SWEEP
        tp1Mul_ -= 0.02
        tp2Mul_ -= 0.03
        tp3Mul_ -= 0.06

    if strongReject_
        tp1Mul_ -= 0.03
        tp2Mul_ -= 0.04
        tp3Mul_ -= 0.06
        beOffsetR_ += 0.01

    if score_ >= 9.0
        tp2Mul_ += 0.04
        tp3Mul_ += 0.08
    else if score_ < 6.5
        tp1Mul_ -= 0.02
        tp2Mul_ -= 0.05
        tp3Mul_ -= 0.08

    tp1Mul_ := d2_clamp(tp1Mul_, 0.82, 1.18)
    tp2Mul_ := d2_clamp(tp2Mul_, 0.72, 1.42)
    tp3Mul_ := d2_clamp(tp3Mul_, 0.62, 1.75)
    beOffsetR_ := d2_clamp(beOffsetR_, 0.0, 0.18)

    [tp1Mul_, tp2Mul_, tp3Mul_, beOffsetR_]

setupTypeText(int st) =>
    string txt = "NONE"
    if st == SETUP_RECLAIM
        txt := "RECLAIM"
    else if st == SETUP_SWEEP
        txt := "SWEEP"
    else if st == SETUP_CONTINUATION
        txt := "CONT"
    else if st == SETUP_BREAKOUT_BUILD
        txt := "BREAKOUT"
    else if st == SETUP_LIQUIDITY_TRAP
        txt := "TRAP"
    else if st == SETUP_REVERSAL
        txt := "REVERSAL"
    else if st == SETUP_VWAP_REVERSION
        txt := "VWAP REV"
    else if st == SETUP_OPEN_MOMENTUM
        txt := "OPEN MOM"
    else if st == SETUP_FAILED_BREAKOUT
        txt := "FAIL BRK"
    txt

sessionBiasText(float v) =>
    string txt = "NEUTRAL"
    if v >= 0.85
        txt := "STRONG BUY"
    else if v >= 0.25
        txt := "BUY"
    else if v <= -0.85
        txt := "STRONG SELL"
    else if v <= -0.25
        txt := "SELL"
    txt



getPreSweepScoreBonus(int side, int preSweepBias_, int intent_) =>
    d2_isBuy(side) ? (preSweepBias_ == -1 ? 0.20 : preSweepBias_ == 1 ? -0.28 : 0.0) : (preSweepBias_ == 1 ? 0.20 : preSweepBias_ == -1 ? -0.28 : 0.0)

getContextPreSweepPrimary(int side, int preSweepBias_, int intent_) =>
    d2_isBuy(side) ? (preSweepBias_ == -1 ? 0.12 : preSweepBias_ == 1 ? -0.16 : 0.0) : (preSweepBias_ == 1 ? 0.12 : preSweepBias_ == -1 ? -0.16 : 0.0)

//======================================================
// RUNTIME MEMORY
//======================================================
var int lastTcBuyBar    = na
var int lastTcSellBar   = na
var int lastLsBuyBar    = na
var int lastLsSellBar   = na
var int lastTrapBuyBar  = na
var int lastTrapSellBar = na

float emaDistAtr = safeAtrNorm(math.abs(close - emaFast), atrValue)
float barEff     = safeDiv(candleBody, math.max(barRange, syminfo.mintick), 0.0)

//======================================================
// SESSION BIAS ENGINE
//======================================================
float sessionBiasScore = 0.0
if ENABLE_SESSION_BIAS_ENGINE
    sessionBiasScore += sessionCode == SESSION_NY_OPEN ? 0.22 : 0.0
    sessionBiasScore += sessionCode == SESSION_LONDON ? 0.12 : 0.0
    sessionBiasScore += sessionCode == SESSION_NY_LATE ? 0.10 : 0.0

    sessionBiasScore += trendUpBasic and close >= emaFast ? SESSION_BIAS_WEIGHT * 0.55 : 0.0
    sessionBiasScore -= trendDownBasic and close <= emaFast ? SESSION_BIAS_WEIGHT * 0.55 : 0.0

    sessionBiasScore += sessionLocationScoreBuy * SESSION_LOCATION_WEIGHT
    sessionBiasScore -= sessionLocationScoreSell * SESSION_LOCATION_WEIGHT

    sessionBiasScore += sessionReclaimBuyRef ? SESSION_RECLAIM_BONUS : 0.0
    sessionBiasScore -= sessionReclaimSellRef ? SESSION_RECLAIM_BONUS : 0.0

    sessionBiasScore += sessionBreakoutPressureBuyRef ? SESSION_BREAKOUT_PRESSURE_BONUS : 0.0
    sessionBiasScore -= sessionBreakoutPressureSellRef ? SESSION_BREAKOUT_PRESSURE_BONUS : 0.0

    sessionBiasScore += nearCurrentSessionLow and bullTrapConfirm ? 0.18 : 0.0
    sessionBiasScore -= nearCurrentSessionHigh and bearTrapConfirm ? 0.18 : 0.0

    sessionBiasScore += nearRelayLow and strongLiquidityBuy ? 0.12 : 0.0
    sessionBiasScore -= nearRelayHigh and strongLiquiditySell ? 0.12 : 0.0

sessionBiasScore := d2_clamp(sessionBiasScore, -1.5, 1.5)

getSessionBiasBonus(int side) =>
    d2_isBuy(side) ? math.max(sessionBiasScore, 0.0) : math.max(-sessionBiasScore, 0.0)

getSessionBiasPenalty(int side) =>
    d2_isBuy(side) ? math.max(-sessionBiasScore, 0.0) : math.max(sessionBiasScore, 0.0)

getSessionBreakBonus(int side) =>
    d2_isBuy(side) ? (sessionBreakoutPressureBuyRef ? SESSION_BREAKOUT_PRESSURE_BONUS : 0.0) : (sessionBreakoutPressureSellRef ? SESSION_BREAKOUT_PRESSURE_BONUS : 0.0)

getSessionReclaimBonus(int side) =>
    d2_isBuy(side) ? (sessionReclaimBuyRef ? SESSION_RECLAIM_BONUS : 0.0) : (sessionReclaimSellRef ? SESSION_RECLAIM_BONUS : 0.0)

//======================================================
// LIQUIDITY PATH ENGINE
//======================================================
float liqPathImbalanceUp   = liquidityScoreSell - liquidityScoreBuy
float liqPathImbalanceDown = liquidityScoreBuy - liquidityScoreSell

float distToUpperPathAtr = na(trueLiquidityHigh) ? 99.0 : safeAtrNorm(trueLiquidityHigh - close, atrValue)
float distToLowerPathAtr = na(trueLiquidityLow) ? 99.0 : safeAtrNorm(close - trueLiquidityLow, atrValue)

bool nearUpperPathPool = distToUpperPathAtr <= LIQ_PATH_NEAR_POOL_ATR
bool nearLowerPathPool = distToLowerPathAtr <= LIQ_PATH_NEAR_POOL_ATR

bool upperPathCompression = nearUpperPathPool and candleBody < atrValue * SMALL_BODY_ATR and upperWick > bodyBase * WICK_SIGNIF_RATIO
bool lowerPathCompression = nearLowerPathPool and candleBody < atrValue * SMALL_BODY_ATR and lowerWick > bodyBase * WICK_SIGNIF_RATIO

float liquidityPathUpScore = 0.0
liquidityPathUpScore += liqPathImbalanceUp >= LIQ_PATH_IMBALANCE_MIN ? 1.0 : 0.0
liquidityPathUpScore += nearUpperPathPool ? 0.9 : 0.0
liquidityPathUpScore += upperPathCompression ? 0.55 : 0.0
liquidityPathUpScore += microRangeActive ? 0.35 : 0.0
liquidityPathUpScore += volatilityExpansionReady ? 0.35 : 0.0
liquidityPathUpScore += buyBreakAntEarly ? 0.45 : 0.0
liquidityPathUpScore += (sessionCode == SESSION_LONDON or sessionCode == SESSION_NY_OPEN or sessionCode == SESSION_NY_LATE) ? 0.30 : 0.0
liquidityPathUpScore += zoneCrowdingScore >= 3.0 ? 0.25 : 0.0

float liquidityPathDownScore = 0.0
liquidityPathDownScore += liqPathImbalanceDown >= LIQ_PATH_IMBALANCE_MIN ? 1.0 : 0.0
liquidityPathDownScore += nearLowerPathPool ? 0.9 : 0.0
liquidityPathDownScore += lowerPathCompression ? 0.55 : 0.0
liquidityPathDownScore += microRangeActive ? 0.35 : 0.0
liquidityPathDownScore += volatilityExpansionReady ? 0.35 : 0.0
liquidityPathDownScore += sellBreakAntEarly ? 0.45 : 0.0
liquidityPathDownScore += (sessionCode == SESSION_LONDON or sessionCode == SESSION_NY_OPEN or sessionCode == SESSION_NY_LATE) ? 0.30 : 0.0
liquidityPathDownScore += zoneCrowdingScore >= 3.0 ? 0.25 : 0.0

// CONVENTION: liquidityPathBias uses inverted sign intentionally.
// -1 = UP-path (price pulling toward liquidity above)
//  1 = DOWN-path (price pulling toward liquidity below)
//  0 = no clear path
// All consumers compensate for this. Do NOT change to intuitive sign
// without updating every consumer (search: liquidityPathBias).
int liquidityPathBias = 0
if ENABLE_LIQUIDITY_PATH_ENGINE
    if liquidityPathUpScore >= LIQ_PATH_STRONG_TH and liquidityPathUpScore > liquidityPathDownScore
        liquidityPathBias := -1
    else if liquidityPathDownScore >= LIQ_PATH_STRONG_TH and liquidityPathDownScore > liquidityPathUpScore
        liquidityPathBias := 1
    else
        liquidityPathBias := 0
else
    liquidityPathBias := 0

float liquidityPathStrength = math.max(liquidityPathUpScore, liquidityPathDownScore)

//======================================================
// STRUCTURAL / CANDLE SETUP CORE
//======================================================
float activeEntryBufferBuy  = adaptiveEntryBuffer
float activeEntryBufferSell = adaptiveEntryBuffer

bool bullSweep = USE_SWEEPS and not na(supportBottom) and not na(supportTop) and low < supportBottom - adaptiveSweepTol and close > supportTop and close > open
bool bearSweep = USE_SWEEPS and not na(resistanceBottom) and not na(resistanceTop) and high > resistanceBottom + adaptiveSweepTol and close < resistanceTop and close < open

bool bullBounce = USE_BOUNCES and nearSupport and close > open and lowerWick >= bodyBase * WICK_SIGNIF_RATIO and close >= low + barRange * 0.55 and (close >= close[1] or low <= low[1])
bool bearReject = USE_BOUNCES and nearResistance and close < open and upperWick >= bodyBase * WICK_SIGNIF_RATIO and close <= high - barRange * 0.55 and (close <= close[1] or high >= high[1])

bool softBullReclaim = nearSupport and (na(supportTop) ? true : low <= supportTop + adaptiveRetestTol) and close >= emaFast and close > low + (high - low) * 0.50
bool softBearReclaim = nearResistance and (na(resistanceTop) ? true : high >= resistanceTop - adaptiveRetestTol) and close <= emaFast and close < high - (high - low) * 0.50

bool bullRetest = USE_RETESTS and not na(resistanceTop) and low <= resistanceTop + adaptiveRetestTol and close > resistanceTop and close > open
bool bearRetest = USE_RETESTS and not na(supportTop) and high >= supportTop - adaptiveRetestTol and close < supportTop and close < open

bool bullBreakout = USE_BREAKOUTS and not na(resistanceTop) and close > resistanceTop and close > open and high > resistanceTop
bool bearBreakdown = USE_BREAKOUTS and not na(supportBottom) and close < supportBottom and close < open and low < supportBottom

bool localLowSweep  = low < low5Prev
bool localHighSweep = high > high5Prev

bool bullTrap = (localLowSweep and nearSupport and close > open and lowerWick >= bodyBase * WICK_STRONG_RATIO and close >= low + barRange * 0.55 and (na(supportTop) or close > supportTop)) or (not na(lastPivotLow) and math.abs(low - lastPivotLow) <= adaptiveRetestTol and lowerWick >= bodyBase * 0.60 and close > open)
bool bearTrap = (localHighSweep and nearResistance and close < open and upperWick >= bodyBase * WICK_STRONG_RATIO and close <= high - barRange * 0.55 and (na(resistanceTop) or close < resistanceTop)) or (not na(lastPivotHigh) and math.abs(high - lastPivotHigh) <= adaptiveRetestTol and upperWick >= bodyBase * 0.60 and close < open)

//======================================================
// FALSE BREAKOUT FILTER
//======================================================
bool breakoutCompression = compressionScore > 0.35 or microRangeActive
bool breakoutCrowded     = zoneCrowdingScore >= 2.8
bool breakoutFakeoutRisk = fakeoutScore > 0.25
bool breakoutWeakBody    = candleBody < atrValue * 0.28

bool breakoutAgainstPathBuy  = liquidityPathBias == 1
bool breakoutAgainstPathSell = liquidityPathBias == -1

float falseBreakoutBuyScore = 0.0
falseBreakoutBuyScore += bullBreakout ? 0.4 : 0.0
falseBreakoutBuyScore += breakoutCompression ? 0.60 : 0.0
falseBreakoutBuyScore += breakoutCrowded ? 0.60 : 0.0
falseBreakoutBuyScore += breakoutFakeoutRisk ? 0.4 : 0.0
falseBreakoutBuyScore += breakoutWeakBody ? 0.3 : 0.0
falseBreakoutBuyScore += breakoutAgainstPathBuy ? 0.65 : 0.0
falseBreakoutBuyScore += upperWick > bodyBase * 0.75 ? 0.2 : 0.0
falseBreakoutBuyScore += buyBreakAntScore < BREAK_ANTICIPATION_THRESHOLD * 0.70 ? 0.55 : 0.0
falseBreakoutBuyScore += smartBreakoutReadyBuy ? -0.30 : 0.0
falseBreakoutBuyScore += trendContinuationBuy ? -0.15 : 0.0
falseBreakoutBuyScore += marketMemoryBias == 1 ? -0.10 : 0.0
falseBreakoutBuyScore += htfStructureBias == 1 ? -0.12 : 0.0

float falseBreakoutSellScore = 0.0
falseBreakoutSellScore += bearBreakdown ? 0.4 : 0.0
falseBreakoutSellScore += breakoutCompression ? 0.60 : 0.0
falseBreakoutSellScore += breakoutCrowded ? 0.60 : 0.0
falseBreakoutSellScore += breakoutFakeoutRisk ? 0.4 : 0.0
falseBreakoutSellScore += breakoutWeakBody ? 0.3 : 0.0
falseBreakoutSellScore += breakoutAgainstPathSell ? 0.65 : 0.0
falseBreakoutSellScore += lowerWick > bodyBase * 0.75 ? 0.2 : 0.0
falseBreakoutSellScore += sellBreakAntScore < BREAK_ANTICIPATION_THRESHOLD * 0.70 ? 0.55 : 0.0
falseBreakoutSellScore += smartBreakdownReadySell ? -0.30 : 0.0
falseBreakoutSellScore += trendContinuationSell ? -0.15 : 0.0
falseBreakoutSellScore += marketMemoryBias == -1 ? -0.10 : 0.0
falseBreakoutSellScore += htfStructureBias == -1 ? -0.12 : 0.0

bool falseBreakoutRiskBuy  = ENABLE_FALSE_BREAKOUT_FILTER and falseBreakoutBuyScore >= FALSE_BO_SCORE_TH
bool falseBreakoutRiskSell = ENABLE_FALSE_BREAKOUT_FILTER and falseBreakoutSellScore >= FALSE_BO_SCORE_TH

//======================================================
// WHALE VOLUME DETECTOR
//======================================================


bool whaleBullEvent =
     ENABLE_WHALE_VOLUME_ENGINE and
     volume > volSma20 * WHALE_VOL_MULT and
     barRange > avgRange20 * WHALE_RANGE_MULT and
     close > open and
     close > high - barRange * 0.25

bool whaleBearEvent =
     ENABLE_WHALE_VOLUME_ENGINE and
     volume > volSma20 * WHALE_VOL_MULT and
     barRange > avgRange20 * WHALE_RANGE_MULT and
     close < open and
     close < low + barRange * 0.25

bool whaleAbsorptionBuy =
     ENABLE_WHALE_VOLUME_ENGINE and
     volume > volSma20 * (WHALE_VOL_MULT - 0.20) and
     lowerWick > bodyBase * 1.30 and
     close > open and
     (nearSupport or nearCurrentSessionLow or nearRelayLow)

bool whaleAbsorptionSell =
     ENABLE_WHALE_VOLUME_ENGINE and
     volume > volSma20 * (WHALE_VOL_MULT - 0.20) and
     upperWick > bodyBase * 1.30 and
     close < open and
     (nearResistance or nearCurrentSessionHigh or nearRelayHigh)

float whaleBullScore = 0.0
whaleBullScore += whaleBullEvent ? 1.0 : 0.0
whaleBullScore += whaleAbsorptionBuy ? 0.8 : 0.0
whaleBullScore += strongLiquidityBuy ? 0.35 : 0.0
whaleBullScore += smartBreakoutReadyBuy ? 0.25 : 0.0

float whaleBearScore = 0.0
whaleBearScore += whaleBearEvent ? 1.0 : 0.0
whaleBearScore += whaleAbsorptionSell ? 0.8 : 0.0
whaleBearScore += strongLiquiditySell ? 0.35 : 0.0
whaleBearScore += smartBreakdownReadySell ? 0.25 : 0.0

int whaleBias = whaleBullScore > whaleBearScore ? 1 : whaleBearScore > whaleBullScore ? -1 : 0

getPathAssistScore(int side) =>
    d2_isBuy(side) ? (liquidityPathBias == -1 ? 0.25 : 0.0) : (liquidityPathBias == 1 ? 0.25 : 0.0)

getPathScoreBonus(int side) =>
    d2_isBuy(side) ? (liquidityPathBias == -1 ? 0.45 : liquidityPathBias == 1 ? -0.35 : 0.0) : (liquidityPathBias == 1 ? 0.45 : liquidityPathBias == -1 ? -0.35 : 0.0)

getWhaleContextBonus(int side) =>
    d2_isBuy(side) ? (whaleBias == 1 ? 0.18 : 0.0) : (whaleBias == -1 ? 0.18 : 0.0)

getWhaleScoreBonus(int side) =>
    d2_isBuy(side) ? ((whaleBullEvent ? 0.40 : 0.0) + (whaleAbsorptionBuy ? 0.35 : 0.0)) : ((whaleBearEvent ? 0.40 : 0.0) + (whaleAbsorptionSell ? 0.35 : 0.0))

getFalseBreakPenalty(int side) =>
    d2_isBuy(side) ? (falseBreakoutRiskBuy ? -0.60 : 0.0) : (falseBreakoutRiskSell ? -0.60 : 0.0)

getFalseBreakContextPenalty(int side) =>
    d2_isBuy(side) ? (falseBreakoutRiskBuy ? -0.30 : 0.0) : (falseBreakoutRiskSell ? -0.30 : 0.0)

//======================================================
// STRICT TC / LS / TRAP FILTERS
//======================================================
bool tcBuyStrictCore =
     trendContinuationBuy and
     trendUpBasic and
     continuationScore >= TC_MIN_CONT_SCORE and
     emaDistAtr <= TC_MAX_EMA_DIST_ATR and
     barEff >= 0.50 and
     not microRangeActive and
     not coinVeryCrowdedMarket and
     not falseBreakoutRiskBuy and
     marketMemoryBias >= 0 and
     htfStructureBias >= 0

bool tcSellStrictCore =
     trendContinuationSell and
     trendDownBasic and
     continuationScore >= TC_MIN_CONT_SCORE and
     emaDistAtr <= TC_MAX_EMA_DIST_ATR and
     barEff >= 0.50 and
     not microRangeActive and
     not coinVeryCrowdedMarket and
     not falseBreakoutRiskSell and
     marketMemoryBias <= 0 and
     htfStructureBias <= 0

bool tcBuyStrict  = tcBuyStrictCore and (na(lastTcBuyBar) or bar_index - lastTcBuyBar > TC_COOLDOWN_BARS)
bool tcSellStrict = tcSellStrictCore and (na(lastTcSellBar) or bar_index - lastTcSellBar > TC_COOLDOWN_BARS)

if tcBuyStrict
    lastTcBuyBar := bar_index
if tcSellStrict
    lastTcSellBar := bar_index

bool lsBuyStrictCore =
     bullSweepLiq and
     safeDiv(lowerWick, math.max(bodyBase, syminfo.mintick), 0.0) >= LS_MIN_WICK_BODY and
     safeAtrNorm(close - low, atrValue) >= LS_MIN_SWEEP_ATR and
     (nearSupport or nearCurrentSessionLow or nearRelayLow) and
     (strongLiquidityBuy or trapBuy or fakeoutScore > 0.25)

bool lsSellStrictCore =
     bearSweepLiq and
     safeDiv(upperWick, math.max(bodyBase, syminfo.mintick), 0.0) >= LS_MIN_WICK_BODY and
     safeAtrNorm(high - close, atrValue) >= LS_MIN_SWEEP_ATR and
     (nearResistance or nearCurrentSessionHigh or nearRelayHigh) and
     (strongLiquiditySell or trapSell or fakeoutScore > 0.25)

bool lsBuyStrict  = lsBuyStrictCore and (na(lastLsBuyBar) or bar_index - lastLsBuyBar > LS_COOLDOWN_BARS)
bool lsSellStrict = lsSellStrictCore and (na(lastLsSellBar) or bar_index - lastLsSellBar > LS_COOLDOWN_BARS)

if lsBuyStrict
    lastLsBuyBar := bar_index
if lsSellStrict
    lastLsSellBar := bar_index

bool bullTrapEarly = bullTrap or (lsBuyStrict and close > open and lowerWick >= bodyBase * 1.20)
bool bearTrapEarly = bearTrap or (lsSellStrict and close < open and upperWick >= bodyBase * 1.20)

bool bullTrapStrict = (bullTrapConfirm or bullTrap) and close > emaFast and not falseBreakoutRiskBuy and (na(lastTrapBuyBar) or bar_index - lastTrapBuyBar > TRAP_COOLDOWN_BARS)
bool bearTrapStrict = (bearTrapConfirm or bearTrap) and close < emaFast and not falseBreakoutRiskSell and (na(lastTrapSellBar) or bar_index - lastTrapSellBar > TRAP_COOLDOWN_BARS)

// Volume decay confirmation — sweep bar high vol, retrace bar lower vol
// sweep-bar = [1] since trap forms on previous bar and confirms current bar
// sweepVolOk and retraceVol are direction-agnostic (identical for buy and sell)
bool sweepVolOk = nz(volume[1], 0) > volSma20 * VOL_CONFIRM_MULT
bool retraceVol = volume < nz(volume[1], volume) * 0.80
bool bullTrapVolumeConfirm = sweepVolOk and retraceVol
bool bearTrapVolumeConfirm = sweepVolOk and retraceVol

// StrictPlus = volume-confirmed trap — stronger signal used in scoring bonus
bool bullTrapStrictPlus = bullTrapStrict and bullTrapVolumeConfirm
bool bearTrapStrictPlus = bearTrapStrict and bearTrapVolumeConfirm

if bullTrapStrict
    lastTrapBuyBar := bar_index
if bearTrapStrict
    lastTrapSellBar := bar_index

//======================================================
// STRONG REJECTION CORE
//======================================================
bool strongSupportRejection =
     (nearSupport or nearCoarseSupport or nearCurrentSessionLow or nearRelayLow) and
     close > open and
     safeDiv(lowerWick, math.max(bodyBase, syminfo.mintick), 0.0) >= 0.70 and
     close > low + barRange * 0.50 and
     (
         softSupportReject or
         localFlushBuy or
         hiddenLiquidityBuy or
         strongLiquidityBuy or
         bullTrapEarly or
         bullTrapConfirm or
         microClusterLow
     )

bool strongResistanceRejection =
     (nearResistance or nearCoarseResistance or nearCurrentSessionHigh or nearRelayHigh) and
     close < open and
     safeDiv(upperWick, math.max(bodyBase, syminfo.mintick), 0.0) >= 0.70 and
     close < high - barRange * 0.50 and
     (
         softResistanceReject or
         localBlowoffSell or
         hiddenLiquiditySell or
         strongLiquiditySell or
         bearTrapEarly or
         bearTrapConfirm or
         microClusterHigh
     )

//======================================================
// RAW SETUP FAMILY DETECTION
//======================================================
bool bullBreakoutAllowedRaw =
     (bullBreakout or smartBreakoutReadyBuy or buyBreakAntEarly) and
     (coinProfileCode == COIN_PROFILE_TREND or coinProfileCode == COIN_PROFILE_EXPLOSIVE or not coinCrowdedMarket) and
     (smartBreakoutReadyBuy or buyBreakAntEarly or (not falseBreakoutRiskBuy and volExpScore >= VOL_EXP_SCORE_THRESHOLD * 0.75))

bool bearBreakdownAllowedRaw =
     (bearBreakdown or smartBreakdownReadySell or sellBreakAntEarly) and
     (coinProfileCode == COIN_PROFILE_TREND or coinProfileCode == COIN_PROFILE_EXPLOSIVE or not coinCrowdedMarket) and
     (smartBreakdownReadySell or sellBreakAntEarly or (not falseBreakoutRiskSell and volExpScore >= VOL_EXP_SCORE_THRESHOLD * 0.75))

bool bullReversalAllowedRaw = not coinVeryCrowdedMarket or coinProfileCode == COIN_PROFILE_WICKY or coinProfileCode == COIN_PROFILE_CHOPPY
bool bearReversalAllowedRaw = not coinVeryCrowdedMarket or coinProfileCode == COIN_PROFILE_WICKY or coinProfileCode == COIN_PROFILE_CHOPPY

// VWAP Reversion — bullish rejection nära VWAP under session
bool vwapReversionBuy =
     coreReady and vwapRejBull and priceBelowVwap and
     (nearSupport or nearCurrentSessionLow or nearRelayLow) and
     vwapDistAtr <= 0.40 and
     not coinVeryCrowdedMarket and
     not trendDownBasic

bool vwapReversionSell =
     coreReady and vwapRejBear and priceAboveVwap and
     (nearResistance or nearCurrentSessionHigh or nearRelayHigh) and
     vwapDistAtr <= 0.40 and
     not coinVeryCrowdedMarket and
     not trendUpBasic

// Session Open Momentum — stark candle på London/NY open
bool sessionOpenBar = newLondonSession or newNySession
var int sessionStartBarIdx = 0
if sessionOpenBar
    sessionStartBarIdx := bar_index

bool openMomentumBuy =
     coreReady and
     (sessionCode == SESSION_LONDON or sessionCode == SESSION_NY_OPEN) and
     bar_index - sessionStartBarIdx <= 2 and
     close > open and
     barRange > avgRange20 * 1.20 and
     volume > volSma20 * 1.50 and
     close > prevSessionHighRef and
     trendUpBasic

bool openMomentumSell =
     coreReady and
     (sessionCode == SESSION_LONDON or sessionCode == SESSION_NY_OPEN) and
     bar_index - sessionStartBarIdx <= 2 and
     close < open and
     barRange > avgRange20 * 1.20 and
     volume > volSma20 * 1.50 and
     close < prevSessionLowRef and
     trendDownBasic

// Failed Breakout Reversal — breakout misslyckades, stark reversal signal
bool failedBreakoutSell =
     coreReady and falseBreakoutRiskBuy and
     close < resistanceBottom and
     close < open and
     volume > volSma20 * 1.10 and
     not trendUpBasic and
     barRange > avgRange20 * 0.90

bool failedBreakoutBuy =
     coreReady and falseBreakoutRiskSell and
     close > supportTop and
     close > open and
     volume > volSma20 * 1.10 and
     not trendDownBasic and
     barRange > avgRange20 * 0.90

int buySetupTypeRaw = SETUP_NONE

if regimeCode == REGIME_TREND_UP or regimeCode == REGIME_EXPANSION
    // Trend/expansion: prioritera continuation och breakout
    if openMomentumBuy
        buySetupTypeRaw := SETUP_OPEN_MOMENTUM
    else if bullBos and trendUpBasic and htfStructureBias == 1
        buySetupTypeRaw := SETUP_CONTINUATION
    else if tcBuyStrict
        buySetupTypeRaw := SETUP_CONTINUATION
    else if bullBreakoutAllowedRaw or smartBreakoutReadyBuy or buyBreakAntEarly or sessionBreakoutPressureBuyRef
        buySetupTypeRaw := SETUP_BREAKOUT_BUILD
    else if bullTrapStrict or bullTrapEarly or bullTrap or trapBuy
        buySetupTypeRaw := SETUP_LIQUIDITY_TRAP
    else if lsBuyStrict or bullSweep or bullSweepLiq or sessionReclaimBuyRef
        buySetupTypeRaw := SETUP_SWEEP
    else if strongSupportRejection or softSupportReject or localFlushBuy or microClusterLow or hiddenLiquidityBuy
        buySetupTypeRaw := SETUP_REVERSAL
    else if softBullReclaim or bullRetest or bullBounce or sessionRejectBuyRef
        buySetupTypeRaw := SETUP_RECLAIM

else if regimeCode == REGIME_RANGE or regimeCode == REGIME_COMPRESSION
    // Range/compression: prioritera reversals och sweeps, undvik continuation
    if bullChoch and not trendDownBasic
        buySetupTypeRaw := SETUP_REVERSAL
    else if fvgRetestBuy
        buySetupTypeRaw := SETUP_REVERSAL
    else if vwapReversionBuy
        buySetupTypeRaw := SETUP_VWAP_REVERSION
    else if failedBreakoutBuy
        buySetupTypeRaw := SETUP_FAILED_BREAKOUT
    else if strongSupportRejection or softSupportReject or localFlushBuy or microClusterLow or hiddenLiquidityBuy or vwapRejBull
        buySetupTypeRaw := SETUP_REVERSAL
    else if lsBuyStrict or bullSweep or bullSweepLiq or sessionReclaimBuyRef
        buySetupTypeRaw := SETUP_SWEEP
    else if bullTrapStrict or bullTrapEarly or bullTrap or trapBuy
        buySetupTypeRaw := SETUP_LIQUIDITY_TRAP
    else if softBullReclaim or bullRetest or bullBounce or sessionRejectBuyRef
        buySetupTypeRaw := SETUP_RECLAIM
    else if tcBuyStrict
        buySetupTypeRaw := SETUP_CONTINUATION
    else if smartBreakoutReadyBuy
        buySetupTypeRaw := SETUP_BREAKOUT_BUILD

else if regimeCode == REGIME_CHAOTIC
    // Chaotic: bara de starkaste signalerna — trap, sweep, strict reversal
    if bullTrapStrict or trapBuy
        buySetupTypeRaw := SETUP_LIQUIDITY_TRAP
    else if lsBuyStrict
        buySetupTypeRaw := SETUP_SWEEP
    else if strongSupportRejection or (eliteLiquidityBuy and nearSupport)
        buySetupTypeRaw := SETUP_REVERSAL

else
    // Neutral/okänt regime — ursprunglig ordning
    if tcBuyStrict
        buySetupTypeRaw := SETUP_CONTINUATION
    else if bullTrapStrict or bullTrapEarly or bullTrap or trapBuy
        buySetupTypeRaw := SETUP_LIQUIDITY_TRAP
    else if strongSupportRejection or softSupportReject or localFlushBuy or microClusterLow or hiddenLiquidityBuy
        buySetupTypeRaw := SETUP_REVERSAL
    else if lsBuyStrict or bullSweep or bullSweepLiq or sessionReclaimBuyRef
        buySetupTypeRaw := SETUP_SWEEP
    else if bullBreakoutAllowedRaw or smartBreakoutReadyBuy or buyBreakAntEarly or sessionBreakoutPressureBuyRef
        buySetupTypeRaw := SETUP_BREAKOUT_BUILD
    else if softBullReclaim or bullRetest or bullBounce or sessionRejectBuyRef
        buySetupTypeRaw := SETUP_RECLAIM

int sellSetupTypeRaw = SETUP_NONE

if regimeCode == REGIME_TREND_DOWN or regimeCode == REGIME_EXPANSION
    // Trend/expansion: prioritera continuation och breakout
    if openMomentumSell
        sellSetupTypeRaw := SETUP_OPEN_MOMENTUM
    else if tcSellStrict
        sellSetupTypeRaw := SETUP_CONTINUATION
    else if bearBreakdownAllowedRaw or smartBreakdownReadySell or sellBreakAntEarly or sessionBreakoutPressureSellRef
        sellSetupTypeRaw := SETUP_BREAKOUT_BUILD
    else if bearTrapStrict or bearTrapEarly or bearTrap or trapSell
        sellSetupTypeRaw := SETUP_LIQUIDITY_TRAP
    else if lsSellStrict or bearSweep or bearSweepLiq or sessionReclaimSellRef
        sellSetupTypeRaw := SETUP_SWEEP
    else if strongResistanceRejection or softResistanceReject or localBlowoffSell or microClusterHigh or hiddenLiquiditySell
        sellSetupTypeRaw := SETUP_REVERSAL
    else if softBearReclaim or bearRetest or bearReject or sessionRejectSellRef
        sellSetupTypeRaw := SETUP_RECLAIM

else if regimeCode == REGIME_RANGE or regimeCode == REGIME_COMPRESSION
    // Range/compression: prioritera reversals och sweeps
    if fvgRetestSell
        sellSetupTypeRaw := SETUP_REVERSAL
    else if vwapReversionSell
        sellSetupTypeRaw := SETUP_VWAP_REVERSION
    else if failedBreakoutSell
        sellSetupTypeRaw := SETUP_FAILED_BREAKOUT
    else if strongResistanceRejection or softResistanceReject or localBlowoffSell or microClusterHigh or hiddenLiquiditySell or vwapRejBear
        sellSetupTypeRaw := SETUP_REVERSAL
    else if lsSellStrict or bearSweep or bearSweepLiq or sessionReclaimSellRef
        sellSetupTypeRaw := SETUP_SWEEP
    else if bearTrapStrict or bearTrapEarly or bearTrap or trapSell
        sellSetupTypeRaw := SETUP_LIQUIDITY_TRAP
    else if softBearReclaim or bearRetest or bearReject or sessionRejectSellRef
        sellSetupTypeRaw := SETUP_RECLAIM
    else if tcSellStrict
        sellSetupTypeRaw := SETUP_CONTINUATION
    else if smartBreakdownReadySell
        sellSetupTypeRaw := SETUP_BREAKOUT_BUILD

else if regimeCode == REGIME_CHAOTIC
    // Chaotic: bara de starkaste signalerna
    if bearTrapStrict or trapSell
        sellSetupTypeRaw := SETUP_LIQUIDITY_TRAP
    else if lsSellStrict
        sellSetupTypeRaw := SETUP_SWEEP
    else if strongResistanceRejection or (eliteLiquiditySell and nearResistance)
        sellSetupTypeRaw := SETUP_REVERSAL

else
    // Neutral/okänt regime — ursprunglig ordning
    if tcSellStrict
        sellSetupTypeRaw := SETUP_CONTINUATION
    else if bearTrapStrict or bearTrapEarly or bearTrap or trapSell
        sellSetupTypeRaw := SETUP_LIQUIDITY_TRAP
    else if strongResistanceRejection or softResistanceReject or localBlowoffSell or microClusterHigh or hiddenLiquiditySell
        sellSetupTypeRaw := SETUP_REVERSAL
    else if lsSellStrict or bearSweep or bearSweepLiq or sessionReclaimSellRef
        sellSetupTypeRaw := SETUP_SWEEP
    else if bearBreakdownAllowedRaw or smartBreakdownReadySell or sellBreakAntEarly or sessionBreakoutPressureSellRef
        sellSetupTypeRaw := SETUP_BREAKOUT_BUILD
    else if softBearReclaim or bearRetest or bearReject or sessionRejectSellRef
        sellSetupTypeRaw := SETUP_RECLAIM

int buyIntentRaw = INTENT_NONE
if buySetupTypeRaw == SETUP_CONTINUATION
    buyIntentRaw := INTENT_CONTINUATION
else if buySetupTypeRaw == SETUP_BREAKOUT_BUILD
    buyIntentRaw := regimeCode == REGIME_EXPANSION ? INTENT_EXPANSION : INTENT_CONTINUATION
else if buySetupTypeRaw == SETUP_LIQUIDITY_TRAP or buySetupTypeRaw == SETUP_SWEEP
    buyIntentRaw := INTENT_LIQUIDITY
else if buySetupTypeRaw == SETUP_RECLAIM
    buyIntentRaw := regimeCode == REGIME_TREND_UP ? INTENT_CONTINUATION : INTENT_REVERSAL
else if buySetupTypeRaw == SETUP_REVERSAL
    buyIntentRaw := regimeCode == REGIME_RANGE ? INTENT_REVERSAL : INTENT_SCALP
else if buySetupTypeRaw == SETUP_VWAP_REVERSION
    buyIntentRaw := INTENT_REVERSAL
else if buySetupTypeRaw == SETUP_OPEN_MOMENTUM
    buyIntentRaw := INTENT_CONTINUATION
else if buySetupTypeRaw == SETUP_FAILED_BREAKOUT
    buyIntentRaw := INTENT_REVERSAL
else
    buyIntentRaw := INTENT_NONE

int sellIntentRaw = INTENT_NONE
if sellSetupTypeRaw == SETUP_CONTINUATION
    sellIntentRaw := INTENT_CONTINUATION
else if sellSetupTypeRaw == SETUP_BREAKOUT_BUILD
    sellIntentRaw := regimeCode == REGIME_EXPANSION ? INTENT_EXPANSION : INTENT_CONTINUATION
else if sellSetupTypeRaw == SETUP_LIQUIDITY_TRAP or sellSetupTypeRaw == SETUP_SWEEP
    sellIntentRaw := INTENT_LIQUIDITY
else if sellSetupTypeRaw == SETUP_RECLAIM
    sellIntentRaw := regimeCode == REGIME_TREND_DOWN ? INTENT_CONTINUATION : INTENT_REVERSAL
else if sellSetupTypeRaw == SETUP_REVERSAL
    sellIntentRaw := regimeCode == REGIME_RANGE ? INTENT_REVERSAL : INTENT_SCALP
else if sellSetupTypeRaw == SETUP_VWAP_REVERSION
    sellIntentRaw := INTENT_REVERSAL
else if sellSetupTypeRaw == SETUP_OPEN_MOMENTUM
    sellIntentRaw := INTENT_CONTINUATION
else if sellSetupTypeRaw == SETUP_FAILED_BREAKOUT
    sellIntentRaw := INTENT_REVERSAL
else
    sellIntentRaw := INTENT_NONE

//======================================================
// QUALITY RECLAIM FLAGS
//======================================================
bool buyReclaimHighQuality =
     buySetupTypeRaw == SETUP_RECLAIM and
     nearSupport and
     (
         sessionRejectBuyRef or
         strongLiquidityBuy or
         hiddenLiquidityBuy or
         strongSupportRejection or
         bullTrapEarly or
         bullTrapStrict
     )

bool sellReclaimHighQuality =
     sellSetupTypeRaw == SETUP_RECLAIM and
     nearResistance and
     (
         sessionRejectSellRef or
         strongLiquiditySell or
         hiddenLiquiditySell or
         strongResistanceRejection or
         bearTrapEarly or
         bearTrapStrict
     )

//======================================================
// ALIGNMENT / LOCATION EFFICIENCY
//======================================================
float buyAlignmentScore = 0.0
buyAlignmentScore += trendUpBasic ? 0.65 : 0.0
buyAlignmentScore += marketMemoryBias == 1 ? 0.65 : 0.0
buyAlignmentScore += htfStructureBias == 1 ? 0.60 : htfStructureBias == -1 ? -0.30 : 0.0
buyAlignmentScore += sessionBiasScore > 0.0 ? math.min(sessionBiasScore, 1.0) * 0.55 : -math.min(math.abs(sessionBiasScore), 1.0) * 0.45
buyAlignmentScore += liquidityPathBias == -1 ? 0.35 : liquidityPathBias == 1 ? -0.22 : 0.0
buyAlignmentScore += whaleBias == 1 ? 0.18 : 0.0
buyAlignmentScore += priceAboveVwap ? 0.20 : priceBelowVwap ? -0.10 : 0.0
buyAlignmentScore += buyIntentRaw == INTENT_LIQUIDITY and preSweepBias == -1 ? 0.24 : 0.0
buyAlignmentScore += buyIntentRaw == INTENT_CONTINUATION and regimeCode == REGIME_TREND_UP ? 0.24 : 0.0
buyAlignmentScore += buyIntentRaw == INTENT_EXPANSION and regimeCode == REGIME_EXPANSION ? 0.24 : 0.0

float sellAlignmentScore = 0.0
sellAlignmentScore += trendDownBasic ? 0.65 : 0.0
sellAlignmentScore += marketMemoryBias == -1 ? 0.65 : 0.0
sellAlignmentScore += htfStructureBias == -1 ? 0.60 : htfStructureBias == 1 ? -0.30 : 0.0
sellAlignmentScore += sessionBiasScore < 0.0 ? math.min(math.abs(sessionBiasScore), 1.0) * 0.55 : -math.min(math.abs(sessionBiasScore), 1.0) * 0.45
sellAlignmentScore += liquidityPathBias == 1 ? 0.35 : liquidityPathBias == -1 ? -0.22 : 0.0
sellAlignmentScore += whaleBias == -1 ? 0.18 : 0.0
sellAlignmentScore += priceBelowVwap ? 0.20 : priceAboveVwap ? -0.10 : 0.0
sellAlignmentScore += sellIntentRaw == INTENT_LIQUIDITY and preSweepBias == 1 ? 0.24 : 0.0
sellAlignmentScore += sellIntentRaw == INTENT_CONTINUATION and regimeCode == REGIME_TREND_DOWN ? 0.24 : 0.0
sellAlignmentScore += sellIntentRaw == INTENT_EXPANSION and regimeCode == REGIME_EXPANSION ? 0.24 : 0.0

float buyLocationEfficiency = 0.0
buyLocationEfficiency += nearSupport ? 1.00 : 0.0
buyLocationEfficiency += nearCurrentSessionLow ? 0.70 : 0.0
buyLocationEfficiency += nearPrevSessionLow ? 0.45 : 0.0
buyLocationEfficiency += nearRelayLow ? 0.55 : 0.0
buyLocationEfficiency += nearTrueLowerPool ? 0.70 : 0.0
buyLocationEfficiency += supportZoneQuality >= 2.8 ? 0.55 : supportZoneQuality >= 1.6 ? 0.20 : 0.0
buyLocationEfficiency += close <= emaFast + atrValue * 0.35 ? 0.25 : -0.10
buyLocationEfficiency += vwapRejBull ? 0.35 : 0.0
buyLocationEfficiency += nearVwap and priceBelowVwap ? 0.18 : 0.0
buyLocationEfficiency += longExhaustion ? -0.65 : (bullRunBars >= 5 ? -0.35 : 0.0)
buyLocationEfficiency += chaseBuyOk ? 0.16 : -0.10

float sellLocationEfficiency = 0.0
sellLocationEfficiency += nearResistance ? 1.00 : 0.0
sellLocationEfficiency += nearCurrentSessionHigh ? 0.70 : 0.0
sellLocationEfficiency += nearPrevSessionHigh ? 0.45 : 0.0
sellLocationEfficiency += nearRelayHigh ? 0.55 : 0.0
sellLocationEfficiency += nearTrueUpperPool ? 0.70 : 0.0
sellLocationEfficiency += resistanceZoneQuality >= 2.8 ? 0.55 : resistanceZoneQuality >= 1.6 ? 0.20 : 0.0
// Penalty when price has already fallen >0.35 ATR below emaFast (chasing the move).
// Bonus when price is near or above emaFast — optimal sell location.
sellLocationEfficiency += close >= emaFast - atrValue * 0.35 ? 0.25 : -0.10
sellLocationEfficiency += vwapRejBear ? 0.35 : 0.0
sellLocationEfficiency += nearVwap and priceAboveVwap ? 0.18 : 0.0
sellLocationEfficiency += shortExhaustion ? -0.65 : (bearRunBars >= 5 ? -0.35 : 0.0)
sellLocationEfficiency += chaseSellOk ? 0.16 : -0.10

//======================================================
// INSTITUTIONAL REJECTION CLASS
//======================================================
bool buyInstitutionalRejection =
     strongSupportRejection and
     (
         supportZoneQuality >= 1.6 or
         nearCurrentSessionLow or
         nearRelayLow or
         nearTrueLowerPool
     ) and
     close > low + barRange * 0.52 and
     sessionBiasScore > -0.45 and
     htfStructureBias >= 0 and
     not falseBreakoutRiskBuy and
     not (sellBreakAntStrong and sellBreakAntScore > buyBreakAntScore + 0.35)

bool sellInstitutionalRejection =
     strongResistanceRejection and
     (
         resistanceZoneQuality >= 1.6 or
         nearCurrentSessionHigh or
         nearRelayHigh or
         nearTrueUpperPool
     ) and
     close < high - barRange * 0.52 and
     sessionBiasScore < 0.45 and
     htfStructureBias <= 0 and
     not falseBreakoutRiskSell and
     not (buyBreakAntStrong and buyBreakAntScore > sellBreakAntScore + 0.35)

//======================================================
// HARD NO-TRADE LAYER
//======================================================
bool cond1 =
     coinVeryCrowdedMarket and
     not strongSupportRejection and
     not bullTrapStrict and
     buyIntentRaw != INTENT_LIQUIDITY

bool cond2 =
     microRangeActive and
     not volatilityExpansionReady and
     buyIntentRaw != INTENT_LIQUIDITY and
     not buyInstitutionalRejection

bool cond3 =
     falseBreakoutRiskBuy and
     buySetupTypeRaw == SETUP_BREAKOUT_BUILD and
     not smartBreakoutReadyBuy

bool cond4 =
     htfStructureBias == -1 and
     sessionBiasScore <= -0.55 and
     buyIntentRaw != INTENT_LIQUIDITY and
     not buyInstitutionalRejection and
     not strongSupportRejection and
     not fvgRetestBuy and
     not vwapRejBull

bool cond5 =
     longExhaustion and
     buyIntentRaw != INTENT_LIQUIDITY and
     not buyInstitutionalRejection

bool cond6 =
     buyLocationEfficiency < 0.50 and
     not buyInstitutionalRejection

bool cond7 =
     regimeCode == REGIME_CHAOTIC and
     not buyInstitutionalRejection and
     buyIntentRaw != INTENT_LIQUIDITY and
     noiseScoreMarket > 0.54

bool buyNoTrade = cond1 or cond2 or cond3 or cond4 or cond5 or cond6 or cond7

bool sellNoTrade =
     (coinVeryCrowdedMarket and not strongResistanceRejection and not bearTrapStrict and sellIntentRaw != INTENT_LIQUIDITY) or
     (microRangeActive and not volatilityExpansionReady and sellIntentRaw != INTENT_LIQUIDITY and not sellInstitutionalRejection) or
     (falseBreakoutRiskSell and sellSetupTypeRaw == SETUP_BREAKOUT_BUILD and not smartBreakdownReadySell) or
     (htfStructureBias == 1 and sessionBiasScore >= 0.55 and sellIntentRaw != INTENT_LIQUIDITY and not sellInstitutionalRejection and not strongResistanceRejection and not fvgRetestSell and not vwapRejBear) or
     (shortExhaustion and sellIntentRaw != INTENT_LIQUIDITY and not sellInstitutionalRejection) or
     (sellLocationEfficiency < 0.50 and not sellInstitutionalRejection) or
     (regimeCode == REGIME_CHAOTIC and not sellInstitutionalRejection and sellIntentRaw != INTENT_LIQUIDITY and noiseScoreMarket > 0.54)

//======================================================
// DIRECTIONAL PERMISSION LAYER
//======================================================
bool buyDirectionalCore =
     trendUpBasic or
     marketMemoryBias == 1 or
     htfStructureBias == 1 or
     sessionBiasScore >= 0.20

bool sellDirectionalCore =
     trendDownBasic or
     marketMemoryBias == -1 or
     htfStructureBias == -1 or
     sessionBiasScore <= -0.20

bool buyCounterTrendAllowed =
     buyIntentRaw == INTENT_LIQUIDITY or
     buySetupTypeRaw == SETUP_SWEEP or
     buySetupTypeRaw == SETUP_LIQUIDITY_TRAP or
     buySetupTypeRaw == SETUP_REVERSAL or
     buySetupTypeRaw == SETUP_FAILED_BREAKOUT or
     buySetupTypeRaw == SETUP_VWAP_REVERSION or
     (buySetupTypeRaw == SETUP_RECLAIM and buyReclaimHighQuality) or
     buyInstitutionalRejection or
     strongSupportRejection

bool sellCounterTrendAllowed =
     sellIntentRaw == INTENT_LIQUIDITY or
     sellSetupTypeRaw == SETUP_SWEEP or
     sellSetupTypeRaw == SETUP_LIQUIDITY_TRAP or
     sellSetupTypeRaw == SETUP_REVERSAL or
     sellSetupTypeRaw == SETUP_FAILED_BREAKOUT or
     sellSetupTypeRaw == SETUP_VWAP_REVERSION or
     (sellSetupTypeRaw == SETUP_RECLAIM and sellReclaimHighQuality) or
     sellInstitutionalRejection or
     strongResistanceRejection

bool buyBreakoutPermission =
     buySetupTypeRaw != SETUP_BREAKOUT_BUILD or
     (
         (trendUpBasic or marketMemoryBias == 1 or htfStructureBias == 1) and
         sessionBiasScore > -0.05 and
         not falseBreakoutRiskBuy
     )

bool sellBreakoutPermission =
     sellSetupTypeRaw != SETUP_BREAKOUT_BUILD or
     (
         (trendDownBasic or marketMemoryBias == -1 or htfStructureBias == -1) and
         sessionBiasScore < 0.05 and
         not falseBreakoutRiskSell
     )

bool buyContinuationPermission =
     buySetupTypeRaw != SETUP_CONTINUATION or
     (
         regimeCode != REGIME_TREND_DOWN and
         htfStructureBias >= 0 and
         marketMemoryBias >= 0
     )

bool sellContinuationPermission =
     sellSetupTypeRaw != SETUP_CONTINUATION or
     (
         regimeCode != REGIME_TREND_UP and
         htfStructureBias <= 0 and
         marketMemoryBias <= 0
     )

bool buyReversalPermission =
     buySetupTypeRaw != SETUP_REVERSAL or
     (
         bullReversalAllowedRaw and
         not (
             regimeCode == REGIME_TREND_DOWN and
             sessionBiasScore <= -0.60 and
             htfStructureBias == -1 and
             not strongSupportRejection and
             not bullTrapStrict
         )
     )

bool sellReversalPermission =
     sellSetupTypeRaw != SETUP_REVERSAL or
     (
         bearReversalAllowedRaw and
         not (
             regimeCode == REGIME_TREND_UP and
             sessionBiasScore >= 0.60 and
             htfStructureBias == 1 and
             not strongResistanceRejection and
             not bearTrapStrict and
             not fvgRetestSell and
             not vwapRejBear and
             not rsiBearDiv
         )
     )

bool buyPermission =
     buySetupTypeRaw != SETUP_NONE and
     not buyNoTrade and
     (buyDirectionalCore or buyCounterTrendAllowed) and
     buyBreakoutPermission and
     buyContinuationPermission and
     buyReversalPermission and
     not (sessionBiasScore <= -0.80 and buyIntentRaw != INTENT_LIQUIDITY and not strongSupportRejection) and
     not (htfStructureBias == -1 and buySetupTypeRaw == SETUP_BREAKOUT_BUILD and not smartBreakoutReadyBuy) and
     not (regimeCode == REGIME_TREND_DOWN and buySetupTypeRaw == SETUP_CONTINUATION)

bool sellPermission =
     sellSetupTypeRaw != SETUP_NONE and
     not sellNoTrade and
     (sellDirectionalCore or sellCounterTrendAllowed) and
     sellBreakoutPermission and
     sellContinuationPermission and
     sellReversalPermission and
     not (sessionBiasScore >= 0.80 and sellIntentRaw != INTENT_LIQUIDITY and not strongResistanceRejection) and
     not (htfStructureBias == 1 and sellSetupTypeRaw == SETUP_BREAKOUT_BUILD and not smartBreakdownReadySell) and
     not (regimeCode == REGIME_TREND_UP and sellSetupTypeRaw == SETUP_CONTINUATION)

bool bullBreakoutAllowed = buyPermission and bullBreakoutAllowedRaw
bool bearBreakdownAllowed = sellPermission and bearBreakdownAllowedRaw
bool bullReversalAllowed = buyPermission and bullReversalAllowedRaw
bool bearReversalAllowed = sellPermission and bearReversalAllowedRaw

//======================================================
// RAW LONG / SHORT MASTER SETUPS
//======================================================
bool buyMicroConfirm  = low  > nz(low[1], low)   or (close > nz(close[1], close) and close > open) or lowerWick >= bodyBase * 1.20
bool sellMicroConfirm = high < nz(high[1], high) or (close < nz(close[1], close) and close < open) or upperWick >= bodyBase * 1.20

bool rawLongSetup =
     buyPermission and
     (
         bullTrap or bullTrapStrict or bullSweep or lsBuyStrict or tcBuyStrict or sessionReclaimBuyRef or sessionRejectBuyRef or
         strongSupportRejection or buyInstitutionalRejection or
         (bullBounce and bullReversalAllowed and buyMicroConfirm) or
         (softBullReclaim and bullReversalAllowed and buyMicroConfirm) or
         bullRetest or bullBreakoutAllowed or smartBreakoutReadyBuy or buyBreakAntEarly or sessionBreakoutPressureBuyRef or
         (softSupportReject and bullReversalAllowed and buyMicroConfirm) or
         (localFlushBuy and bullReversalAllowed) or
         microClusterLow or hiddenLiquidityBuy or strongLiquidityBuy or trapBuy or
         (nearSupport and close > open and bullReversalAllowed and bodyOk and buyLocationEfficiency >= 0.65 and buyMicroConfirm)
     )

bool rawShortSetup =
     sellPermission and
     (
         bearTrap or bearTrapStrict or bearSweep or lsSellStrict or tcSellStrict or sessionReclaimSellRef or sessionRejectSellRef or
         strongResistanceRejection or sellInstitutionalRejection or
         (bearReject and bearReversalAllowed and sellMicroConfirm) or
         (softBearReclaim and bearReversalAllowed and sellMicroConfirm) or
         bearRetest or bearBreakdownAllowed or smartBreakdownReadySell or sellBreakAntEarly or sessionBreakoutPressureSellRef or
         (softResistanceReject and bearReversalAllowed and sellMicroConfirm) or
         (localBlowoffSell and bearReversalAllowed) or
         microClusterHigh or hiddenLiquiditySell or strongLiquiditySell or trapSell or
         (nearResistance and close < open and bearReversalAllowed and bodyOk and sellLocationEfficiency >= 0.65 and sellMicroConfirm)
     )

//======================================================
// FINAL SETUP TYPE / INTENT
//======================================================
int buySetupType  = buyPermission and rawLongSetup ? buySetupTypeRaw : SETUP_NONE
int sellSetupType = sellPermission and rawShortSetup ? sellSetupTypeRaw : SETUP_NONE

//======================================================
// MULTI-BAR RECLAIM CONFIRMATION
//======================================================
var int reclaimBuyBars  = 0
var int reclaimSellBars = 0

if barstate.isconfirmed
    if buySetupType == SETUP_RECLAIM
        reclaimBuyBars := (close > supportTop and close > open) ? reclaimBuyBars + 1 : 0
    else
        reclaimBuyBars := 0

    if sellSetupType == SETUP_RECLAIM
        reclaimSellBars := (close < resistanceBottom and close < open) ? reclaimSellBars + 1 : 0
    else
        reclaimSellBars := 0

bool reclaimBuyConfirmed  = reclaimBuyBars  >= 2
bool reclaimSellConfirmed = reclaimSellBars >= 2

//======================================================
// MANDATORY CORE CONDITIONS PER SETUP TYPE
//======================================================
bool buySetupCoreValid =
     buySetupType == SETUP_NONE ? false :
     buySetupType == SETUP_LIQUIDITY_TRAP ?
         (bullTrapStrict or trapBuy or (volumeSpike and strongLiquidityBuy)) :
     buySetupType == SETUP_CONTINUATION ?
         (trendUpBasic and htfStructureBias >= 0 and
          (tcBuyStrict or continuationScore > 0.45) and
          bullMacd and
          noiseScoreMarket < 0.54 and
          not rsiOverbought and
          not longExhaustion and
          not pullbackTooDeepBuy) :
     buySetupType == SETUP_REVERSAL ?
         (strongSupportRejection or bullTrapStrict or buyInstitutionalRejection or
          (lsBuyStrict and nearSupport) or vwapRejBull or rsiBullDiv or fvgRetestBuy) :
     buySetupType == SETUP_SWEEP ?
         (lsBuyStrict or bullSweep or (bullSweepLiq and nearSupport)) and
         not (regimeCode == REGIME_TREND_DOWN and htfStructureBias == -1) :
     buySetupType == SETUP_RECLAIM ?
         ((nearSupport or nearCurrentSessionLow or nearRelayLow) and reclaimBuyConfirmed) :
     buySetupType == SETUP_BREAKOUT_BUILD ?
         (smartBreakoutReadyBuy and not falseBreakoutRiskBuy) :
     buySetupType == SETUP_VWAP_REVERSION ?
         (vwapRejBull and priceBelowVwap and (nearSupport or nearCurrentSessionLow) and vwapDistAtr <= 0.40) :
     buySetupType == SETUP_OPEN_MOMENTUM ?
         (openMomentumBuy) :
     buySetupType == SETUP_FAILED_BREAKOUT ?
         (failedBreakoutBuy and barstate.isconfirmed) :
     true

bool sellSetupCoreValid =
     sellSetupType == SETUP_NONE ? false :
     sellSetupType == SETUP_LIQUIDITY_TRAP ?
         (bearTrapStrict or trapSell or (volumeSpike and strongLiquiditySell)) :
     sellSetupType == SETUP_CONTINUATION ?
         (trendDownBasic and htfStructureBias <= 0 and
          (tcSellStrict or continuationScore > 0.45) and
          bearMacd and
          noiseScoreMarket < 0.54 and
          not rsiOversold and
          not shortExhaustion and
          not pullbackTooDeepSell) :
     sellSetupType == SETUP_REVERSAL ?
         (strongResistanceRejection or bearTrapStrict or sellInstitutionalRejection or
          (lsSellStrict and nearResistance) or vwapRejBear or rsiBearDiv or fvgRetestSell) :
     sellSetupType == SETUP_SWEEP ?
         (lsSellStrict or bearSweep or (bearSweepLiq and nearResistance)) and
         not (regimeCode == REGIME_TREND_UP and htfStructureBias == 1) :
     sellSetupType == SETUP_RECLAIM ?
         ((nearResistance or nearCurrentSessionHigh or nearRelayHigh) and reclaimSellConfirmed) :
     sellSetupType == SETUP_BREAKOUT_BUILD ?
         (smartBreakdownReadySell and not falseBreakoutRiskSell) :
     sellSetupType == SETUP_VWAP_REVERSION ?
         (vwapRejBear and priceAboveVwap and (nearResistance or nearCurrentSessionHigh) and vwapDistAtr <= 0.40) :
     sellSetupType == SETUP_OPEN_MOMENTUM ?
         (openMomentumSell) :
     sellSetupType == SETUP_FAILED_BREAKOUT ?
         (failedBreakoutSell and barstate.isconfirmed) :
     true

buySetupType  := buySetupCoreValid  ? buySetupType  : SETUP_NONE
sellSetupType := sellSetupCoreValid ? sellSetupType : SETUP_NONE

int buyIntent  = buySetupType == SETUP_NONE ? INTENT_NONE : buyIntentRaw
int sellIntent = sellSetupType == SETUP_NONE ? INTENT_NONE : sellIntentRaw

//======================================================
// PRELIMINARY ANCHORS / ROUGH SPACE
//======================================================
float roughBuySpaceRef  = minAbove(close, resistanceTop, resistanceBottom, currentSessionHighRef, prevSessionHighRef, lastPivotHigh, trueLiquidityHigh, high[1], high[2])
float roughSellSpaceRef = maxBelow(close, supportTop, supportBottom, currentSessionLowRef, prevSessionLowRef, lastPivotLow, trueLiquidityLow, low[1], low[2])

float roughBuySpaceAtr  = na(roughBuySpaceRef) ? 99.0 : safeAtrNorm(roughBuySpaceRef - close, atrValue)
float roughSellSpaceAtr = na(roughSellSpaceRef) ? 99.0 : safeAtrNorm(close - roughSellSpaceRef, atrValue)

bool roughBuySpaceOk  = roughBuySpaceAtr >= (strongSupportRejection ? 0.56 : coinCrowdedMarket ? 1.15 : 0.85)
bool roughSellSpaceOk = roughSellSpaceAtr >= (strongResistanceRejection ? 0.56 : coinCrowdedMarket ? 1.15 : 0.85)

float buyPreSlAnchor  = maxBelow(close, currentSessionLowRef, prevSessionLowRef, supportBottom, supportTop, lastPivotLow, prevPivotLow, trueLiquidityLow, emaSlow)
float sellPreSlAnchor = minAbove(close, currentSessionHighRef, prevSessionHighRef, resistanceBottom, resistanceTop, lastPivotHigh, prevPivotHigh, trueLiquidityHigh, emaSlow)

float buyPreTpAnchor  = minAbove(close, currentSessionHighRef, prevSessionHighRef, resistanceTop, resistanceBottom, lastPivotHigh, trueLiquidityHigh, dayHighPrev, weekHighPrev)
float sellPreTpAnchor = maxBelow(close, currentSessionLowRef, prevSessionLowRef, supportTop, supportBottom, lastPivotLow, trueLiquidityLow, dayLowPrev, weekLowPrev)

bool buyHasPreSlAnchor  = not na(buyPreSlAnchor) or nearSupport or nearCurrentSessionLow or nearRelayLow or buySetupType == SETUP_BREAKOUT_BUILD
bool sellHasPreSlAnchor = not na(sellPreSlAnchor) or nearResistance or nearCurrentSessionHigh or nearRelayHigh or sellSetupType == SETUP_BREAKOUT_BUILD

bool buyHasPreTpAnchor  = not na(buyPreTpAnchor) or buySetupType == SETUP_BREAKOUT_BUILD or buySetupType == SETUP_CONTINUATION
bool sellHasPreTpAnchor = not na(sellPreTpAnchor) or sellSetupType == SETUP_BREAKOUT_BUILD or sellSetupType == SETUP_CONTINUATION

//======================================================
// CONFLUENCE ENGINE
//======================================================
float buyConfluenceScore = 0.0
buyConfluenceScore += nearSupport ? 0.65 : 0.0
buyConfluenceScore += nearCurrentSessionLow ? 0.45 : 0.0
buyConfluenceScore += nearRelayLow ? 0.40 : 0.0
buyConfluenceScore += nearTrueLowerPool ? 0.45 : 0.0
buyConfluenceScore += supportZoneQuality >= 2.8 ? 0.50 : supportZoneQuality >= 1.6 ? 0.20 : 0.0
buyConfluenceScore += marketMemoryBias == 1 ? 0.35 : 0.0
buyConfluenceScore += htfStructureBias == 1 ? 0.42 : 0.0
buyConfluenceScore += preSweepBias == -1 ? 0.22 : 0.0
buyConfluenceScore += liquidityPathBias == -1 ? 0.30 : 0.0
buyConfluenceScore += whaleBias == 1 ? 0.24 : 0.0
buyConfluenceScore += sessionReclaimBuyRef ? 0.28 : 0.0
buyConfluenceScore += sessionBreakoutPressureBuyRef ? 0.22 : 0.0
buyConfluenceScore += strongLiquidityBuy ? 0.26 : 0.0
buyConfluenceScore += bullTrapStrict ? 0.30 : 0.0
buyConfluenceScore += tcBuyStrict ? 0.24 : 0.0
buyConfluenceScore += strongSupportRejection ? 0.42 : 0.0
buyConfluenceScore += buyInstitutionalRejection ? 0.55 : 0.0
buyConfluenceScore += buyReclaimHighQuality ? 0.22 : 0.0
buyConfluenceScore += buyAlignmentScore * 0.22
buyConfluenceScore += math.max(buyLocationEfficiency, 0.0) * 0.18
buyConfluenceScore += falseBreakoutRiskBuy ? -0.65 : 0.0
buyConfluenceScore += coinVeryCrowdedMarket ? -0.28 : 0.0
buyConfluenceScore += buyPermission ? 0.18 : -0.45
buyConfluenceScore += rawLongSetup ? 0.18 : -0.25

float sellConfluenceScore = 0.0
sellConfluenceScore += nearResistance ? 0.65 : 0.0
sellConfluenceScore += nearCurrentSessionHigh ? 0.45 : 0.0
sellConfluenceScore += nearRelayHigh ? 0.40 : 0.0
sellConfluenceScore += nearTrueUpperPool ? 0.45 : 0.0
sellConfluenceScore += resistanceZoneQuality >= 2.8 ? 0.50 : resistanceZoneQuality >= 1.6 ? 0.20 : 0.0
sellConfluenceScore += marketMemoryBias == -1 ? 0.35 : 0.0
sellConfluenceScore += htfStructureBias == -1 ? 0.42 : 0.0
sellConfluenceScore += preSweepBias == 1 ? 0.22 : 0.0
sellConfluenceScore += liquidityPathBias == 1 ? 0.30 : 0.0
sellConfluenceScore += whaleBias == -1 ? 0.24 : 0.0
sellConfluenceScore += sessionReclaimSellRef ? 0.28 : 0.0
sellConfluenceScore += sessionBreakoutPressureSellRef ? 0.22 : 0.0
sellConfluenceScore += strongLiquiditySell ? 0.26 : 0.0
sellConfluenceScore += bearTrapStrict ? 0.30 : 0.0
sellConfluenceScore += tcSellStrict ? 0.24 : 0.0
sellConfluenceScore += strongResistanceRejection ? 0.42 : 0.0
sellConfluenceScore += sellInstitutionalRejection ? 0.55 : 0.0
sellConfluenceScore += sellReclaimHighQuality ? 0.22 : 0.0
sellConfluenceScore += sellAlignmentScore * 0.22
sellConfluenceScore += math.max(sellLocationEfficiency, 0.0) * 0.18
sellConfluenceScore += falseBreakoutRiskSell ? -0.65 : 0.0
sellConfluenceScore += coinVeryCrowdedMarket ? -0.28 : 0.0
sellConfluenceScore += sellPermission ? 0.18 : -0.45
sellConfluenceScore += rawShortSetup ? 0.18 : -0.25


//======================================================
// CONFLUENCE FINALIZATION
//======================================================
buyConfluenceScore  := ENABLE_CONFLUENCE_ENGINE ? ((bodyOk and (lowerWick >= bodyBase * 0.45 or strongSupportRejection or bullTrapStrict or bullSweep or buyInstitutionalRejection) and close >= low + barRange * 0.50) ? buyConfluenceScore : buyConfluenceScore * 0.55) : 0.0
sellConfluenceScore := ENABLE_CONFLUENCE_ENGINE ? ((bodyOk and (upperWick >= bodyBase * 0.45 or strongResistanceRejection or bearTrapStrict or bearSweep or sellInstitutionalRejection) and close <= high - barRange * 0.50) ? sellConfluenceScore : sellConfluenceScore * 0.55) : 0.0

//======================================================
// UNIFIED SYNC CALIBRATION ENGINE
// Makes confluence, structure, liquidity, HTF, regime and setup quality
// speak the same language before scoring and triggering.
//======================================================
float buyEngineAgreement = 0.0
buyEngineAgreement += nearSupport ? 0.55 : 0.0
buyEngineAgreement += nearTrueLowerPool ? 0.40 : 0.0
buyEngineAgreement += htfStructureBias == 1 ? 0.55 : htfStructureBias == -1 ? -0.40 : 0.0
buyEngineAgreement += marketMemoryBias == 1 ? 0.35 : marketMemoryBias == -1 ? -0.22 : 0.0
buyEngineAgreement += trendUpBasic ? 0.28 : trendDownBasic ? -0.22 : 0.0
buyEngineAgreement += liquidityPathBias == -1 ? 0.22 : liquidityPathBias == 1 ? -0.18 : 0.0
buyEngineAgreement += whaleBias == 1 ? 0.20 : whaleBias == -1 ? -0.12 : 0.0
buyEngineAgreement += strongLiquidityBuy ? 0.32 : strongLiquiditySell ? -0.20 : 0.0
buyEngineAgreement += regimeCode == REGIME_TREND_UP ? 0.24 : regimeCode == REGIME_TREND_DOWN ? -0.18 : regimeCode == REGIME_CHAOTIC ? -0.10 : 0.0
buyEngineAgreement += coinProfileCode == COIN_PROFILE_TREND ? 0.18 : coinProfileCode == COIN_PROFILE_CHOPPY ? -0.12 : 0.0
buyEngineAgreement += coinDnaCode == COIN_DNA_TREND_DRIVER ? 0.16 : coinDnaCode == COIN_DNA_LIQUIDITY_HUNTER ? 0.08 : 0.0
buyEngineAgreement := clamp(buyEngineAgreement, -2.50, 2.50)

float sellEngineAgreement = 0.0
sellEngineAgreement += nearResistance ? 0.55 : 0.0
sellEngineAgreement += nearTrueUpperPool ? 0.40 : 0.0
sellEngineAgreement += htfStructureBias == -1 ? 0.55 : htfStructureBias == 1 ? -0.40 : 0.0
sellEngineAgreement += marketMemoryBias == -1 ? 0.35 : marketMemoryBias == 1 ? -0.22 : 0.0
sellEngineAgreement += trendDownBasic ? 0.28 : trendUpBasic ? -0.22 : 0.0
sellEngineAgreement += liquidityPathBias == 1 ? 0.22 : liquidityPathBias == -1 ? -0.18 : 0.0
sellEngineAgreement += whaleBias == -1 ? 0.20 : whaleBias == 1 ? -0.12 : 0.0
sellEngineAgreement += strongLiquiditySell ? 0.32 : strongLiquidityBuy ? -0.20 : 0.0
sellEngineAgreement += regimeCode == REGIME_TREND_DOWN ? 0.24 : regimeCode == REGIME_TREND_UP ? -0.18 : regimeCode == REGIME_CHAOTIC ? -0.10 : 0.0
sellEngineAgreement += coinProfileCode == COIN_PROFILE_TREND ? 0.18 : coinProfileCode == COIN_PROFILE_CHOPPY ? -0.12 : 0.0
sellEngineAgreement += coinDnaCode == COIN_DNA_TREND_DRIVER ? 0.16 : coinDnaCode == COIN_DNA_LIQUIDITY_HUNTER ? 0.08 : 0.0
sellEngineAgreement := clamp(sellEngineAgreement, -2.50, 2.50)

float buyConfluenceReadyThEff  = clamp(CONFLUENCE_READY_TH  - buyEngineAgreement * 0.16, 1.40, 3.20)
float sellConfluenceReadyThEff = clamp(CONFLUENCE_READY_TH  - sellEngineAgreement * 0.16, 1.40, 3.20)

float buyConfluenceStrongThEff  = clamp(CONFLUENCE_STRONG_TH - buyEngineAgreement * 0.20, 2.10, 4.20)
float sellConfluenceStrongThEff = clamp(CONFLUENCE_STRONG_TH - sellEngineAgreement * 0.20, 2.10, 4.20)

bool buyConfluenceReady  = buyConfluenceScore >= buyConfluenceReadyThEff
bool sellConfluenceReady = sellConfluenceScore >= sellConfluenceReadyThEff

bool buyConfluenceStrong  = buyConfluenceScore >= buyConfluenceStrongThEff
bool sellConfluenceStrong = sellConfluenceScore >= sellConfluenceStrongThEff

// REFAKTOR-städning: getConfluenceScoreBonus/getConfluenceContextBonus borttagna
// (oanvända efter att Confluence flyttats till QualityScore).

//======================================================
// PREMIUM QUALITY ENGINE
//======================================================
float buyPremiumQuality = 0.0
buyPremiumQuality += math.max(buyAlignmentScore, 0.0) * 0.42
buyPremiumQuality += math.max(buyLocationEfficiency, 0.0) * 0.38
buyPremiumQuality += buyInstitutionalRejection ? 1.10 : 0.0
buyPremiumQuality += buyReclaimHighQuality ? 0.45 : 0.0
buyPremiumQuality += buyConfluenceStrong ? 0.85 : buyConfluenceReady ? 0.38 : 0.0
buyPremiumQuality += supportZoneQuality >= 2.8 ? 0.42 : supportZoneQuality >= 1.6 ? 0.14 : 0.0
buyPremiumQuality += nearCurrentSessionLow ? 0.22 : 0.0
buyPremiumQuality += nearRelayLow ? 0.18 : 0.0
buyPremiumQuality += nearTrueLowerPool ? 0.22 : 0.0
buyPremiumQuality += sessionReclaimBuyRef ? 0.25 : 0.0
buyPremiumQuality += strongLiquidityBuy ? 0.18 : 0.0
buyPremiumQuality += falseBreakoutRiskBuy ? -0.80 : 0.0
buyPremiumQuality += coinVeryCrowdedMarket ? -0.35 : 0.0
buyPremiumQuality += longExhaustion ? -0.42 : 0.0
buyPremiumQuality += buyPermission ? 0.16 : -0.60

float sellPremiumQuality = 0.0
sellPremiumQuality += math.max(sellAlignmentScore, 0.0) * 0.42
sellPremiumQuality += math.max(sellLocationEfficiency, 0.0) * 0.38
sellPremiumQuality += sellInstitutionalRejection ? 1.10 : 0.0
sellPremiumQuality += sellReclaimHighQuality ? 0.45 : 0.0
sellPremiumQuality += sellConfluenceStrong ? 0.85 : sellConfluenceReady ? 0.38 : 0.0
sellPremiumQuality += resistanceZoneQuality >= 2.8 ? 0.42 : resistanceZoneQuality >= 1.6 ? 0.14 : 0.0
sellPremiumQuality += nearCurrentSessionHigh ? 0.22 : 0.0
sellPremiumQuality += nearRelayHigh ? 0.18 : 0.0
sellPremiumQuality += nearTrueUpperPool ? 0.22 : 0.0
sellPremiumQuality += sessionReclaimSellRef ? 0.25 : 0.0
sellPremiumQuality += strongLiquiditySell ? 0.18 : 0.0
sellPremiumQuality += falseBreakoutRiskSell ? -0.80 : 0.0
sellPremiumQuality += coinVeryCrowdedMarket ? -0.35 : 0.0
sellPremiumQuality += shortExhaustion ? -0.42 : 0.0
sellPremiumQuality += sellPermission ? 0.16 : -0.60

bool buyPremiumReady  = buyPremiumQuality >= 1.25
bool sellPremiumReady = sellPremiumQuality >= 1.25

//======================================================
// HARD INVALIDATION / FAILED STRUCTURE
//======================================================
bool failedBuyBreakout =
     buySetupType == SETUP_BREAKOUT_BUILD and
     (
         (not na(resistanceTop) and close < resistanceTop and upperWick > bodyBase * 0.8) or
         bearTrap or
         bearTrapEarly or
         bearTrapStrict or
         sessionReclaimSellRef
     )

bool failedSellBreakdown =
     sellSetupType == SETUP_BREAKOUT_BUILD and
     (
         (not na(supportTop) and close > supportTop and lowerWick > bodyBase * 0.8) or
         bullTrap or
         bullTrapEarly or
         bullTrapStrict or
         sessionReclaimBuyRef
     )

bool buyHardInvalidation =
     failedBuyBreakout or
     (buySetupType == SETUP_CONTINUATION and trendDownBasic and close < emaFast and sessionBiasScore < -0.35) or
     (buySetupType == SETUP_BREAKOUT_BUILD and falseBreakoutRiskBuy and close < open and upperWick > bodyBase)

bool sellHardInvalidation =
     failedSellBreakdown or
     (sellSetupType == SETUP_CONTINUATION and trendUpBasic and close > emaFast and sessionBiasScore > 0.35) or
     (sellSetupType == SETUP_BREAKOUT_BUILD and falseBreakoutRiskSell and close > open and lowerWick > bodyBase)

//======================================================
// EXECUTION MODE CLASSIFICATION
//======================================================
int executionModeBuyBase = EXEC_MODE_RECLAIM
if tcBuyStrict
    executionModeBuyBase := EXEC_MODE_CONT
else if bullTrapStrict or bullTrapEarly or lsBuyStrict or bullSweep or sessionReclaimBuyRef
    executionModeBuyBase := EXEC_MODE_SWEEP
else if bullBreakoutAllowed or smartBreakoutReadyBuy or buyBreakAntEarly or sessionBreakoutPressureBuyRef
    executionModeBuyBase := EXEC_MODE_BREAKOUT
else if strongSupportRejection or buyInstitutionalRejection or softBullReclaim or bullRetest or bullBounce or sessionRejectBuyRef
    executionModeBuyBase := EXEC_MODE_RECLAIM
else
    executionModeBuyBase := EXEC_MODE_RECLAIM

int executionModeSellBase = EXEC_MODE_RECLAIM
if tcSellStrict
    executionModeSellBase := EXEC_MODE_CONT
else if bearTrapStrict or bearTrapEarly or lsSellStrict or bearSweep or sessionReclaimSellRef
    executionModeSellBase := EXEC_MODE_SWEEP
else if bearBreakdownAllowed or smartBreakdownReadySell or sellBreakAntEarly or sessionBreakoutPressureSellRef
    executionModeSellBase := EXEC_MODE_BREAKOUT
else if strongResistanceRejection or sellInstitutionalRejection or softBearReclaim or bearRetest or bearReject or sessionRejectSellRef
    executionModeSellBase := EXEC_MODE_RECLAIM
else
    executionModeSellBase := EXEC_MODE_RECLAIM

bool strong15mBuySetup = is15m and buyPermission and (
    trendUpBasic or strongSupportRejection or buyReclaimHighQuality or buyInstitutionalRejection
) and (
    bullBounce or
    softBullReclaim or
    bullRetest or
    strongLiquidityBuy or
    softSupportReject or
    localFlushBuy or
    trapBuy or
    tcBuyStrict or
    sessionReclaimBuyRef or
    sessionBreakoutPressureBuyRef or
    smartBreakoutReadyBuy or
    buyBreakAntEarly
)

bool strong15mSellSetup = is15m and sellPermission and (
    trendDownBasic or strongResistanceRejection or sellReclaimHighQuality or sellInstitutionalRejection
) and (
    bearReject or
    softBearReclaim or
    bearRetest or
    softResistanceReject or
    localBlowoffSell or
    strongLiquiditySell or
    trapSell or
    tcSellStrict or
    sessionReclaimSellRef or
    sessionBreakoutPressureSellRef or
    smartBreakdownReadySell or
    sellBreakAntEarly
)

if preSweepBias == -1
    activeEntryBufferBuy := math.max(activeEntryBufferBuy - atrValue * 0.04, atrValue * 0.004)
if preSweepBias == 1
    activeEntryBufferSell := math.max(activeEntryBufferSell - atrValue * 0.04, atrValue * 0.004)

activeEntryBufferBuy  := strong15mBuySetup ? adaptiveEntryBuffer * 0.30 : activeEntryBufferBuy
activeEntryBufferSell := strong15mSellSetup ? adaptiveEntryBuffer * 0.30 : activeEntryBufferSell

//======================================================
// PROBABILITY + SCORE FOUNDATION
//======================================================
var float expansionProbability = 0.0
if barstate.isconfirmed
    float ep = 0.0
    ep += regimeCode == REGIME_EXPANSION ? 2.0 : 0.0
    ep += continuationScore > 0.45 ? 1.2 : 0.0
    ep += (bullVolImpulse or bearVolImpulse) ? 0.8 : 0.0
    ep += volatilityRatio > 1.20 ? 0.7 : 0.0
    ep += fakeoutScore < 0.20 ? 0.5 : 0.0
    ep += noiseScoreMarket < 0.45 ? 0.4 : 0.0
    ep += (sessionCode == SESSION_LONDON or sessionCode == SESSION_NY_LATE or sessionCode == SESSION_NY_OPEN) ? 0.3 : 0.0
    ep += volatilityExpansionReady ? 0.8 : 0.0
    ep += (buyBreakAntStrong or sellBreakAntStrong) ? 0.35 : 0.0
    expansionProbability := ep

//======================================================
// BASE SCORE - BUY
//======================================================
d2_calcBuyScore(int buySetupType_, int buyIntent_, float cbReversalBias_, float cbBreakoutBias_, bool buyPermission_) =>
    float s = 0.0
    s += bullTrap ? 2.2 : 0.0
    s += bullSweep ? 1.8 : 0.0
    s += sessionReclaimBuyRef ? 1.15 : 0.0
    s += sessionRejectBuyRef ? 0.80 : 0.0
    s += sessionBreakoutPressureBuyRef ? 0.90 : 0.0
    s += bullBounce ? (1.5 + cbReversalBias_) : 0.0
    s += softBullReclaim ? (1.2 + cbReversalBias_ * 0.7) : 0.0
    s += bullRetest ? 1.7 : 0.0
    s += bullBreakoutAllowed ? (1.2 + math.max(cbBreakoutBias_, 0.0)) : 0.0
    s += smartBreakoutReadyBuy ? 1.15 : 0.0
    s += buyBreakAntEarly and not smartBreakoutReadyBuy ? 0.55 : 0.0
    s += math.min(buyBreakAntScore * 0.22, 1.0)
    s += softSupportReject ? (1.15 + cbReversalBias_ * 0.6) : 0.0
    s += localFlushBuy ? (1.00 + cbReversalBias_ * 0.5) : 0.0
    s += microClusterLow ? 0.7 : 0.0
    s += hiddenLiquidityBuy ? 1.05 : 0.0
    s += strongLiquidityBuy ? 1.35 : 0.0
    s += strongSupportRejection ? 1.45 : 0.0
    s += buyInstitutionalRejection ? 1.25 : 0.0
    s += buyReclaimHighQuality ? 0.40 : 0.0
    s += trapBuy ? 1.0 : 0.0
    s += lsBuyStrict ? 0.80 : 0.0
    s += bullTrapEarly ? 0.75 : 0.0
    s += bullTrapStrict ? 1.15 : 0.0
    s += bullTrapStrictPlus ? 0.35 : 0.0
    s += tcBuyStrict ? 0.85 : 0.0
    s += buySetupType_ == SETUP_RECLAIM ? 0.18 : 0.0
    s += buySetupType_ == SETUP_BREAKOUT_BUILD ? 0.28 : 0.0
    s += buySetupType_ == SETUP_LIQUIDITY_TRAP ? 0.20 : 0.0
    s += buySetupType_ == SETUP_VWAP_REVERSION ? 0.35 : 0.0
    s += buySetupType_ == SETUP_OPEN_MOMENTUM ? 0.45 : 0.0
    s += buySetupType_ == SETUP_FAILED_BREAKOUT ? 0.30 : 0.0
    s += marketMemoryBias == 1 ? 0.8 : 0.0
    s += microRangeActive ? -0.35 : 0.15
    s += coinDnaCode == COIN_DNA_TREND_DRIVER ? 0.35 : 0.0
    s += coinDnaCode == COIN_DNA_MOMENTUM_EXPLOSIVE ? 0.25 : 0.0
    s += coinDnaCode == COIN_DNA_LIQUIDITY_HUNTER and buyIntent_ == INTENT_LIQUIDITY ? 0.25 : 0.0
    s += nearSupport ? 1.0 : 0.0
    s += nearCurrentSessionLow ? 0.65 : 0.0
    s += nearRelayLow ? 0.60 : 0.0
    s += bullMacd ? 0.8 : 0.0
    s += trendUpBasic ? 1.1 : 0.0
    s += bullVolImpulse ? 0.8 : 0.0
    float cqb = clamp(safeDiv(candleBody, math.max(barRange, syminfo.mintick), 0.0) * 0.40 + safeDiv(close - low, math.max(barRange, syminfo.mintick), 0.0) * 0.35 + (lowerWick > upperWick * 1.5 ? 0.25 : 0.0), 0.0, 1.0)
    s += cqb * 0.80
    s += lateEntryOk ? 0.35 : 0.0
    s += chaseBuyOk ? 0.3 : -0.1
    s += close > emaFast ? 0.35 : 0.0
    s += sessionCode == SESSION_NY_OPEN ? 0.35 : (sessionCode == SESSION_LONDON or sessionCode == SESSION_NY_LATE) ? 0.20 : 0.0
    s += htfStructureBias == 1 ? HTF_SCORE_BOOST : 0.0
    s += htfStructureBias == -1 ? -HTF_SCORE_PENALTY : 0.0
    s += liquidityPoolScoreDown * 0.25
    s += volatilityExpansionReady ? 0.35 : 0.0
    s += rsiOversold ? 0.45 : 0.0
    s += rsiBullDiv ? 0.38 : 0.0
    s += rsiRisingBull and rsiVal < 55 ? 0.18 : 0.0
    s += rsiOverbought ? -0.35 : 0.0
    s += pullbackQualityBuy and buySetupType_ == SETUP_CONTINUATION ? 0.30 : 0.0
    s += pullbackTooDeepBuy and buySetupType_ == SETUP_CONTINUATION ? -0.40 : 0.0
    s += bullBos and buySetupType_ == SETUP_CONTINUATION ? 0.30 : 0.0
    s += bullChoch ? 0.25 : 0.0
    s += nearBullFvg ? 0.28 : 0.0
    s += fvgRetestBuy ? 0.40 : 0.0
    s += volume > volSma20 * VOL_CONFIRM_MULT and (buySetupType_ == SETUP_LIQUIDITY_TRAP or buySetupType_ == SETUP_SWEEP) ? 0.40 : 0.0
    s += getPreSweepScoreBonus(SIDE_BUY, preSweepBias, buyIntent_)
    s += getPathScoreBonus(SIDE_BUY)
    s += getWhaleScoreBonus(SIDE_BUY)
    s += getFalseBreakPenalty(SIDE_BUY)
    s += getSessionBiasBonus(SIDE_BUY) * 0.42
    s += getSessionBiasPenalty(SIDE_BUY) * -0.34
    s += getSessionBreakBonus(SIDE_BUY)
    s += getSessionReclaimBonus(SIDE_BUY)
    // REFAKTOR: Confluence/Premium injiceras inte längre här (var dubbelräkning).
    // De bidrar nu EN gång via buyQualityScore. Booleans används fortfarande som grindar.
    s += buyPermission_ ? 0.20 : -1.00
    s

d2_calcSellScore(int sellSetupType_, int sellIntent_, float cbReversalBias_, float cbBreakoutBias_, bool sellPermission_) =>
    float s = 0.0
    s += bearTrap ? 2.2 : 0.0
    s += bearSweep ? 1.8 : 0.0
    s += sessionReclaimSellRef ? 1.15 : 0.0
    s += sessionRejectSellRef ? 0.80 : 0.0
    s += sessionBreakoutPressureSellRef ? 0.90 : 0.0
    s += bearReject ? (1.5 + cbReversalBias_) : 0.0
    s += softBearReclaim ? (1.2 + cbReversalBias_ * 0.7) : 0.0
    s += bearRetest ? 1.7 : 0.0
    s += bearBreakdownAllowed ? (1.2 + math.max(-cbBreakoutBias_, 0.0)) : 0.0
    s += smartBreakdownReadySell ? 1.15 : 0.0
    s += sellBreakAntEarly and not smartBreakdownReadySell ? 0.55 : 0.0
    s += math.min(sellBreakAntScore * 0.22, 1.0)
    s += softResistanceReject ? (1.15 + cbReversalBias_ * 0.6) : 0.0
    s += localBlowoffSell ? (1.00 + cbReversalBias_ * 0.5) : 0.0
    s += microClusterHigh ? 0.7 : 0.0
    s += hiddenLiquiditySell ? 1.05 : 0.0
    s += strongLiquiditySell ? 1.35 : 0.0
    s += strongResistanceRejection ? 1.45 : 0.0
    s += sellInstitutionalRejection ? 1.25 : 0.0
    s += sellReclaimHighQuality ? 0.40 : 0.0
    s += trapSell ? 1.0 : 0.0
    s += lsSellStrict ? 0.80 : 0.0
    s += bearTrapEarly ? 0.75 : 0.0
    s += bearTrapStrict ? 1.15 : 0.0
    s += bearTrapStrictPlus ? 0.35 : 0.0
    s += tcSellStrict ? 0.85 : 0.0
    s += sellSetupType_ == SETUP_RECLAIM ? 0.18 : 0.0
    s += sellSetupType_ == SETUP_BREAKOUT_BUILD ? 0.28 : 0.0
    s += sellSetupType_ == SETUP_LIQUIDITY_TRAP ? 0.20 : 0.0
    s += sellSetupType_ == SETUP_VWAP_REVERSION ? 0.35 : 0.0
    s += sellSetupType_ == SETUP_OPEN_MOMENTUM ? 0.45 : 0.0
    s += sellSetupType_ == SETUP_FAILED_BREAKOUT ? 0.30 : 0.0
    s += marketMemoryBias == -1 ? 0.8 : 0.0
    s += microRangeActive ? -0.35 : 0.15
    s += coinDnaCode == COIN_DNA_TREND_DRIVER ? 0.35 : 0.0
    s += coinDnaCode == COIN_DNA_MOMENTUM_EXPLOSIVE ? 0.25 : 0.0
    s += coinDnaCode == COIN_DNA_LIQUIDITY_HUNTER and sellIntent_ == INTENT_LIQUIDITY ? 0.25 : 0.0
    s += nearResistance ? 1.0 : 0.0
    s += nearCurrentSessionHigh ? 0.65 : 0.0
    s += nearRelayHigh ? 0.60 : 0.0
    s += bearMacd ? 0.8 : 0.0
    s += trendDownBasic ? 1.1 : 0.0
    s += bearVolImpulse ? 0.8 : 0.0
    float cqs = clamp(safeDiv(candleBody, math.max(barRange, syminfo.mintick), 0.0) * 0.40 + safeDiv(high - close, math.max(barRange, syminfo.mintick), 0.0) * 0.35 + (upperWick > lowerWick * 1.5 ? 0.25 : 0.0), 0.0, 1.0)
    s += cqs * 0.80
    s += lateEntryOk ? 0.35 : 0.0
    s += chaseSellOk ? 0.3 : -0.1
    s += close < emaFast ? 0.35 : 0.0
    s += sessionCode == SESSION_NY_OPEN ? 0.35 : (sessionCode == SESSION_LONDON or sessionCode == SESSION_NY_LATE) ? 0.20 : 0.0
    s += htfStructureBias == -1 ? HTF_SCORE_BOOST : 0.0
    s += htfStructureBias == 1 ? -HTF_SCORE_PENALTY : 0.0
    s += liquidityPoolScoreUp * 0.25
    s += volatilityExpansionReady ? 0.35 : 0.0
    s += rsiOverbought ? 0.45 : 0.0
    s += rsiBearDiv ? 0.38 : 0.0
    s += rsiFallingBear and rsiVal > 45 ? 0.18 : 0.0
    s += rsiOversold ? -0.35 : 0.0
    s += pullbackQualitySell and sellSetupType_ == SETUP_CONTINUATION ? 0.30 : 0.0
    s += pullbackTooDeepSell and sellSetupType_ == SETUP_CONTINUATION ? -0.40 : 0.0
    s += bearBos and sellSetupType_ == SETUP_CONTINUATION ? 0.30 : 0.0
    s += bearChoch ? 0.25 : 0.0
    s += nearBearFvg ? 0.28 : 0.0
    s += fvgRetestSell ? 0.40 : 0.0
    s += volume > volSma20 * VOL_CONFIRM_MULT and (sellSetupType_ == SETUP_LIQUIDITY_TRAP or sellSetupType_ == SETUP_SWEEP) ? 0.40 : 0.0
    s += getPreSweepScoreBonus(SIDE_SELL, preSweepBias, sellIntent_)
    s += getPathScoreBonus(SIDE_SELL)
    s += getWhaleScoreBonus(SIDE_SELL)
    s += getFalseBreakPenalty(SIDE_SELL)
    s += getSessionBiasBonus(SIDE_SELL) * 0.42
    s += getSessionBiasPenalty(SIDE_SELL) * -0.34
    s += getSessionBreakBonus(SIDE_SELL)
    s += getSessionReclaimBonus(SIDE_SELL)
    // REFAKTOR: Confluence/Premium injiceras inte längre här (var dubbelräkning).
    // De bidrar nu EN gång via sellQualityScore. Booleans används fortfarande som grindar.
    s += sellPermission_ ? 0.20 : -1.00
    s

//======================================================
// BASE SCORE - BUY
//======================================================
float buyScore = d2_calcBuyScore(buySetupType, buyIntent, cbReversalBias, cbBreakoutBias, buyPermission)

//======================================================
// BASE SCORE - SELL
//======================================================
float sellScore = d2_calcSellScore(sellSetupType, sellIntent, cbReversalBias, cbBreakoutBias, sellPermission)

d2_calcBuyContextScore(int buyIntent_, bool buyPermission_) =>
    float s = 0.0
    s += regimeCode == REGIME_TREND_UP ? 0.8 : 0.0
    s += regimeCode == REGIME_EXPANSION ? 0.5 : 0.0
    s += regimeCode == REGIME_CHAOTIC ? -0.15 : 0.0
    s += continuationScore > 0.45 ? 0.5 : 0.0
    s += expansionProbability >= 3.2 ? 0.5 : 0.0
    s += buyIntent_ == INTENT_CONTINUATION ? 0.5 : 0.0
    s += buyIntent_ == INTENT_EXPANSION ? 0.6 : 0.0
    s += buyIntent_ == INTENT_LIQUIDITY ? 0.5 : 0.0
    s += supportZoneQuality >= 2.8 ? 0.45 : supportZoneQuality >= 1.6 ? 0.15 : -0.05
    s += nearCurrentSessionLow ? 0.28 : 0.0
    s += nearRelayLow ? 0.24 : 0.0
    s += nearTrueLowerPool ? 0.24 : 0.0
    s += sessionReclaimBuyRef ? 0.26 : 0.0
    s += sessionBreakoutPressureBuyRef ? 0.18 : 0.0
    s += smartBreakoutReadyBuy ? 0.42 : 0.0
    s += buyBreakAntEarly and not smartBreakoutReadyBuy ? 0.22 : 0.0
    s += strongSupportRejection ? 0.38 : 0.0
    s += buyInstitutionalRejection ? 0.55 : 0.0
    s += buyReclaimHighQuality ? 0.18 : 0.0
    s += regimeCode == REGIME_TREND_UP and close >= emaFast ? 0.25 : 0.0
    s += regimeCode == REGIME_TREND_UP and supportZoneQuality >= 1.6 ? 0.20 : 0.0
    s += coinProfileCode == COIN_PROFILE_TREND ? 0.18 : 0.0
    s += coinProfileCode == COIN_PROFILE_EXPLOSIVE ? 0.10 : 0.0
    s += coinProfileCode == COIN_PROFILE_CHOPPY ? -0.08 : 0.0
    s += coinCrowdedMarket ? -0.18 : 0.0
    s += coinVeryCrowdedMarket ? -0.22 : 0.0
    s += longExhaustion ? -0.6 : 0.0
    s += tcBuyStrict ? 0.35 : 0.0
    s += bullBos ? 0.35 : 0.0
    s += bullChoch ? 0.30 : 0.0
    s += marketMemoryBias == 1 ? 0.30 : 0.0
    s += microRangeActive and buyIntent_ != INTENT_LIQUIDITY ? -0.20 : 0.0
    s += coinDnaCode == COIN_DNA_MEAN_REVERTER and buyIntent_ == INTENT_CONTINUATION ? -0.18 : 0.0
    s += preSweepBias == -1 and buyIntent_ == INTENT_LIQUIDITY ? 0.20 : 0.0
    s += preSweepBias == 1 and buyIntent_ != INTENT_LIQUIDITY ? -0.22 : 0.0
    s += marketStructureProxy == 1 ? 0.25 : 0.0
    s += htfProxyBias == 1 ? 0.35 : 0.0
    s += coinDnaCode == COIN_DNA_TREND_DRIVER ? 0.18 : 0.0
    s += coinDnaCode == COIN_DNA_LIQUIDITY_HUNTER and buyIntent_ == INTENT_LIQUIDITY ? 0.15 : 0.0
    s += volatilityExpansionReady ? 0.18 : 0.0
    s += getContextPreSweepPrimary(SIDE_BUY, preSweepBias, buyIntent_)
    s += getWhaleContextBonus(SIDE_BUY)
    s += getFalseBreakContextPenalty(SIDE_BUY)
    s += getSessionBiasBonus(SIDE_BUY) * 0.32
    s += getSessionBiasPenalty(SIDE_BUY) * -0.28
    // REFAKTOR: Confluence/Premium injiceras inte längre här (var dubbelräkning).
    // De bidrar nu EN gång via buyQualityScore.
    s += buyPermission_ ? 0.18 : -1.20
    s

d2_calcSellContextScore(int sellIntent_, bool sellPermission_) =>
    float s = 0.0
    s += regimeCode == REGIME_TREND_DOWN ? 0.8 : 0.0
    s += regimeCode == REGIME_EXPANSION ? 0.5 : 0.0
    s += regimeCode == REGIME_CHAOTIC ? -0.15 : 0.0
    s += continuationScore > 0.45 ? 0.5 : 0.0
    s += expansionProbability >= 3.2 ? 0.5 : 0.0
    s += sellIntent_ == INTENT_CONTINUATION ? 0.5 : 0.0
    s += sellIntent_ == INTENT_EXPANSION ? 0.6 : 0.0
    s += sellIntent_ == INTENT_LIQUIDITY ? 0.5 : 0.0
    s += resistanceZoneQuality >= 2.8 ? 0.45 : resistanceZoneQuality >= 1.6 ? 0.15 : -0.05
    s += nearCurrentSessionHigh ? 0.28 : 0.0
    s += nearRelayHigh ? 0.24 : 0.0
    s += nearTrueUpperPool ? 0.24 : 0.0
    s += sessionReclaimSellRef ? 0.26 : 0.0
    s += sessionBreakoutPressureSellRef ? 0.18 : 0.0
    s += smartBreakdownReadySell ? 0.42 : 0.0
    s += sellBreakAntEarly and not smartBreakdownReadySell ? 0.22 : 0.0
    s += strongResistanceRejection ? 0.38 : 0.0
    s += sellInstitutionalRejection ? 0.55 : 0.0
    s += sellReclaimHighQuality ? 0.18 : 0.0
    s += regimeCode == REGIME_TREND_DOWN and close <= emaFast ? 0.25 : 0.0
    s += regimeCode == REGIME_TREND_DOWN and resistanceZoneQuality >= 1.6 ? 0.20 : 0.0
    s += coinProfileCode == COIN_PROFILE_TREND ? 0.18 : 0.0
    s += coinProfileCode == COIN_PROFILE_EXPLOSIVE ? 0.10 : 0.0
    s += coinProfileCode == COIN_PROFILE_CHOPPY ? -0.08 : 0.0
    s += coinCrowdedMarket ? -0.18 : 0.0
    s += coinVeryCrowdedMarket ? -0.22 : 0.0
    s += shortExhaustion ? -0.6 : 0.0
    s += tcSellStrict ? 0.35 : 0.0
    s += bearBos ? 0.35 : 0.0
    s += bearChoch ? 0.30 : 0.0
    s += marketMemoryBias == -1 ? 0.30 : 0.0
    s += microRangeActive and sellIntent_ != INTENT_LIQUIDITY ? -0.20 : 0.0
    s += coinDnaCode == COIN_DNA_MEAN_REVERTER and sellIntent_ == INTENT_CONTINUATION ? -0.18 : 0.0
    s += preSweepBias == 1 and sellIntent_ == INTENT_LIQUIDITY ? 0.20 : 0.0
    s += preSweepBias == -1 and sellIntent_ != INTENT_LIQUIDITY ? -0.22 : 0.0
    s += marketStructureProxy == -1 ? 0.25 : 0.0
    s += htfProxyBias == -1 ? 0.35 : 0.0
    s += coinDnaCode == COIN_DNA_TREND_DRIVER ? 0.18 : 0.0
    s += coinDnaCode == COIN_DNA_LIQUIDITY_HUNTER and sellIntent_ == INTENT_LIQUIDITY ? 0.15 : 0.0
    s += volatilityExpansionReady ? 0.18 : 0.0
    s += getContextPreSweepPrimary(SIDE_SELL, preSweepBias, sellIntent_)
    s += getWhaleContextBonus(SIDE_SELL)
    s += getFalseBreakContextPenalty(SIDE_SELL)
    s += getSessionBiasBonus(SIDE_SELL) * 0.32
    s += getSessionBiasPenalty(SIDE_SELL) * -0.28
    // REFAKTOR: Confluence/Premium injiceras inte längre här (var dubbelräkning).
    // De bidrar nu EN gång via sellQualityScore.
    s += sellPermission_ ? 0.18 : -1.20
    s

//======================================================
// CONTEXT SCORE - BUY
//======================================================
float buyContextScore = d2_calcBuyContextScore(buyIntent, buyPermission)

//======================================================
// CONTEXT SCORE - SELL
//======================================================
float sellContextScore = d2_calcSellContextScore(sellIntent, sellPermission)

var float buyTrapQualityBoost  = 0.0
var float sellTrapQualityBoost = 0.0
if barstate.isconfirmed
    float btqb = 0.0
    btqb += bullTrapStrict ? 0.45 : 0.0
    btqb += trapBuy ? 0.55 : 0.0
    btqb += strongSupportRejection ? 0.35 : 0.0
    btqb += localFlushBuy ? 0.25 : 0.0
    btqb += nearCurrentSessionLow ? 0.15 : 0.0
    btqb += nearTrueLowerPool ? 0.20 : 0.0
    btqb += falseBreakoutRiskBuy ? -0.30 : 0.0
    buyTrapQualityBoost := clamp(btqb, -0.40, 1.25)

    float stqb = 0.0
    stqb += bearTrapStrict ? 0.45 : 0.0
    stqb += trapSell ? 0.55 : 0.0
    stqb += strongResistanceRejection ? 0.35 : 0.0
    stqb += localBlowoffSell ? 0.25 : 0.0
    stqb += nearCurrentSessionHigh ? 0.15 : 0.0
    stqb += nearTrueUpperPool ? 0.20 : 0.0
    stqb += falseBreakoutRiskSell ? -0.30 : 0.0
    sellTrapQualityBoost := clamp(stqb, -0.40, 1.25)

float buyFinalScore  = buyScore + buyContextScore + buyTrapQualityBoost
float sellFinalScore = sellScore + sellContextScore + sellTrapQualityBoost

//======================================================
// REGIME-ALIGNMENT MULTIPLIER (improvement 2)
//======================================================
float buyRegimeAlignMult = 1.0
if buySetupType == SETUP_CONTINUATION
    buyRegimeAlignMult := regimeCode == REGIME_TREND_UP ? 1.15 : regimeCode == REGIME_EXPANSION ? 1.10 : regimeCode == REGIME_TREND_DOWN ? 0.70 : 0.88
else if buySetupType == SETUP_REVERSAL
    buyRegimeAlignMult := regimeCode == REGIME_RANGE ? 1.12 : regimeCode == REGIME_COMPRESSION ? 1.08 : regimeCode == REGIME_TREND_DOWN ? 0.80 : 0.95
else if buySetupType == SETUP_LIQUIDITY_TRAP
    buyRegimeAlignMult := regimeCode == REGIME_CHAOTIC ? 0.82 : regimeCode == REGIME_EXPANSION ? 1.08 : 1.0
else if buySetupType == SETUP_BREAKOUT_BUILD
    buyRegimeAlignMult := regimeCode == REGIME_EXPANSION ? 1.18 : regimeCode == REGIME_TREND_UP ? 1.12 : regimeCode == REGIME_COMPRESSION ? 0.78 : 0.92

float sellRegimeAlignMult = 1.0
if sellSetupType == SETUP_CONTINUATION
    sellRegimeAlignMult := regimeCode == REGIME_TREND_DOWN ? 1.15 : regimeCode == REGIME_EXPANSION ? 1.10 : regimeCode == REGIME_TREND_UP ? 0.70 : 0.88
else if sellSetupType == SETUP_REVERSAL
    sellRegimeAlignMult := regimeCode == REGIME_RANGE ? 1.12 : regimeCode == REGIME_COMPRESSION ? 1.08 : regimeCode == REGIME_TREND_UP ? 0.80 : 0.95
else if sellSetupType == SETUP_LIQUIDITY_TRAP
    sellRegimeAlignMult := regimeCode == REGIME_CHAOTIC ? 0.82 : regimeCode == REGIME_EXPANSION ? 1.08 : 1.0
else if sellSetupType == SETUP_BREAKOUT_BUILD
    sellRegimeAlignMult := regimeCode == REGIME_EXPANSION ? 1.18 : regimeCode == REGIME_TREND_DOWN ? 1.12 : regimeCode == REGIME_COMPRESSION ? 0.78 : 0.92

buyFinalScore  *= buyRegimeAlignMult
sellFinalScore *= sellRegimeAlignMult


//======================================================
// UNIFIED QUALITY SCORE  (REFAKTOR: ersätter gamla SyncScore)
//------------------------------------------------------
// SINGLE SOURCE OF TRUTH för de tre kvalitets-engines:
//   Confluence, Premium Quality och Engine Agreement.
// Tidigare återinjicerades dessa i base score, context score, sync score
// OCH seed score (4-5 ggr) -> samma signal räknades flera gånger och gjorde
// slutscoren omöjlig att resonera om. Nu bidrar varje engine EXAKT en gång
// här. Booleans (Ready/Strong/PremiumReady/EngineAgreement) används fortfarande
// som grindar och trösklar på andra ställen - bara den numeriska dubbel-
// räkningen är borttagen. Vikterna nedan är satta så att den typiska score-
// skalan (och därmed grade-trösklarna 9.0/6.8/5.4) ligger kvar ungefär som förr.
//======================================================
float buyQualityScore = 0.0
buyQualityScore += buyConfluenceScore * 0.26                                   // Confluence: en gång (var base 0.16 + ctx 0.12 + sync-excess)
buyQualityScore += buyConfluenceStrong ? 0.40 : buyConfluenceReady ? 0.18 : 0.0 // Confluence-grindbonus: en gång (var base + ctx)
buyQualityScore += math.max(buyPremiumQuality, 0.0) * 0.55                     // Premium: en gång (var base 0.26 + ctx 0.22 + sync 0.12)
buyQualityScore += buyEngineAgreement * 0.55                                   // Engine agreement: en gång (var bara i sync)
buyQualityScore += buyPermission ? 0.12 : -0.28
buyQualityScore += falseBreakoutRiskBuy ? -0.35 : 0.0
buyQualityScore := clamp(buyQualityScore, -2.20, 3.40)

float sellQualityScore = 0.0
sellQualityScore += sellConfluenceScore * 0.26
sellQualityScore += sellConfluenceStrong ? 0.40 : sellConfluenceReady ? 0.18 : 0.0
sellQualityScore += math.max(sellPremiumQuality, 0.0) * 0.55
sellQualityScore += sellEngineAgreement * 0.55
sellQualityScore += sellPermission ? 0.12 : -0.28
sellQualityScore += falseBreakoutRiskSell ? -0.35 : 0.0
sellQualityScore := clamp(sellQualityScore, -2.20, 3.40)

float buyUnifiedScore = buyFinalScore + buyQualityScore
float sellUnifiedScore = sellFinalScore + sellQualityScore

//======================================================
// DYNAMIC GRADE THRESHOLD (improvement 3)
//======================================================
var float gradeContextAdj = 0.0
if barstate.isconfirmed
    float gca = 0.0
    gca -= regimeCode == REGIME_CHAOTIC ? 0.9 : 0.0
    gca -= coinVeryCrowdedMarket ? 0.5 : 0.0
    gca -= noiseScoreMarket > 0.54 ? 0.4 : 0.0
    gca -= microRangeActive ? 0.3 : 0.0
    gca += regimeCode == REGIME_TREND_UP and htfStructureBias == 1 ? 0.3 : 0.0
    gca += regimeCode == REGIME_TREND_DOWN and htfStructureBias == -1 ? 0.3 : 0.0
    gca += volatilityExpansionReady ? 0.2 : 0.0
    gca += sessionCode == SESSION_NY_OPEN or sessionCode == SESSION_LONDON ? 0.15 : 0.0
    bool strongSig = bullTrapStrict or bearTrapStrict or buyInstitutionalRejection or sellInstitutionalRejection
    gca += regimeCode == REGIME_RANGE and strongSig ? 0.25 : 0.0
    gca += regimeCode == REGIME_COMPRESSION and volatilityExpansionReady ? 0.30 : 0.0
    gca -= regimeCode == REGIME_CHAOTIC and not strongSig ? 0.35 : 0.0
    gradeContextAdj := clamp(gca, -1.5, 0.7)

float buyUnifiedScoreAdj  = buyUnifiedScore  + gradeContextAdj
float sellUnifiedScoreAdj = sellUnifiedScore + gradeContextAdj

string buyGrade = gradeFromScore(buyUnifiedScoreAdj)
string sellGrade = gradeFromScore(sellUnifiedScoreAdj)
string buyConf = confFromScore(buyUnifiedScoreAdj)
string sellConf = confFromScore(sellUnifiedScoreAdj)
// AI confidence är inbakad i confFromScore (DEL 3 läser buyConfEff/sellConfEff).





//======================================================
// WEAK SETUP FILTERS
//======================================================
bool weakBuySetup = (
    buyGrade == "B" and
    buyConf == "LOW" and
    buyIntent == INTENT_SCALP and
    regimeCode != REGIME_RANGE and
    not (regimeCode == REGIME_TREND_UP and close >= emaFast) and
    not strongSupportRejection and
    not buyInstitutionalRejection and
    not bullTrapStrict and
    buyConfluenceScore < 2.0
)

bool weakSellSetup = (
    sellGrade == "B" and
    sellConf == "LOW" and
    sellIntent == INTENT_SCALP and
    regimeCode != REGIME_RANGE and
    not (regimeCode == REGIME_TREND_DOWN and close <= emaFast) and
    not strongResistanceRejection and
    not sellInstitutionalRejection and
    not bearTrapStrict and
    sellConfluenceScore < 2.0
)

bool counterTrendWeakBuy =
     regimeCode == REGIME_TREND_DOWN and
     buyIntent != INTENT_LIQUIDITY and
     buyGrade == "B" and
     supportZoneQuality < 1.4 and
     not strongSupportRejection and
     not buyInstitutionalRejection

bool counterTrendWeakSell =
     regimeCode == REGIME_TREND_UP and
     sellIntent != INTENT_LIQUIDITY and
     sellGrade == "B" and
     resistanceZoneQuality < 1.4 and
     not strongResistanceRejection and
     not sellInstitutionalRejection

//======================================================
// SPACE FAIL MEMORY
//======================================================
var int lastBuySpaceFailBar  = na
var int lastSellSpaceFailBar = na

bool recentBuySpaceFail  = not na(lastBuySpaceFailBar) and bar_index - lastBuySpaceFailBar <= SPACE_FAIL_COOLDOWN_BARS
bool recentSellSpaceFail = not na(lastSellSpaceFailBar) and bar_index - lastSellSpaceFailBar <= SPACE_FAIL_COOLDOWN_BARS

//======================================================
// SEED LOCATION SCORE
//======================================================
float buySeedLocationScore = 0.0
buySeedLocationScore += nearSupport ? 1.0 : 0.0
buySeedLocationScore += sessionLocationScoreBuy
buySeedLocationScore += nearTrueLowerPool ? 0.8 : 0.0
buySeedLocationScore += liquidityPoolScoreDown * 0.35
buySeedLocationScore += supportZoneQuality >= 1.6 ? 0.45 : 0.0
buySeedLocationScore += preSweepBias == -1 ? 0.25 : 0.0
buySeedLocationScore += getPathAssistScore(SIDE_BUY)
buySeedLocationScore += smartBreakoutReadyBuy ? 0.35 : 0.0
buySeedLocationScore += buyBreakAntEarly and not smartBreakoutReadyBuy ? 0.18 : 0.0
buySeedLocationScore += strongSupportRejection ? 0.70 : 0.0
buySeedLocationScore += buyInstitutionalRejection ? 0.80 : 0.0
buySeedLocationScore += buyReclaimHighQuality ? 0.20 : 0.0
buySeedLocationScore += math.max(sessionBiasScore, 0.0) * 0.32
// REFAKTOR (B): Confluence/Premium borttagna här -> seedLocationScore är nu en ren
// location-score utan överlapp mot QualityScore. Seed-trösklarna nedan är
// proportionellt nedjusterade (x0.85) för att kompensera magnitudbortfallet.

float sellSeedLocationScore = 0.0
sellSeedLocationScore += nearResistance ? 1.0 : 0.0
sellSeedLocationScore += sessionLocationScoreSell
sellSeedLocationScore += nearTrueUpperPool ? 0.8 : 0.0
sellSeedLocationScore += liquidityPoolScoreUp * 0.35
sellSeedLocationScore += resistanceZoneQuality >= 1.6 ? 0.45 : 0.0
sellSeedLocationScore += preSweepBias == 1 ? 0.25 : 0.0
sellSeedLocationScore += getPathAssistScore(SIDE_SELL)
sellSeedLocationScore += smartBreakdownReadySell ? 0.35 : 0.0
sellSeedLocationScore += sellBreakAntEarly and not smartBreakdownReadySell ? 0.18 : 0.0
sellSeedLocationScore += strongResistanceRejection ? 0.70 : 0.0
sellSeedLocationScore += sellInstitutionalRejection ? 0.80 : 0.0
sellSeedLocationScore += sellReclaimHighQuality ? 0.20 : 0.0
sellSeedLocationScore += math.max(-sessionBiasScore, 0.0) * 0.32
// REFAKTOR (B): Confluence/Premium borttagna här -> seedLocationScore är nu en ren
// location-score utan överlapp mot QualityScore. Seed-trösklarna nedan är
// proportionellt nedjusterade (x0.85) för att kompensera magnitudbortfallet.

bool buySeedCore =
     rawLongSetup and
     not buyHardInvalidation and
     buySetupType != SETUP_NONE and
     not recentBuySpaceFail and
     bodyOk and
     wickOkBuy and
     lateEntryOk and
     chaseBuyOk and
     not longExhaustion and
     not weakBuySetup and
     not counterTrendWeakBuy and
     not falseBreakoutRiskBuy and
     buyLocationEfficiency >= 0.25 and
     buyAlignmentScore > -0.25

bool sellSeedCore =
     rawShortSetup and
     not sellHardInvalidation and
     sellSetupType != SETUP_NONE and
     not recentSellSpaceFail and
     bodyOk and
     wickOkSell and
     lateEntryOk and
     chaseSellOk and
     not shortExhaustion and
     not weakSellSetup and
     not counterTrendWeakSell and
     not falseBreakoutRiskSell and
     sellLocationEfficiency >= 0.25 and
     sellAlignmentScore > -0.25

//======================================================
// BOOSTED SOFT SEED LAYER
//======================================================
bool buySoftSeedEvent =
     bullTrapEarly or
     bullTrapStrict or
     lsBuyStrict or
     bullSweep or
     bullSweepLiq or
     sessionReclaimBuyRef or
     sessionRejectBuyRef or
     softBullReclaim or
     bullRetest or
     bullBounce or
     softSupportReject or
     localFlushBuy or
     microClusterLow or
     hiddenLiquidityBuy or
     strongLiquidityBuy or
     strongSupportRejection or
     buyInstitutionalRejection or
     trapBuy or
     smartBreakoutReadyBuy or
     buyBreakAntEarly or
     sessionBreakoutPressureBuyRef

bool sellSoftSeedEvent =
     bearTrapEarly or
     bearTrapStrict or
     lsSellStrict or
     bearSweep or
     bearSweepLiq or
     sessionReclaimSellRef or
     sessionRejectSellRef or
     softBearReclaim or
     bearRetest or
     bearReject or
     softResistanceReject or
     localBlowoffSell or
     microClusterHigh or
     hiddenLiquiditySell or
     strongLiquiditySell or
     strongResistanceRejection or
     sellInstitutionalRejection or
     trapSell or
     smartBreakdownReadySell or
     sellBreakAntEarly or
     sessionBreakoutPressureSellRef

bool buySeedSoft =
     buyPermission and
     rawLongSetup and
     not buyHardInvalidation and
     buySetupType != SETUP_NONE and
     buyHasPreSlAnchor and
     (buySoftSeedEvent or strongSupportRejection or buyInstitutionalRejection) and
     (buySeedLocationScore >= 0.36 or strongSupportRejection or buyInstitutionalRejection) and
     not counterTrendWeakBuy and
     not (falseBreakoutRiskBuy and buySetupType == SETUP_BREAKOUT_BUILD) and
     not (longExhaustion and buyIntent != INTENT_LIQUIDITY) and
     buyAlignmentScore > -0.30

bool sellSeedSoft =
     sellPermission and
     rawShortSetup and
     not sellHardInvalidation and
     sellSetupType != SETUP_NONE and
     sellHasPreSlAnchor and
     (sellSoftSeedEvent or strongResistanceRejection or sellInstitutionalRejection) and
     (sellSeedLocationScore >= 0.36 or strongResistanceRejection or sellInstitutionalRejection) and
     not counterTrendWeakSell and
     not (falseBreakoutRiskSell and sellSetupType == SETUP_BREAKOUT_BUILD) and
     not (shortExhaustion and sellIntent != INTENT_LIQUIDITY) and
     sellAlignmentScore > -0.30

bool buySeedActive  = (buyPermission and buySeedCore and buySeedLocationScore >= 0.55 and buyHasPreSlAnchor) or buySeedSoft
bool sellSeedActive = (sellPermission and sellSeedCore and sellSeedLocationScore >= 0.55 and sellHasPreSlAnchor) or sellSeedSoft

bool buySeedConfirmed =
     buySeedActive and
     roughBuySpaceOk and
     (
         buyConfluenceReady or
         buyConfluenceScore >= CONFLUENCE_READY_TH - 0.30 or
         buyConfluenceScore >= EARLY_BUILD_MIN_CONFL
     ) and
     (
         buyFinalScore >= preScoreThresholdDynamic - EARLY_PRE_SCORE_PAD or
         (buySeedSoft and buyFinalScore >= preScoreThresholdDynamic - EARLY_PRE_SCORE_PAD - 0.20)
     ) and
     (
         buyPremiumReady or
         buyInstitutionalRejection or
         buyConfluenceStrong or
         buySeedLocationScore >= 0.92
     )

bool sellSeedConfirmed =
     sellSeedActive and
     roughSellSpaceOk and
     (
         sellConfluenceReady or
         sellConfluenceScore >= CONFLUENCE_READY_TH - 0.30 or
         sellConfluenceScore >= EARLY_BUILD_MIN_CONFL
     ) and
     (
         sellFinalScore >= preScoreThresholdDynamic - EARLY_PRE_SCORE_PAD or
         (sellSeedSoft and sellFinalScore >= preScoreThresholdDynamic - EARLY_PRE_SCORE_PAD - 0.20)
     ) and
     (
         sellPremiumReady or
         sellInstitutionalRejection or
         sellConfluenceStrong or
         sellSeedLocationScore >= 0.98
     )

bool buySeedEarly =
     ENABLE_EARLY_LEVEL_BUILD and
     not buyHardInvalidation and
     not (sellConfluenceStrong and sellFinalScore > buyFinalScore + 0.80) and
     buySeedActive and
     buyHasPreSlAnchor and
     buyHasPreTpAnchor and
     buyConfluenceScore >= EARLY_BUILD_MIN_CONFL and
     (
         buyFinalScore >= preScoreThresholdDynamic - EARLY_PRE_SCORE_PAD or
         buyFinalScore >= nz(buyFinalScore[1], 0) - EARLY_BUILD_SCORE_HOLD or
         (buySeedSoft and buyFinalScore >= preScoreThresholdDynamic - EARLY_PRE_SCORE_PAD - 0.25)
     ) and
     (sessionBiasScore > -0.22 or buyIntent == INTENT_LIQUIDITY or strongSupportRejection or buyInstitutionalRejection)

bool sellSeedEarly =
     ENABLE_EARLY_LEVEL_BUILD and
     not sellHardInvalidation and
     not (buyConfluenceStrong and buyFinalScore > sellFinalScore + 0.60) and
     sellSeedActive and
     sellHasPreSlAnchor and
     sellHasPreTpAnchor and
     sellConfluenceScore >= EARLY_BUILD_MIN_CONFL and
     (
         sellFinalScore >= preScoreThresholdDynamic - EARLY_PRE_SCORE_PAD or
         sellFinalScore >= nz(sellFinalScore[1], 0) - EARLY_BUILD_SCORE_HOLD or
         (sellSeedSoft and sellFinalScore >= preScoreThresholdDynamic - EARLY_PRE_SCORE_PAD - 0.25)
     ) and
     (sessionBiasScore < 0.22 or sellIntent == INTENT_LIQUIDITY or strongResistanceRejection or sellInstitutionalRejection)

//======================================================
// CANDIDATE LAYER
//======================================================
bool buyCandidate =
     buySeedConfirmed and
     not buyHardInvalidation and
     (
         bullMacd or nearSupport or nearCurrentSessionLow or nearRelayLow or
         bullTrap or bullTrapStrict or bullTrapEarly or bullSweep or lsBuyStrict or tcBuyStrict or
         softBullReclaim or softSupportReject or localFlushBuy or microClusterLow or hiddenLiquidityBuy or
         strongSupportRejection or buyInstitutionalRejection or
         strongLiquidityBuy or trapBuy or sessionReclaimBuyRef or sessionRejectBuyRef or sessionBreakoutPressureBuyRef or
         smartBreakoutReadyBuy or buyBreakAntEarly or
         (is15m and regimeCode == REGIME_CHAOTIC and bullBounce)
     ) and
     (
         buyPremiumReady or
         buyInstitutionalRejection or
         buyConfluenceReady or
         buyConfluenceStrong
     )

bool sellCandidate =
     sellSeedConfirmed and
     not sellHardInvalidation and
     (
         bearMacd or nearResistance or nearCurrentSessionHigh or nearRelayHigh or
         bearTrap or bearTrapStrict or bearTrapEarly or bearSweep or lsSellStrict or tcSellStrict or
         softBearReclaim or softResistanceReject or localBlowoffSell or microClusterHigh or hiddenLiquiditySell or
         strongResistanceRejection or sellInstitutionalRejection or
         strongLiquiditySell or trapSell or sessionReclaimSellRef or sessionRejectSellRef or sessionBreakoutPressureSellRef or
         smartBreakdownReadySell or sellBreakAntEarly or
         (is15m and regimeCode == REGIME_CHAOTIC and bearReject)
     ) and
     (
         sellPremiumReady or
         sellInstitutionalRejection or
         sellConfluenceReady
     )

//======================================================
// PRE + EARLY BUILD LOGIC
//======================================================
bool preBuyBase =
     buyPermission and
     not buyHardInvalidation and
     SHOW_PRE_SIGNALS and
     buySeedActive and
     buyHasPreSlAnchor and
     buyHasPreTpAnchor and
     buyConfluenceScore >= 1.10 and
     (
         buySeedLocationScore >= 0.81 or
         nearSupport or
         nearCurrentSessionLow or
         nearRelayLow or
         nearTrueLowerPool or
         strongSupportRejection or
         buyInstitutionalRejection or
         (
             volatilityExpansionReady and
             close > open and
             bodyBase >= atrValue * 0.10 and
             close >= high - barRange * 0.22 and
             (
                 buySetupType == SETUP_RECLAIM or
                 bullTrapStrict or
                 strongLiquidityBuy or
                 buyBreakAntStrong
             )
         )
     ) and
     (preSweepBias != 1 or buyIntent == INTENT_LIQUIDITY) and
     (sessionBiasScore > -0.40 or buyIntent == INTENT_LIQUIDITY or strongSupportRejection or buyInstitutionalRejection) and
     (
         buySetupType == SETUP_RECLAIM or
         buySetupType == SETUP_SWEEP or
         buySetupType == SETUP_CONTINUATION or
         buySetupType == SETUP_BREAKOUT_BUILD or
         buySetupType == SETUP_LIQUIDITY_TRAP or
         buySetupType == SETUP_REVERSAL
     ) and
     (
         buyPremiumReady or
         buyInstitutionalRejection or
         buyConfluenceReady or
         buyFinalScore >= preScoreThresholdDynamic - 0.18
     )

bool preSellBase =
     sellPermission and
     not sellHardInvalidation and
     SHOW_PRE_SIGNALS and
     sellSeedActive and
     sellHasPreSlAnchor and
     sellHasPreTpAnchor and
     sellConfluenceScore >= 1.20 and
     (preSweepBias != -1 or sellIntent == INTENT_LIQUIDITY) and
     (sessionBiasScore < 0.40 or sellIntent == INTENT_LIQUIDITY or strongResistanceRejection or sellInstitutionalRejection) and
     (
         sellSetupType == SETUP_RECLAIM or
         sellSetupType == SETUP_SWEEP or
         sellSetupType == SETUP_CONTINUATION or
         sellSetupType == SETUP_BREAKOUT_BUILD or
         sellSetupType == SETUP_LIQUIDITY_TRAP or
         sellSetupType == SETUP_REVERSAL
     ) and
     (
         sellPremiumReady or
         sellInstitutionalRejection or
         sellConfluenceReady or
         sellFinalScore >= preScoreThresholdDynamic - 0.18
     )

bool preBuyBuildStart =
     preBuyBase and
     (
         not preBuyBase[1] or
         bullTrapEarly or
         bullTrapStrict or
         lsBuyStrict or
         sessionReclaimBuyRef or
         sessionRejectBuyRef or
         sessionBreakoutPressureBuyRef or
         buyBreakAntEarly or
         smartBreakoutReadyBuy or
         softBullReclaim or
         softSupportReject or
         localFlushBuy or
         strongSupportRejection or
         buyInstitutionalRejection or
         (
             close > open and
             close >= high - barRange * 0.35 and
             (
                 buySetupType == SETUP_RECLAIM or
                 bullTrapStrict or
                 strongLiquidityBuy
             )
         )
     ) and
     (
         buyFinalScore > nz(buyFinalScore[1], 0) or
         buySetupType != nz(buySetupType[1], SETUP_NONE) or
         buySeedLocationScore > nz(buySeedLocationScore[1], 0) or
         buyBreakAntScore > nz(buyBreakAntScore[1], 0) or
         buyConfluenceScore > nz(buyConfluenceScore[1], 0) or
         buySeedSoft
     )

bool preSellBuildStart =
     preSellBase and
     (
         not preSellBase[1] or
         bearTrapEarly or
         bearTrapStrict or
         lsSellStrict or
         sessionReclaimSellRef or
         sessionRejectSellRef or
         sessionBreakoutPressureSellRef or
         sellBreakAntEarly or
         smartBreakdownReadySell or
         softBearReclaim or
         softResistanceReject or
         localBlowoffSell or
         strongResistanceRejection or
         sellInstitutionalRejection or
         (
             volatilityExpansionReady and
             close < open and
             bodyBase >= atrValue * 0.10 and
             close <= low + barRange * 0.22 and
             (
                 sellSetupType == SETUP_RECLAIM or
                 bearTrapStrict or
                 strongLiquiditySell or
                 sellBreakAntStrong
             )
         )
     ) and
     (
         sellFinalScore > nz(sellFinalScore[1], 0) or
         sellSetupType != nz(sellSetupType[1], SETUP_NONE) or
         sellSeedLocationScore > nz(sellSeedLocationScore[1], 0) or
         sellBreakAntScore > nz(sellBreakAntScore[1], 0) or
         sellConfluenceScore > nz(sellConfluenceScore[1], 0) or
         sellSeedSoft
     )

//======================================================
// STATE
//======================================================
var bool pendingActive = false
var bool tradeActive   = false
var bool movedToBE     = false
var int setupSide      = 0
var int setupBar       = na
var int setupStatus    = STATUS_NONE

var float setupEntry = na
var float setupSL    = na
var float setupTP1   = na
var float setupTP2   = na
var float setupTP3   = na
var float setupScore = na

var string setupGrade     = ""
var string setupConf      = ""
var string setupIntentTxt = ""
var string setupZoneTxt   = ""
var string setupRegimeTxt = ""
var string setupTypeTxt   = ""

var line entryLine = na
var line slLine    = na
var line tp1Line   = na
var line tp2Line   = na
var line tp3Line   = na

var label sigLbl     = na
var label infoLbl    = na
var label entryLbl   = na
var label slLbl      = na
var label tp1Lbl     = na
var label tp2Lbl     = na
var label tp3Lbl     = na

var int lastPreBuyBar  = na
var int lastPreSellBar = na
var int lastLmBuyBar   = na
var int lastLmSellBar  = na

//======================================================
// INFO LABEL LAYOUT
//======================================================
float infoGap     = math.max(atrValue * 0.30, syminfo.mintick * 25)
float infoBaseY   = high + atrValue * 0.20
float infoStateY  = infoBaseY
float infoRegimeY = infoBaseY + infoGap

bool preBuyLeadStart  = preBuyBase and not preBuyBase[1]
bool preSellLeadStart = preSellBase and not preSellBase[1]

bool preBuySignal  = (preBuyBuildStart or preBuyLeadStart) and (na(lastPreBuyBar) or bar_index - lastPreBuyBar > PRE_COOLDOWN_BARS)
bool preSellSignal = (preSellBuildStart or preSellLeadStart) and (na(lastPreSellBar) or bar_index - lastPreSellBar > PRE_COOLDOWN_BARS)

bool earlyBuildBuy =
     buySeedEarly and
     not pendingActive and
     not tradeActive and
     roughBuySpaceOk and
     (
         buyConfluenceReady or
         buyConfluenceScore >= EARLY_BUILD_MIN_CONFL or
         strongSupportRejection or
         buyInstitutionalRejection
     ) and
     (
         buyFinalScore >= preScoreThresholdDynamic - EARLY_PRE_SCORE_PAD or
         buyFinalScore > nz(buyFinalScore[1], 0) or
         nz(buyFinalScore[1], 0) >= preScoreThresholdDynamic - EARLY_PRE_SCORE_PAD or
         (buySeedSoft and buyFinalScore >= preScoreThresholdDynamic - EARLY_PRE_SCORE_PAD - 0.20)
     ) and
     (
         buyConfluenceScore >= nz(buyConfluenceScore[1], 0) - 0.14 or
         buyConfluenceStrong or
         buySeedSoft or
         strongSupportRejection or
         buyInstitutionalRejection
     ) and
     ta.barssince(not buySeedEarly) <= EARLY_BUILD_PERSIST_BARS

bool earlyBuildSell =
     sellSeedEarly and
     not pendingActive and
     not tradeActive and
     roughSellSpaceOk and
     (
         sellConfluenceReady or
         sellConfluenceScore >= EARLY_BUILD_MIN_CONFL or
         strongResistanceRejection or
         sellInstitutionalRejection
     ) and
     (
         sellFinalScore >= preScoreThresholdDynamic - EARLY_PRE_SCORE_PAD or
         sellFinalScore > nz(sellFinalScore[1], 0) or
         nz(sellFinalScore[1], 0) >= preScoreThresholdDynamic - EARLY_PRE_SCORE_PAD or
         (sellSeedSoft and sellFinalScore >= preScoreThresholdDynamic - EARLY_PRE_SCORE_PAD - 0.20)
     ) and
     (
         sellConfluenceScore >= nz(sellConfluenceScore[1], 0) - 0.14 or
         sellConfluenceStrong or
         sellSeedSoft or
         strongResistanceRejection or
         sellInstitutionalRejection
     ) and
     ta.barssince(not sellSeedEarly) <= EARLY_BUILD_PERSIST_BARS

bool buyTrapFastLane =
     (
         bullTrapStrict or
         (trapBuy and strongLiquidityBuy) or
         strongSupportRejection or
         localFlushBuy
     ) and
     close > open and
     safeDiv(lowerWick, math.max(bodyBase, syminfo.mintick), 0.0) >= 0.60 and
     close >= low + barRange * 0.42 and
     (
         nearSupport or
         nearCurrentSessionLow or
         nearRelayLow or
         nearTrueLowerPool
     ) and
     not falseBreakoutRiskBuy and
     buyConfluenceScore >= buyConfluenceReadyThEff - 0.22 and
     buyFinalScore >= sellFinalScore - 0.10 and
     (
         buyEngineAgreement >= 0.0 or
         bullTrapStrict or
         strongLiquidityBuy
     ) and
     (
         buyConfluenceStrong or
         buyPremiumReady or
         bullTrapStrict or
         strongSupportRejection
     )

bool sellTrapFastLane =
     (
         bearTrapStrict or
         (trapSell and strongLiquiditySell) or
         strongResistanceRejection or
         localBlowoffSell
     ) and
     close < open and
     safeDiv(upperWick, math.max(bodyBase, syminfo.mintick), 0.0) >= 0.60 and
     close <= high - barRange * 0.42 and
     (
         nearResistance or
         nearCurrentSessionHigh or
         nearRelayHigh or
         nearTrueUpperPool
     ) and
     not falseBreakoutRiskSell and
     sellConfluenceScore >= sellConfluenceReadyThEff - 0.22 and
     sellFinalScore >= buyFinalScore - 0.10 and
     (
         sellEngineAgreement >= 0.0 or
         bearTrapStrict or
         strongLiquiditySell
     ) and
     (
         sellConfluenceStrong or
         sellPremiumReady or
         bearTrapStrict or
         strongResistanceRejection
     )

bool buyBuildCandidate =
     not buyHardInvalidation and
     (buyCandidate or earlyBuildBuy or buyTrapFastLane) and
     not (sellConfluenceStrong and sellFinalScore > buyFinalScore + (buyTrapFastLane ? 0.95 : 0.80)) and
     (
         buyPremiumReady or
         buyInstitutionalRejection or
         buyConfluenceReady or
         buyTrapFastLane or
         (
             buyConfluenceStrong and
             buySeedLocationScore >= 0.89 and
             (
                 buySetupType == SETUP_RECLAIM or
                 bullTrapStrict or
                 strongLiquidityBuy
             )
         )
     )

bool sellBuildCandidate =
     not sellHardInvalidation and
     (sellCandidate or earlyBuildSell or sellTrapFastLane) and
     not (buyConfluenceStrong and buyFinalScore > sellFinalScore + (sellTrapFastLane ? 0.95 : 0.60)) and
     (
         sellPremiumReady or
         sellInstitutionalRejection or
         sellConfluenceReady or
         sellTrapFastLane
     )

bool lmBuySignal  = eliteLiquidityBuy and not eliteLiquidityBuy[1] and (na(lastLmBuyBar) or bar_index - lastLmBuyBar > LM_COOLDOWN_BARS)
bool lmSellSignal = eliteLiquiditySell and not eliteLiquiditySell[1] and (na(lastLmSellBar) or bar_index - lastLmSellBar > LM_COOLDOWN_BARS)

if preBuySignal
    lastPreBuyBar := bar_index
if preSellSignal
    lastPreSellBar := bar_index
if lmBuySignal
    lastLmBuyBar := bar_index
if lmSellSignal
    lastLmSellBar := bar_index


//======================================================
// SNAPSHOT EXPORT FOR DEL 3
//======================================================
var bool   d2_snapshotActive      = false
var int    d2_snapshotSide        = 0
var int    d2_snapshotSetupType   = SETUP_NONE
var int    d2_snapshotIntent      = INTENT_NONE
var int    d2_snapshotExecMode    = EXEC_MODE_SKIP

var float  d2_snapshotScore       = na
var string d2_snapshotGrade       = ""
var string d2_snapshotConf        = ""
var string d2_snapshotZoneTxt     = ""
var string d2_snapshotRegimeTxt   = ""

var float d2_snapshotBuyConfl     = na
var float d2_snapshotSellConfl    = na
var float d2_snapshotSessionBias  = na


if not pendingActive and not tradeActive and not preBuyBase and not preSellBase and not buyBuildCandidate and not sellBuildCandidate
    d2_snapshotActive      := false
    d2_snapshotSide        := 0
    d2_snapshotSetupType   := SETUP_NONE
    d2_snapshotIntent      := INTENT_NONE
    d2_snapshotExecMode    := EXEC_MODE_SKIP
    d2_snapshotScore       := na
    d2_snapshotGrade       := ""
    d2_snapshotConf        := ""
    d2_snapshotZoneTxt     := ""
    d2_snapshotRegimeTxt   := ""
    d2_snapshotBuyConfl    := na
    d2_snapshotSellConfl   := na
    d2_snapshotSessionBias := na

bool d2_killBuySnapshot =
     d2_snapshotActive and
     d2_snapshotSide == SIDE_BUY and
     (
         buyHardInvalidation or
         (preSellSignal and sellFinalScore > buyFinalScore + 0.35) or
         (sellBuildCandidate and sellFinalScore > buyFinalScore + 0.45) or
         (sellConfluenceStrong and sellFinalScore > buyFinalScore + 0.80)
     )

bool d2_killSellSnapshot =
     d2_snapshotActive and
     d2_snapshotSide == SIDE_SELL and
     (
         sellHardInvalidation or
         (preBuySignal and buyFinalScore > sellFinalScore + 0.45) or
         (buyBuildCandidate and buyFinalScore > sellFinalScore + 0.45) or
         (buyConfluenceStrong and buyFinalScore > sellFinalScore + 0.60)
     )

if d2_killBuySnapshot or d2_killSellSnapshot
    d2_snapshotActive      := false
    d2_snapshotSide        := 0
    d2_snapshotSetupType   := SETUP_NONE
    d2_snapshotIntent      := INTENT_NONE
    d2_snapshotExecMode    := EXEC_MODE_SKIP
    d2_snapshotScore       := na
    d2_snapshotGrade       := ""
    d2_snapshotConf        := ""
    d2_snapshotZoneTxt     := ""
    d2_snapshotRegimeTxt   := ""
    d2_snapshotBuyConfl    := na
    d2_snapshotSellConfl   := na
    d2_snapshotSessionBias := na

bool d2_buyFreezeCandidate =
     not buyHardInvalidation and
     (
         preBuySignal or
         preBuyBuildStart or
         buyBuildCandidate or
         buySeedSoft
     ) and
     buyPermission and
     buySetupType != SETUP_NONE and
     buyConfluenceScore >= 1.35 and
     buyFinalScore >= preScoreThresholdDynamic - 0.25 and
     not (sellConfluenceStrong and sellFinalScore > buyFinalScore + 0.80)

bool d2_sellFreezeCandidate =
     not sellHardInvalidation and
     (
         preSellSignal or
         preSellBuildStart or
         sellBuildCandidate or
         sellSeedSoft
     ) and
     sellPermission and
     sellSetupType != SETUP_NONE and
     sellConfluenceScore >= 1.35 and
     sellFinalScore >= preScoreThresholdDynamic - 0.25 and
     not (buyConfluenceStrong and buyFinalScore > sellFinalScore + 0.60)

float d2_buyFreezePriority = buyFinalScore
d2_buyFreezePriority += d2_snapshotActive and d2_snapshotSide == SIDE_BUY ? 0.45 : 0.0
d2_buyFreezePriority += buyConfluenceStrong ? 0.18 : buyConfluenceReady ? 0.08 : 0.0
d2_buyFreezePriority += preBuySignal ? 0.14 : 0.0
d2_buyFreezePriority += buyBuildCandidate ? 0.18 : 0.0
d2_buyFreezePriority += buySeedSoft ? 0.05 : 0.0
d2_buyFreezePriority += strongSupportRejection ? 0.25 : 0.0
d2_buyFreezePriority += buyInstitutionalRejection ? 0.45 : 0.0
d2_buyFreezePriority += math.max(buyPremiumQuality, 0.0) * 0.18

float d2_sellFreezePriority = sellFinalScore
d2_sellFreezePriority += d2_snapshotActive and d2_snapshotSide == SIDE_SELL ? 0.45 : 0.0
d2_sellFreezePriority += sellConfluenceStrong ? 0.18 : sellConfluenceReady ? 0.08 : 0.0
d2_sellFreezePriority += preSellSignal ? 0.14 : 0.0
d2_sellFreezePriority += sellBuildCandidate ? 0.18 : 0.0
d2_sellFreezePriority += sellSeedSoft ? 0.05 : 0.0
d2_sellFreezePriority += strongResistanceRejection ? 0.25 : 0.0
d2_sellFreezePriority += sellInstitutionalRejection ? 0.45 : 0.0
d2_sellFreezePriority += math.max(sellPremiumQuality, 0.0) * 0.18

int d2_freezePrioritySide = 0
if d2_buyFreezeCandidate and not d2_sellFreezeCandidate
    d2_freezePrioritySide := SIDE_BUY
else if d2_sellFreezeCandidate and not d2_buyFreezeCandidate
    d2_freezePrioritySide := SIDE_SELL
else if d2_buyFreezeCandidate and d2_sellFreezeCandidate
    d2_freezePrioritySide := d2_buyFreezePriority >= d2_sellFreezePriority ? SIDE_BUY : SIDE_SELL
else
    d2_freezePrioritySide := 0

bool d2_freezeBuyNow =
     d2_freezePrioritySide == SIDE_BUY and
     not d2_snapshotActive

bool d2_freezeSellNow =
     d2_freezePrioritySide == SIDE_SELL and
     not d2_snapshotActive

if d2_freezeBuyNow
    d2_snapshotActive      := true
    d2_snapshotSide        := SIDE_BUY
    d2_snapshotSetupType   := buySetupType
    d2_snapshotIntent      := buyIntent
    d2_snapshotExecMode    := executionModeBuyBase
    d2_snapshotScore       := buyUnifiedScoreAdj
    d2_snapshotGrade       := buyGrade
    d2_snapshotConf        := buyConf
    d2_snapshotZoneTxt     := zoneText(supportZoneQuality)
    d2_snapshotRegimeTxt   := regimeText(regimeCode)
    d2_snapshotBuyConfl    := buyConfluenceScore
    d2_snapshotSellConfl   := sellConfluenceScore
    d2_snapshotSessionBias := sessionBiasScore

if d2_freezeSellNow
    d2_snapshotActive      := true
    d2_snapshotSide        := SIDE_SELL
    d2_snapshotSetupType   := sellSetupType
    d2_snapshotIntent      := sellIntent
    d2_snapshotExecMode    := executionModeSellBase
    d2_snapshotScore       := sellUnifiedScoreAdj
    d2_snapshotGrade       := sellGrade
    d2_snapshotConf        := sellConf
    d2_snapshotZoneTxt     := zoneText(resistanceZoneQuality)
    d2_snapshotRegimeTxt   := regimeText(regimeCode)
    d2_snapshotBuyConfl    := buyConfluenceScore
    d2_snapshotSellConfl   := sellConfluenceScore
    d2_snapshotSessionBias := sessionBiasScore
//======================================================
// DEL 3 - CLEAN REWRITE / FULLY SYNCED + PINE v6 SAFE
//======================================================

//======================================================
// INPUTS - D3 RISK / VISUAL
//======================================================
D3_ENABLE_LEVER_FIRST_ENGINE      = input.bool(true, "D3 Enable Lever First Engine", group="D3 Risk Engine")
D3_DEFAULT_LEVERAGE               = input.float(3.0, "D3 Default Leverage", minval=1.0, step=0.5, group="D3 Risk Engine")
D3_MAX_MARGIN_LOSS_PCT            = input.float(18.0, "D3 Max Margin Loss % Before SL", minval=1.0, maxval=95.0, step=0.5, group="D3 Risk Engine")
D3_LIQUIDATION_BUFFER_PCT         = input.float(25.0, "D3 Liquidation Buffer %", minval=1.0, maxval=90.0, step=0.5, group="D3 Risk Engine")
D3_LEVER_HARD_CAP_LONG            = input.float(3.0, "D3 Long Leverage Hard Cap", minval=1.0, step=0.5, group="D3 Risk Engine")
D3_LEVER_HARD_CAP_SHORT           = input.float(3.0, "D3 Short Leverage Hard Cap", minval=1.0, step=0.5, group="D3 Risk Engine")

D3_SHOW_LM_LP_ONLY_ON_STRONGEST   = input.bool(true, "D3 Show LM/LP Only On Strongest Candles", group="D3 Visual Filters")
D3_LM_LP_MIN_BODY_PCT             = input.float(0.55, "D3 LM/LP Min Body % Of Range", minval=0.10, maxval=0.95, step=0.05, group="D3 Visual Filters")
D3_LM_LP_MIN_ATR_MULT             = input.float(0.80, "D3 LM/LP Min Range vs ATR", minval=0.20, maxval=3.00, step=0.05, group="D3 Visual Filters")
D3_LM_LP_MIN_SCORE                = input.float(7.0, "D3 LM/LP Min Confluence Score", minval=0.0, maxval=10.0, step=0.5, group="D3 Visual Filters")

//======================================================
// EXTRA STATE
//======================================================
var float setupLev           = na
var float setupRiskPct       = na
var float setupMarginLossPct = na
var float setupNotionalRisk  = na
var label regimeInfo         = na

var bool tp1Taken = false
var bool tp2Taken = false
var bool tp3Taken = false
var float setupBEOffsetR = 0.0

//======================================================
// SNAPSHOT-AWARE EFFECTIVE VALUES
//======================================================
bool d3_buySnapLocked  = d2_snapshotActive and d2_snapshotSide == SIDE_BUY
bool d3_sellSnapLocked = d2_snapshotActive and d2_snapshotSide == SIDE_SELL

bool d3_buyLockAlive  = d3_buySnapLocked and not buyHardInvalidation
bool d3_sellLockAlive = d3_sellSnapLocked and not sellHardInvalidation

int buySetupTypeEff  = d3_buySnapLocked ? d2_snapshotSetupType : buySetupType
int sellSetupTypeEff = d3_sellSnapLocked ? d2_snapshotSetupType : sellSetupType

int buyIntentEff  = d3_buySnapLocked ? d2_snapshotIntent : buyIntent
int sellIntentEff = d3_sellSnapLocked ? d2_snapshotIntent : sellIntent

int executionModeBuyEff  = d3_buySnapLocked ? d2_snapshotExecMode : executionModeBuyBase
int executionModeSellEff = d3_sellSnapLocked ? d2_snapshotExecMode : executionModeSellBase

float buyFinalScoreEffRaw  = d3_buySnapLocked ? d2_snapshotScore : buyUnifiedScoreAdj
float sellFinalScoreEffRaw = d3_sellSnapLocked ? d2_snapshotScore : sellUnifiedScoreAdj

float buyConfluenceScoreEff  = d3_buySnapLocked ? d2_snapshotBuyConfl : buyConfluenceScore
float sellConfluenceScoreEff = d3_sellSnapLocked ? d2_snapshotSellConfl : sellConfluenceScore

float buyConfluenceReadyThEffLive  = d3_buySnapLocked ? CONFLUENCE_READY_TH : buyConfluenceReadyThEff
float sellConfluenceReadyThEffLive = d3_sellSnapLocked ? CONFLUENCE_READY_TH : sellConfluenceReadyThEff

float buyConfluenceStrongThEffLive  = d3_buySnapLocked ? CONFLUENCE_STRONG_TH : buyConfluenceStrongThEff
float sellConfluenceStrongThEffLive = d3_sellSnapLocked ? CONFLUENCE_STRONG_TH : sellConfluenceStrongThEff

float buyFinalScoreEff  = buyFinalScoreEffRaw
float sellFinalScoreEff = sellFinalScoreEffRaw

string buyGradeEff  = d3_buySnapLocked ? d2_snapshotGrade : gradeFromScore(buyFinalScoreEff)
string sellGradeEff = d3_sellSnapLocked ? d2_snapshotGrade : gradeFromScore(sellFinalScoreEff)

string buyConfEff  = d3_buySnapLocked ? d2_snapshotConf : confFromScore(buyFinalScoreEff)
string sellConfEff = d3_sellSnapLocked ? d2_snapshotConf : confFromScore(sellFinalScoreEff)

string buyZoneTxtEff  = d3_buySnapLocked ? d2_snapshotZoneTxt : zoneText(supportZoneQuality)
string sellZoneTxtEff = d3_sellSnapLocked ? d2_snapshotZoneTxt : zoneText(resistanceZoneQuality)

string buyRegimeTxtEff  = d3_buySnapLocked ? d2_snapshotRegimeTxt : regimeText(regimeCode)
string sellRegimeTxtEff = d3_sellSnapLocked ? d2_snapshotRegimeTxt : regimeText(regimeCode)

bool buyConfluenceReadyEff  = buyConfluenceScoreEff >= buyConfluenceReadyThEffLive
bool sellConfluenceReadyEff = sellConfluenceScoreEff >= sellConfluenceReadyThEffLive

bool buyConfluenceStrongEff  = buyConfluenceScoreEff >= buyConfluenceStrongThEffLive
bool sellConfluenceStrongEff = sellConfluenceScoreEff >= sellConfluenceStrongThEffLive

float sessionBiasEff = d2_snapshotActive ? d2_snapshotSessionBias : sessionBiasScore

//======================================================
// LIFECYCLE CONTROL
//======================================================
int d3_setupLifeBars = na(setupBar) ? 0 : math.max(0, bar_index - setupBar)

bool d3_decay =
     pendingActive and
     not tradeActive and
     d3_setupLifeBars >= math.max(4, int(math.floor(PENDING_MAX_BARS * 0.45))) and
     (
         (
             setupSide == SIDE_BUY and
             close <= nz(setupEntry, close) + atrValue * 0.04 and
             sellFinalScoreEff > buyFinalScoreEff + 0.30 and
             (sellConfluenceStrong or strongResistanceRejection)
         ) or
         (
             setupSide == SIDE_SELL and
             close >= nz(setupEntry, close) - atrValue * 0.04 and
             buyFinalScoreEff > sellFinalScoreEff + 0.30 and
             (buyConfluenceStrong or strongSupportRejection)
         )
     )

bool d3_kill =
     pendingActive and
     not tradeActive and
     (
         d3_decay or
         (
             setupSide == SIDE_BUY and
             sellFinalScoreEff > buyFinalScoreEff + 0.75 and
             sellConfluenceStrong
         ) or
         (
             setupSide == SIDE_SELL and
             buyFinalScoreEff > sellFinalScoreEff + 0.75 and
             buyConfluenceStrong
         )
     )

//======================================================
// HELPERS
//======================================================
d3_clamp(float v, float lo, float hi) =>
    math.max(lo, math.min(hi, v))

d3_safeDiv(float num, float den) =>
    den == 0.0 ? na : num / den

d3_priceRiskPctLong(float entryPrice, float stopPrice) =>
    d3_safeDiv(entryPrice - stopPrice, entryPrice) * 100.0

d3_priceRiskPctShort(float entryPrice, float stopPrice) =>
    d3_safeDiv(stopPrice - entryPrice, entryPrice) * 100.0

d3_marginLossPct(float priceRiskPct, float lev) =>
    priceRiskPct * lev

d3_maxPriceRiskPctFromLev(float lev, float maxMarginLossPct) =>
    lev > 0 ? maxMarginLossPct / lev : na

d3_approxLiqDistPct(float lev) =>
    lev > 0 ? 100.0 / lev : na

d3_safeMaxRiskPctFromLiq(float lev, float liqBufferPct) =>
    float liqDist = d3_approxLiqDistPct(lev)
    na(liqDist) ? na : liqDist * (1.0 - liqBufferPct / 100.0)

d3_finalMaxRiskPct(float lev, float maxMarginLossPct, float liqBufferPct) =>
    float riskByMargin = d3_maxPriceRiskPctFromLev(lev, maxMarginLossPct)
    float riskByLiq    = d3_safeMaxRiskPctFromLiq(lev, liqBufferPct)
    na(riskByMargin) ? riskByLiq : na(riskByLiq) ? riskByMargin : math.min(riskByMargin, riskByLiq)

d3_riskDistFromPct(float entryPrice, float riskPct) =>
    entryPrice * (riskPct / 100.0)

d3_resolveLeverage(int side, int setupType, bool is5mTf) =>
    // INGREPP 1: confidence/score styr INTE storlek. Kontext kan bara SANKA havstang.
    float lev = D3_DEFAULT_LEVERAGE
    lev += setupType == SETUP_SWEEP          ? -1.0 : 0.0
    lev += setupType == SETUP_LIQUIDITY_TRAP ? -1.5 : 0.0
    lev += setupType == SETUP_REVERSAL       ? -0.8 : 0.0
    lev += is5mTf                   ? -0.5 : 0.0
    lev += volatilityExpansionReady ? -1.0 : 0.0
    lev += microRangeActive         ? -1.0 : 0.0
    lev += coinVeryCrowdedMarket    ? -1.0 : 0.0
    d3_clamp(lev, 1.0, side == SIDE_BUY ? D3_LEVER_HARD_CAP_LONG : D3_LEVER_HARD_CAP_SHORT)

d3_signalColorBySideAndScore(int side, float score) =>
    color out = color.white
    if side == SIDE_BUY
        if score >= 9.0
            out := color.new(color.lime, 0)
        else if score >= 7.0
            out := color.new(color.green, 0)
        else
            out := color.new(color.aqua, 0)
    else
        if score >= 9.0
            out := color.new(color.red, 0)
        else if score >= 7.0
            out := color.new(color.maroon, 0)
        else
            out := color.new(color.orange, 0)
    out

d3_confluenceTextBySide(int side, float v) =>
    float readyTh = side == SIDE_BUY ? buyConfluenceReadyThEffLive : sellConfluenceReadyThEffLive
    float strongTh = side == SIDE_BUY ? buyConfluenceStrongThEffLive : sellConfluenceStrongThEffLive
    string txt = "LOW"
    if v >= strongTh
        txt := "STRONG"
    else if v >= readyTh
        txt := "READY"
    else if v >= readyTh - 0.65
        txt := "BUILD"
    txt

d3_confText(int side) =>
    d3_confluenceTextBySide(side, side == SIDE_BUY ? buyConfluenceScoreEff : sellConfluenceScoreEff)

d3_confScore(int side) =>
    side == SIDE_BUY ? buyConfluenceScoreEff : sellConfluenceScoreEff

d3_aiText(int side) =>
    side == SIDE_BUY ? buyConfEff : sellConfEff

d3_clearVisuals() =>
    clearLine(entryLine)
    clearLine(slLine)
    clearLine(tp1Line)
    clearLine(tp2Line)
    clearLine(tp3Line)
    clearLabel(sigLbl)
    clearLabel(infoLbl)
    clearLabel(entryLbl)
    clearLabel(slLbl)
    clearLabel(tp1Lbl)
    clearLabel(tp2Lbl)
    clearLabel(tp3Lbl)

d3_buildInfoText(int side, int state) =>
    string txt = ""
    txt := "State: " + statusTextMain(state)
    txt += " | Side: " + (side == SIDE_BUY ? "BUY" : "SELL")
    txt += " | Type: " + setupTypeTxt
    txt += " | Intent: " + setupIntentTxt
    txt += " | Regime: " + setupRegimeTxt
    txt += " | Zone: " + setupZoneTxt
    txt += " | Score: " + str.tostring(setupScore, "#.0")
    txt += " | Confl: " + d3_confText(side) + " " + str.tostring(d3_confScore(side), "#.1")
    txt += " | AI: " + d3_aiText(side)
    txt += " | Sync: " + str.tostring(side == SIDE_BUY ? buyEngineAgreement : sellEngineAgreement, "#.2")
    txt += " | Lev: " + (na(setupLev) ? "na" : str.tostring(setupLev, "#.0"))
    txt += " | Risk%: " + (na(setupRiskPct) ? "na" : str.tostring(setupRiskPct, "#.00"))
    txt += " | MLoss%: " + (na(setupMarginLossPct) ? "na" : str.tostring(setupMarginLossPct, "#.0"))
    txt += " | Coin: " + coinProfileText(coinProfileCode)
    txt += " | DNA: " + coinDnaText(coinDnaCode)
    txt += " | Struct: " + marketStructureText(marketMemoryBias)
    txt += " | HTF: " + marketStructureText(htfStructureBias)
    txt += " | Path: " + liquidityPathText(liquidityPathBias, liquidityPathStrength)
    txt += " | Whale: " + whaleText(whaleBias)
    txt += " | FB: " + falseBreakoutText(falseBreakoutRiskBuy, falseBreakoutRiskSell)
    txt

d3_buildRegimeInfoText() =>
    string txt = ""
    txt := "Regime: " + regimeText(regimeCode) + " " + str.tostring(regimeConfidence, "#.2")
    txt += " | Bias: " + (trendUpBasic ? "UP" : trendDownBasic ? "DOWN" : "NEUTRAL")
    txt += " | Session: " + currentSessionNameRef
    txt += " | Relay: " + (relaySource == "" ? "NONE" : relaySource + " H/L")
    txt += " | Liq B " + str.tostring(liquidityScoreBuy, "#.1")
    txt += " | Liq S " + str.tostring(liquidityScoreSell, "#.1")
    txt += " | State " + statusTextMain(setupStatus)
    txt += " | Type " + setupTypeTxt
    txt += " | Lev " + (na(setupLev) ? "na" : str.tostring(setupLev, "#.0"))
    txt += " | Risk% " + (na(setupRiskPct) ? "na" : str.tostring(setupRiskPct, "#.00"))
    txt += " | MLoss% " + (na(setupMarginLossPct) ? "na" : str.tostring(setupMarginLossPct, "#.0"))
    txt += " | Space " + str.tostring(adaptiveSpaceMult, "#.00")
    txt += " | Coin " + coinProfileText(coinProfileCode)
    txt += " | DNA " + coinDnaText(coinDnaCode)
    txt += " | Struct " + marketStructureText(marketMemoryBias)
    txt += " | HTF " + marketStructureText(htfStructureBias)
    txt += " | Crowd " + str.tostring(zoneCrowdingScore, "#.0")
    txt += " | Regime " + regimeText(regimeCode) + " conf " + str.tostring(regimeConfidence, "#.1")
    txt += " | Micro " + (microRangeActive ? "ON" : "OFF")
    txt += " | VolExp " + (volatilityExpansionReady ? "READY" : "OFF") + " " + str.tostring(volExpScore, "#.1")
    txt += " | PreSweep " + preSweepText(preSweepBias) + " | VWAP " + str.tostring(sessionVwap, format.mintick) + (priceAboveVwap ? " ^" : priceBelowVwap ? " v" : " =")
    txt += " | Path " + liquidityPathText(liquidityPathBias, liquidityPathStrength)
    txt += " | Whale " + whaleText(whaleBias)
    txt += " | FB " + falseBreakoutText(falseBreakoutRiskBuy, falseBreakoutRiskSell)
    txt += " | SessBias " + sessionBiasText(sessionBiasEff) + " " + str.tostring(sessionBiasEff, "#.2")
    txt += " | Confl B " + d3_confText(SIDE_BUY) + " " + str.tostring(buyConfluenceScoreEff, "#.1")
    txt += " | Confl S " + d3_confText(SIDE_SELL) + " " + str.tostring(sellConfluenceScoreEff, "#.1")
    txt += " | AI B " + buyConfEff + " | AI S " + sellConfEff
    txt

//======================================================
// TIMEOUT RESET
//======================================================
bool d3_pendingTooOld =
     pendingActive and
     not tradeActive and
     not na(setupBar) and
     (
         (bar_index - setupBar > PENDING_MAX_BARS) or
         (d3_decay and d3_setupLifeBars > math.max(5, int(math.floor(PENDING_MAX_BARS * 0.70))))
     )

bool d3_activeTooOld =
     tradeActive and
     not na(setupBar) and
     (bar_index - setupBar > ACTIVE_MAX_BARS)


if d3_pendingTooOld or d3_activeTooOld
    d3_clearVisuals()

    d2_snapshotActive      := false
    d2_snapshotSide        := 0
    d2_snapshotSetupType   := SETUP_NONE
    d2_snapshotIntent      := INTENT_NONE
    d2_snapshotExecMode    := EXEC_MODE_SKIP
    d2_snapshotScore       := na
    d2_snapshotGrade       := ""
    d2_snapshotConf        := ""
    d2_snapshotZoneTxt     := ""
    d2_snapshotRegimeTxt   := ""
    d2_snapshotBuyConfl    := na
    d2_snapshotSellConfl   := na
    d2_snapshotSessionBias := na

    pendingActive := false
    tradeActive := false
    movedToBE := false
    tp1Taken := false
    tp2Taken := false
    tp3Taken := false

    setupSide := 0
    setupBar := na
    setupStatus := STATUS_NONE

    setupEntry := na
    setupSL := na
    setupTP1 := na
    setupTP2 := na
    setupTP3 := na
    setupScore := na

    setupGrade := ""
    setupConf := ""
    setupIntentTxt := ""
    setupZoneTxt := ""
    setupRegimeTxt := ""
    setupTypeTxt := ""

    setupLev := na
    setupRiskPct := na
    setupMarginLossPct := na
    setupNotionalRisk := na
    setupBEOffsetR := 0.0

//======================================================
// PRIORITY / DOMINANCE
//======================================================
bool buyStrongPreBuild =
     preBuyBase and
     buyPermission and
     buySetupTypeEff != SETUP_NONE and
     (
         buyConfluenceScoreEff >= 1.45 or
         (
             buyConfluenceStrong and
             buySeedLocationScore >= 0.94 and
             (
                 buySetupTypeEff == SETUP_RECLAIM or
                 bullTrapStrict or
                 strongLiquidityBuy or
                 buyBreakAntStrong
             ) and
             (
                 (
                     close > open and
                     close >= high - barRange * 0.35
                 ) or
                 (
                     volatilityExpansionReady and
                     close > open and
                     bodyBase >= atrValue * 0.10 and
                     close >= high - barRange * 0.22
                 )
             ) and
             buyConfluenceScoreEff >= 1.32
         )
     ) and
     (
         buyFinalScoreEff >= preScoreThresholdDynamic - 0.20 or
         (
             buyConfluenceStrong and
             buySeedLocationScore >= 0.94 and
             (
                 buySetupTypeEff == SETUP_RECLAIM or
                 bullTrapStrict or
                 strongLiquidityBuy
             ) and
             buyFinalScoreEff >= preScoreThresholdDynamic - 0.28
         )
     )

bool sellStrongPreBuild =
     preSellBase and
     sellPermission and
     sellSetupTypeEff != SETUP_NONE and
     (
         sellConfluenceScoreEff >= 1.45 or
         (
             sellConfluenceStrong and
             sellSeedLocationScore >= 0.94 and
             (
                 sellSetupTypeEff == SETUP_RECLAIM or
                 bearTrapStrict or
                 strongLiquiditySell or
                 sellBreakAntStrong
             ) and
             (
                 (
                     close < open and
                     close <= low + barRange * 0.35
                 ) or
                 (
                     volatilityExpansionReady and
                     close < open and
                     bodyBase >= atrValue * 0.10 and
                     close <= low + barRange * 0.22
                 )
             ) and
             sellConfluenceScoreEff >= 1.32
         )
     ) and
     (
         sellFinalScoreEff >= preScoreThresholdDynamic - 0.20 or
         (
             sellConfluenceStrong and
             sellSeedLocationScore >= 0.94 and
             (
                 sellSetupTypeEff == SETUP_RECLAIM or
                 bearTrapStrict or
                 strongLiquiditySell or
                 sellBreakAntStrong
             ) and
             sellFinalScoreEff >= preScoreThresholdDynamic - 0.28
         )
     )

bool buyDominant =
     strongSupportRejection ? (buyFinalScoreEff >= sellFinalScoreEff + 0.35) :
     (
         (
             buyConfluenceStrong and
             buySeedLocationScore >= 0.94 and
             (
                 buySetupTypeEff == SETUP_RECLAIM or
                 bullTrapStrict or
                 strongLiquidityBuy or
                 buyBreakAntStrong
             ) and
             (
                 (
                     close > open and
                     close >= high - barRange * 0.35
                 ) or
                 (
                     volatilityExpansionReady and
                     close > open and
                     bodyBase >= atrValue * 0.10 and
                     close >= high - barRange * 0.22
                 )
             )
         ) ?
         (buyFinalScoreEff > sellFinalScoreEff + 0.18) :
         (buyFinalScoreEff > sellFinalScoreEff + 0.65)
     )

bool sellDominant =
     strongResistanceRejection ? (sellFinalScoreEff >= buyFinalScoreEff + 0.20) :
     (
         (
             sellConfluenceStrong and
             sellSeedLocationScore >= 0.94 and
             (
                 sellSetupTypeEff == SETUP_RECLAIM or
                 bearTrapStrict or
                 strongLiquiditySell or
                 sellBreakAntStrong
             ) and
             (
                 (
                     close < open and
                     close <= low + barRange * 0.35
                 ) or
                 (
                     volatilityExpansionReady and
                     close < open and
                     bodyBase >= atrValue * 0.10 and
                     close <= low + barRange * 0.22
                 )
             )
         ) ?
         (sellFinalScoreEff > buyFinalScoreEff + 0.28) :
         (sellFinalScoreEff > buyFinalScoreEff + 0.80)
     )

int buyBreakoutConfirmCount =
     (smartBreakoutReadyBuy ? 1 : 0) +
     (sessionBreakoutPressureBuyRef ? 1 : 0) +
     (buyBreakAntEarly ? 1 : 0)

int sellBreakoutConfirmCount =
     (smartBreakdownReadySell ? 1 : 0) +
     (sessionBreakoutPressureSellRef ? 1 : 0) +
     (sellBreakAntEarly ? 1 : 0)

bool buyBreakoutStrong  = buyBreakoutConfirmCount >= 2
bool sellBreakoutStrong = sellBreakoutConfirmCount >= 2

bool buyBreakoutOk =
     buySetupTypeEff != SETUP_BREAKOUT_BUILD or buyBreakoutStrong

bool sellBreakoutOk =
     sellSetupTypeEff != SETUP_BREAKOUT_BUILD or sellBreakoutStrong

bool buyBuildNow =
     (buyBuildCandidate or buyStrongPreBuild or buySeedSoft) and
     (
         buyDominant or
         buyTrapFastLane
     ) and
     buyBreakoutOk and
     (
         d3_buyLockAlive or
         strongSupportRejection or
         buyTrapFastLane or
         (
             buyConfluenceStrong and
             buySeedLocationScore >= 0.94 and
             (
                 buySetupTypeEff == SETUP_RECLAIM or
                 bullTrapStrict or
                 strongLiquidityBuy or
                 buyBreakAntStrong
             ) and
             (
                 volatilityExpansionReady or
                 close >= high - barRange * 0.28
             ) and
             buyFinalScoreEff >= sellFinalScoreEff + 0.15
         ) or
         not (sellBuildCandidate or sellStrongPreBuild or sellSeedSoft) or
         buyFinalScoreEff >= sellFinalScoreEff + (buyTrapFastLane ? 0.05 : 0.35)
     )

bool sellBuildNow =
     (sellBuildCandidate or sellStrongPreBuild or sellSeedSoft) and
     (
         sellDominant or
         sellTrapFastLane
     ) and
     sellBreakoutOk and
     not (regimeCode == REGIME_TREND_UP and htfStructureBias == 1 and not strongResistanceRejection and not bearTrapStrict) and
     (
         d3_sellLockAlive or
         strongResistanceRejection or
         sellTrapFastLane or
         not (buyBuildCandidate or buyStrongPreBuild or buySeedSoft) or
         sellFinalScoreEff >= buyFinalScoreEff + (sellTrapFastLane ? 0.05 : 0.35)
     )

bool preBuyNow =
     preBuySignal and
     (
         d3_buyLockAlive or
         strongSupportRejection or
         (
             buyConfluenceStrong and
             buySeedLocationScore >= 0.94 and
             (
                 buySetupTypeEff == SETUP_RECLAIM or
                 bullTrapStrict or
                 strongLiquidityBuy or
                 buyBreakAntStrong
             ) and
             (
                 volatilityExpansionReady or
                 close >= high - barRange * 0.28
             ) and
             buyFinalScoreEff >= sellFinalScoreEff + 0.15
         ) or
         not preSellSignal or
         buyFinalScoreEff >= sellFinalScoreEff + 0.35
     )

bool preSellNow =
     preSellSignal and
     (
         d3_sellLockAlive or
         (
             strongResistanceRejection and
             sellFinalScoreEff >= buyFinalScoreEff + 0.20
         ) or
         (
             not preBuySignal and
             sellFinalScoreEff >= buyFinalScoreEff + 0.20
         ) or
         sellFinalScoreEff >= buyFinalScoreEff + 0.45
     )

//======================================================
// PENDING INVALIDATION RESET
//======================================================
bool d3_killPendingBuy =
     pendingActive and
     not tradeActive and
     setupSide == SIDE_BUY and
     (
         d3_kill or
         buyHardInvalidation or
         (
             sellBuildNow and
             sellFinalScoreEff > buyFinalScoreEff + 0.50
         ) or
         (
             preSellNow and
             strongResistanceRejection and
             sellFinalScoreEff > buyFinalScoreEff + 0.25
         ) or
         (not d3_buyLockAlive and not preBuyBase and not buyBuildCandidate and not buySeedSoft)
     )

bool d3_killPendingSell =
     pendingActive and
     not tradeActive and
     setupSide == SIDE_SELL and
     (
         d3_kill or
         sellHardInvalidation or
         (
             buyBuildNow and
             buyFinalScoreEff > sellFinalScoreEff + 0.50
         ) or
         (
             preBuyNow and
             strongSupportRejection and
             buyFinalScoreEff > sellFinalScoreEff + 0.25
         ) or
         (not d3_sellLockAlive and not preSellBase and not sellBuildCandidate and not sellSeedSoft)
     )

if barstate.isconfirmed and (d3_killPendingBuy or d3_killPendingSell)
    d3_clearVisuals()

    pendingActive := false
    tradeActive := false
    movedToBE := false
    tp1Taken := false
    tp2Taken := false
    tp3Taken := false

    setupSide := 0
    setupBar := na
    setupStatus := STATUS_NONE

    setupEntry := na
    setupSL := na
    setupTP1 := na
    setupTP2 := na
    setupTP3 := na
    setupScore := na

    setupGrade := ""
    setupConf := ""
    setupIntentTxt := ""
    setupZoneTxt := ""
    setupRegimeTxt := ""
    setupTypeTxt := ""

    setupLev := na
    setupRiskPct := na
    setupMarginLossPct := na
    setupNotionalRisk := na
    setupBEOffsetR := 0.0

//======================================================
// LM / LP STRONG CANDLE FILTER
//======================================================
float d3_lmLpBody    = math.abs(close - open)
float d3_lmLpRange   = math.max(high - low, syminfo.mintick)
float d3_lmLpBodyPct = d3_lmLpBody / d3_lmLpRange
bool d3_lmLpBigRange = d3_lmLpRange >= atrValue * D3_LM_LP_MIN_ATR_MULT

bool strongBullLmLpCandle =
     close > open and
     d3_lmLpBodyPct >= D3_LM_LP_MIN_BODY_PCT and
     d3_lmLpBigRange and
     buyConfluenceScoreEff >= D3_LM_LP_MIN_SCORE

bool strongBearLmLpCandle =
     close < open and
     d3_lmLpBodyPct >= D3_LM_LP_MIN_BODY_PCT and
     d3_lmLpBigRange and
     sellConfluenceScoreEff >= D3_LM_LP_MIN_SCORE

bool showLpBuyStrong =
     ENABLE_LIQUIDITY_PATH_ENGINE and
     liquidityPathBias == -1 and
     liquidityPathStrength >= LIQ_PATH_STRONG_TH and
     barstate.isconfirmed and
     (not D3_SHOW_LM_LP_ONLY_ON_STRONGEST or strongBullLmLpCandle)

bool showLpSellStrong =
     ENABLE_LIQUIDITY_PATH_ENGINE and
     liquidityPathBias == 1 and
     liquidityPathStrength >= LIQ_PATH_STRONG_TH and
     barstate.isconfirmed and
     (not D3_SHOW_LM_LP_ONLY_ON_STRONGEST or strongBearLmLpCandle)

bool showLmBuyStrong =
     lmBuySignal and
     barstate.isconfirmed and
     (not D3_SHOW_LM_LP_ONLY_ON_STRONGEST or strongBullLmLpCandle)

bool showLmSellStrong =
     lmSellSignal and
     barstate.isconfirmed and
     (not D3_SHOW_LM_LP_ONLY_ON_STRONGEST or strongBearLmLpCandle)

//======================================================
// BUY BUILDER
//======================================================
d3_buildBuySetup() =>
    bool validBuy = false
    float entryBuy = na
    float slBuy = na
    float tp1Buy = na
    float tp2Buy = na
    float tp3Buy = na
    float levBuy = na
    float buyRiskPct = na
    float buyMarginLossPct = na
    float riskBuy = na
    int candidateSetupTypeBuy = buySetupTypeEff

    bool buyIsTrendContinuation =
         candidateSetupTypeBuy == SETUP_CONTINUATION or
         candidateSetupTypeBuy == SETUP_BREAKOUT_BUILD

    bool buyNeedsRelaxedBuild =
         candidateSetupTypeBuy == SETUP_BREAKOUT_BUILD or
         candidateSetupTypeBuy == SETUP_CONTINUATION or
         candidateSetupTypeBuy == SETUP_SWEEP or
         candidateSetupTypeBuy == SETUP_LIQUIDITY_TRAP or
         candidateSetupTypeBuy == SETUP_REVERSAL

    bool useEarlyBuyBuild =
         earlyBuildBuy and
         (
             not buyCandidate or
             buyIsTrendContinuation or
             buySeedSoft or
             strongSupportRejection
         )

    float earlyBuildQualityBuy = 0.0
    earlyBuildQualityBuy += useEarlyBuyBuild ? 0.25 : 0.0
    earlyBuildQualityBuy += buySeedSoft ? 0.10 : 0.0
    earlyBuildQualityBuy += buyConfluenceStrongEff ? 0.25 : buyConfluenceReadyEff ? 0.12 : 0.0
    earlyBuildQualityBuy += math.max(sessionBiasEff, 0.0) * EARLY_BUILD_SESSION_BOOST
    earlyBuildQualityBuy += liquidityPathBias == -1 ? EARLY_BUILD_PATH_BOOST : 0.0
    earlyBuildQualityBuy += sessionReclaimBuyRef ? 0.12 : 0.0
    earlyBuildQualityBuy += sessionBreakoutPressureBuyRef ? 0.10 : 0.0
    earlyBuildQualityBuy += strongSupportRejection ? 0.18 : 0.0

    int executionModeBuy = executionModeBuyEff

    float entryBuyBase =
         strongSupportRejection ? math.max(close, close + barRange * 0.02) :
         (candidateSetupTypeBuy == SETUP_SWEEP or candidateSetupTypeBuy == SETUP_LIQUIDITY_TRAP) ?
         math.max(close, close - barRange * 0.02) :
         candidateSetupTypeBuy == SETUP_BREAKOUT_BUILD ?
         math.max(close, nz(currentSessionHighRef, nz(prevSessionHighRef, high - barRange * 0.12))) :
         useEarlyBuyBuild ?
         math.max(close, high - barRange * 0.34) :
         math.max(close, high - barRange * 0.20)

    float entryBuyBuffer =
         strongSupportRejection ? activeEntryBufferBuy * 0.35 :
         candidateSetupTypeBuy == SETUP_BREAKOUT_BUILD ? activeEntryBufferBuy * 0.55 :
         candidateSetupTypeBuy == SETUP_CONTINUATION ? activeEntryBufferBuy * 0.55 :
         useEarlyBuyBuild ? activeEntryBufferBuy * math.max(0.50, EARLY_ENTRY_BUFFER_MULT - math.min(earlyBuildQualityBuy * 0.10, 0.20)) :
         activeEntryBufferBuy

    entryBuy := entryBuyBase + entryBuyBuffer

    float scorePadBuy   = buyFinalScoreEff >= 9 ? atrValue * 0.08 : buyFinalScoreEff >= 6.8 ? atrValue * 0.05 : atrValue * 0.02
    float profilePadBuy = wickinessScore > 1.20 ? atrValue * 0.05 : 0.0
    float fakeoutPadBuy = fakeoutScore > 0.35 ? atrValue * 0.04 : 0.0

    float liquidityPadBuy = 0.0
    liquidityPadBuy += bullTrap ? atrValue * 0.08 : 0.0
    liquidityPadBuy += bullTrapEarly ? atrValue * 0.06 : 0.0
    liquidityPadBuy += bullTrapStrict ? atrValue * 0.08 : 0.0
    liquidityPadBuy += bullSweep ? atrValue * 0.09 : 0.0
    liquidityPadBuy += lsBuyStrict ? atrValue * 0.08 : 0.0
    liquidityPadBuy += strongLiquidityBuy ? atrValue * 0.06 : 0.0
    liquidityPadBuy += trapBuy ? atrValue * 0.06 : 0.0
    liquidityPadBuy += hiddenLiquidityBuy ? atrValue * 0.05 : 0.0
    liquidityPadBuy += sessionReclaimBuyRef ? atrValue * 0.08 : 0.0
    liquidityPadBuy += sessionRejectBuyRef ? atrValue * 0.05 : 0.0
    liquidityPadBuy += softSupportReject ? atrValue * 0.05 : 0.0
    liquidityPadBuy += localFlushBuy ? atrValue * 0.05 : 0.0
    liquidityPadBuy += strongSupportRejection ? atrValue * 0.10 : 0.0
    liquidityPadBuy += tcBuyStrict ? atrValue * 0.03 : 0.0
    liquidityPadBuy += volatilityExpansionReady ? atrValue * 0.03 : 0.0

    float currentLowerWickAtrBuy = safeDiv(lowerWick, math.max(atrValue, syminfo.mintick), 0.0)
    float currentLowerWickBodyBuy = safeDiv(lowerWick, math.max(bodyBase, syminfo.mintick), 0.0)
    float wickAdaptivePadBuy = 0.0
    wickAdaptivePadBuy += currentLowerWickAtrBuy >= 0.30 ? atrValue * 0.03 : 0.0
    wickAdaptivePadBuy += currentLowerWickAtrBuy >= 0.55 ? atrValue * 0.04 : 0.0
    wickAdaptivePadBuy += currentLowerWickBodyBuy >= 1.20 ? atrValue * 0.03 : 0.0
    wickAdaptivePadBuy += currentLowerWickBodyBuy >= 1.80 ? atrValue * 0.03 : 0.0

    float executionStopMultBuy =
         strongSupportRejection or buyInstitutionalRejection ? 1.00 :
         executionModeBuy == EXEC_MODE_CONT ? 0.74 :
         executionModeBuy == EXEC_MODE_RECLAIM ? 0.90 :
         executionModeBuy == EXEC_MODE_SWEEP ? 1.02 :
         executionModeBuy == EXEC_MODE_BREAKOUT ? 0.86 : 0.86

    float stopPadBuy = (adaptiveStopPad + scorePadBuy + profilePadBuy + fakeoutPadBuy + liquidityPadBuy + wickAdaptivePadBuy) * executionStopMultBuy
    stopPadBuy := useEarlyBuyBuild ? stopPadBuy * math.max(0.96, EARLY_STOP_PAD_MULT - math.min(earlyBuildQualityBuy * 0.04, 0.10)) : stopPadBuy
    if is15m
        stopPadBuy += atrValue * 0.04

    float wickStopPadBuy = stopPadBuy * (strongSupportRejection or buyInstitutionalRejection ? 0.52 : trapBuy or bullSweep or bullTrapStrict ? 0.60 : 0.58)
    float levelStopPadBuy = stopPadBuy * (strongSupportRejection or buyInstitutionalRejection ? 0.46 : sessionReclaimBuyRef or relaySweepBelow ? 0.50 : 0.52)

    float localStructContBuy    = ta.lowest(low, STRUCT_CONT_LOOKBACK)
    float localStructReclaimBuy = ta.lowest(low, STRUCT_RECLAIM_LOOKBACK)
    float localStructSweepBuy   = ta.lowest(low, STRUCT_SWEEP_LOOKBACK)
    float reclaimLowBuy         = math.min(low, low[1])
    float breakoutBaseBuy       = not na(currentSessionHighRef) ? currentSessionHighRef : not na(prevSessionHighRef) ? prevSessionHighRef : not na(resistanceTop) ? resistanceTop : localStructReclaimBuy

    float wickAnchorBuy = math.min(low, reclaimLowBuy)
    float levelAnchorBuy = maxBelow(entryBuy, currentSessionLowRef, prevSessionLowRef, relayLowRef, supportBottom, supportTop, lastPivotLow, trueLiquidityLow, emaSlow)
    float supportAnchorBuy = maxBelow(entryBuy, supportBottom, currentSessionLowRef, relayLowRef, trueLiquidityLow, prevSessionLowRef, lastPivotLow, emaSlow, float(na))
    float reclaimAnchorBuy = maxBelow(entryBuy, currentSessionLowRef, prevSessionLowRef, relayLowRef, localStructReclaimBuy, reclaimLowBuy, supportBottom, trueLiquidityLow, emaSlow)
    float sweepAnchorBuy = maxBelow(entryBuy, supportBottom, low, localStructSweepBuy, relayLowRef, currentSessionLowRef, trueLiquidityLow, lastPivotLow, emaSlow)
    float breakoutAnchorBuy = maxBelow(entryBuy, currentSessionLowRef, prevSessionLowRef, relayLowRef, supportTop, supportBottom, lastPivotLow, trueLiquidityLow, localStructReclaimBuy)

    float slContBuy     = localStructContBuy - stopPadBuy * 0.42
    float slReclaimBuy  = (na(reclaimAnchorBuy) ? math.min(reclaimLowBuy, localStructReclaimBuy) : reclaimAnchorBuy) - levelStopPadBuy
    float slSweepBuy    = (na(sweepAnchorBuy) ? math.min(low, localStructSweepBuy) : sweepAnchorBuy) - wickStopPadBuy
    float slBreakoutBuy = (na(breakoutAnchorBuy) ? breakoutBaseBuy : breakoutAnchorBuy) - stopPadBuy * 0.38
    float slRejectBuy   = (na(supportAnchorBuy) ? wickAnchorBuy : math.min(wickAnchorBuy, supportAnchorBuy)) - wickStopPadBuy

    float rawSLBuy = na(levelAnchorBuy) ? entryBuy - minRisk : levelAnchorBuy - levelStopPadBuy

    slBuy := rawSLBuy
    if candidateSetupTypeBuy == SETUP_CONTINUATION
        slBuy := math.max(rawSLBuy, slContBuy)
    else if candidateSetupTypeBuy == SETUP_RECLAIM
        slBuy := math.max(rawSLBuy, slReclaimBuy)
    else if candidateSetupTypeBuy == SETUP_REVERSAL
        slBuy := (strongSupportRejection or buyInstitutionalRejection or trapBuy or hiddenLiquidityBuy) ? math.max(rawSLBuy, slRejectBuy) : math.max(rawSLBuy, slReclaimBuy)
    else if candidateSetupTypeBuy == SETUP_SWEEP or candidateSetupTypeBuy == SETUP_LIQUIDITY_TRAP
        slBuy := math.min(rawSLBuy, slSweepBuy)
    else if candidateSetupTypeBuy == SETUP_BREAKOUT_BUILD
        slBuy := math.max(rawSLBuy, slBreakoutBuy)

    if sessionReclaimBuyRef and not na(currentSessionLowRef)
        slBuy := math.max(slBuy, currentSessionLowRef - levelStopPadBuy)
    if relaySweepBelow and not na(relayLowRef)
        slBuy := math.max(slBuy, relayLowRef - levelStopPadBuy)
    if softSupportReject
        slBuy := math.max(slBuy, wickAnchorBuy - stopPadBuy * 0.44)
    if localFlushBuy
        slBuy := math.max(slBuy, wickAnchorBuy - stopPadBuy * 0.52)
    if strongSupportRejection or buyInstitutionalRejection
        slBuy := math.max(slBuy, slRejectBuy)

    float maxSlAtrBuy =
         strongSupportRejection or buyInstitutionalRejection ? (is15m ? 1.20 : 1.32) :
         candidateSetupTypeBuy == SETUP_CONTINUATION ? (is15m ? 1.05 : 1.18) :
         candidateSetupTypeBuy == SETUP_RECLAIM ? (is15m ? 1.24 : 1.38) :
         candidateSetupTypeBuy == SETUP_SWEEP ? (is15m ? 1.34 : 1.48) :
         candidateSetupTypeBuy == SETUP_LIQUIDITY_TRAP ? (is15m ? 1.34 : 1.48) :
         candidateSetupTypeBuy == SETUP_BREAKOUT_BUILD ? (is15m ? 1.14 : 1.28) :
         (is15m ? 1.16 : 1.30)

    if entryBuy - slBuy > atrValue * maxSlAtrBuy
        slBuy := entryBuy - atrValue * maxSlAtrBuy

    if entryBuy - slBuy < minSLDist
        slBuy := entryBuy - minSLDist

    levBuy := d3_resolveLeverage(SIDE_BUY, candidateSetupTypeBuy, is5m)
    float maxRiskPctBuy       = d3_finalMaxRiskPct(levBuy, D3_MAX_MARGIN_LOSS_PCT, D3_LIQUIDATION_BUFFER_PCT)
    float maxRiskDistLeverBuy = d3_riskDistFromPct(entryBuy, maxRiskPctBuy)

    riskBuy := entryBuy - slBuy
    float maxRiskHardBuyAtr = atrValue * (is5m ? 2.4 : 2.2)
    float maxRiskHardBuy    = D3_ENABLE_LEVER_FIRST_ENGINE ? math.min(maxRiskHardBuyAtr, maxRiskDistLeverBuy) : maxRiskHardBuyAtr

    if riskBuy > maxRiskHardBuy
        riskBuy := maxRiskHardBuy
        slBuy := entryBuy - riskBuy

    if riskBuy < minSLDist
        riskBuy := minSLDist
        slBuy := entryBuy - riskBuy

    buyRiskPct       := d3_priceRiskPctLong(entryBuy, slBuy)
    buyMarginLossPct := d3_marginLossPct(buyRiskPct, levBuy)

    float rrBoostBuy = 0.0
    if ENABLE_DYNAMIC_RR_ENGINE
        rrBoostBuy += buyFinalScoreEff >= 9 ? 0.22 : buyFinalScoreEff >= 6.8 ? 0.12 : 0.0
        rrBoostBuy += tcBuyStrict ? 0.10 : 0.0
        rrBoostBuy += bullTrapStrict ? 0.08 : 0.0
        rrBoostBuy += lsBuyStrict ? 0.06 : 0.0
        rrBoostBuy += marketMemoryBias == 1 ? 0.08 : 0.0
        rrBoostBuy += coinDnaCode == COIN_DNA_TREND_DRIVER ? 0.08 : 0.0
        rrBoostBuy += coinDnaCode == COIN_DNA_MOMENTUM_EXPLOSIVE ? 0.10 : 0.0
        rrBoostBuy += nearCurrentSessionLow ? 0.06 : 0.0
        rrBoostBuy += nearRelayLow ? 0.05 : 0.0
        rrBoostBuy += sessionReclaimBuyRef ? 0.08 : 0.0
        rrBoostBuy += strongSupportRejection ? 0.14 : 0.0
        rrBoostBuy += microRangeActive ? -0.10 : 0.0
        rrBoostBuy += coinVeryCrowdedMarket ? -0.12 : 0.0
        rrBoostBuy += htfStructureBias >= 0 ? 0.08 : 0.0
        rrBoostBuy += volatilityExpansionReady ? 0.08 : 0.0
        rrBoostBuy += buyConfluenceStrongEff ? 0.10 : buyConfluenceReadyEff ? 0.04 : 0.0
        rrBoostBuy += math.max(sessionBiasEff, 0.0) * 0.05

    [exitTp1MulBuy, exitTp2MulBuy, exitTp3MulBuy, _] = d3_adaptiveExitProfile(regimeCode, buyIntentEff, candidateSetupTypeBuy, buyFinalScoreEff, strongSupportRejection)

    float rr1Buy = 0.95 + rrBoostBuy
    rr1Buy += regimeCode == REGIME_TREND_UP ? 0.10 : 0.0
    rr1Buy += buyIntentEff == INTENT_EXPANSION ? 0.10 : 0.0
    rr1Buy += buyIntentEff == INTENT_SCALP ? -0.05 : 0.0
    rr1Buy += is15m ? 0.05 : 0.0
    rr1Buy *= exitTp1MulBuy

    float rr1BuyFloor =
         strongSupportRejection ? 0.90 :
         candidateSetupTypeBuy == SETUP_CONTINUATION ? 1.18 :
         candidateSetupTypeBuy == SETUP_RECLAIM ? 1.08 :
         candidateSetupTypeBuy == SETUP_SWEEP ? 1.00 :
         candidateSetupTypeBuy == SETUP_LIQUIDITY_TRAP ? 1.00 :
         candidateSetupTypeBuy == SETUP_BREAKOUT_BUILD ? 1.12 : 0.95

    rr1BuyFloor *= math.min(exitTp1MulBuy, 1.08)
    rr1Buy := math.max(rr1BuyFloor, rr1Buy)

    float rr2Buy = (rr1Buy + 0.65 + math.max(rrBoostBuy * 0.45, 0.0)) * math.max(0.86, math.min(exitTp2MulBuy, 1.35))
    float rr3Buy = (rr2Buy + 0.72 + math.max(rrBoostBuy * 0.55, 0.0)) * math.max(0.84, math.min(exitTp3MulBuy, 1.55))

    float tp1RefBuy             = minAbove(entryBuy, currentSessionHighRef, prevSessionHighRef, relayHighRef, resistanceTop, lastPivotHigh, trueLiquidityHigh, dayHighPrev, weekHighPrev)
    float tp1SessionFallbackBuy = not na(buySessionTargetRef) and buySessionTargetRef > entryBuy ? buySessionTargetRef - tpBuffer : na
    tp1Buy := not na(tp1RefBuy) ? tp1RefBuy - tpBuffer : not na(tp1SessionFallbackBuy) ? tp1SessionFallbackBuy : entryBuy + riskBuy * rr1Buy

    float maxTp1AtrBuy =
         strongSupportRejection ? (is15m ? 2.20 : 2.45) :
         candidateSetupTypeBuy == SETUP_CONTINUATION ? (is15m ? 2.80 : 3.10) :
         candidateSetupTypeBuy == SETUP_RECLAIM ? (is15m ? 2.45 : 2.80) :
         candidateSetupTypeBuy == SETUP_SWEEP ? (is15m ? 2.30 : 2.60) :
         candidateSetupTypeBuy == SETUP_LIQUIDITY_TRAP ? (is15m ? 2.30 : 2.60) :
         candidateSetupTypeBuy == SETUP_BREAKOUT_BUILD ? (is15m ? 2.90 : 3.20) :
         (is15m ? 2.50 : 2.80)

    tp1Buy := math.min(tp1Buy, entryBuy + atrValue * maxTp1AtrBuy)

    bool buyAllowStructuralTp1 =
         candidateSetupTypeBuy == SETUP_BREAKOUT_BUILD or
         candidateSetupTypeBuy == SETUP_CONTINUATION or
         candidateSetupTypeBuy == SETUP_SWEEP or
         candidateSetupTypeBuy == SETUP_LIQUIDITY_TRAP or
         useEarlyBuyBuild or
         strongSupportRejection

    tp1Buy := buyAllowStructuralTp1 ? tp1Buy : math.max(tp1Buy, entryBuy + riskBuy * rr1Buy)

    float rrBuy = (tp1Buy - entryBuy) / math.max(riskBuy, syminfo.mintick * 2)
    float spaceBuy = not na(tp1RefBuy) ? (tp1RefBuy - entryBuy) : (tp1Buy - entryBuy)

    float activeSpaceMultBuy =
         strongSupportRejection ? math.max(0.42, adaptiveSpaceMult * 0.52) :
         buyNeedsRelaxedBuild ? math.max(0.46, adaptiveSpaceMult * 0.60) :
         useEarlyBuyBuild ? adaptiveSpaceMult * math.max(0.74, EARLY_SPACE_RELAX_MULT - math.min(earlyBuildQualityBuy * 0.05, 0.12)) :
         adaptiveSpaceMult

    bool spaceBuyOk =
         strongSupportRejection ?
         (spaceBuy >= riskBuy * activeSpaceMultBuy * 0.72) :
         buyNeedsRelaxedBuild ?
         (spaceBuy >= riskBuy * activeSpaceMultBuy * 0.80) :
         (spaceBuy >= riskBuy * activeSpaceMultBuy and spaceBuy >= adaptiveMinSpaceAbs)

    float institutionalEntryScoreBuy = 0.0
    institutionalEntryScoreBuy += candidateSetupTypeBuy == SETUP_LIQUIDITY_TRAP ? 0.35 : 0.0
    institutionalEntryScoreBuy += candidateSetupTypeBuy == SETUP_SWEEP ? 0.25 : 0.0
    institutionalEntryScoreBuy += candidateSetupTypeBuy == SETUP_RECLAIM ? 0.22 : 0.0
    institutionalEntryScoreBuy += candidateSetupTypeBuy == SETUP_CONTINUATION ? 0.18 : 0.0
    institutionalEntryScoreBuy += nearCurrentSessionLow ? 0.24 : 0.0
    institutionalEntryScoreBuy += nearRelayLow ? 0.22 : 0.0
    institutionalEntryScoreBuy += sessionReclaimBuyRef ? 0.28 : 0.0
    institutionalEntryScoreBuy += sessionBreakoutPressureBuyRef ? 0.20 : 0.0
    institutionalEntryScoreBuy += bullTrap ? 0.50 : 0.0
    institutionalEntryScoreBuy += softBullReclaim ? 0.50 : 0.0
    institutionalEntryScoreBuy += supportZoneQuality >= 2.8 ? 0.40 : 0.0
    institutionalEntryScoreBuy += softSupportReject ? 0.25 : 0.0
    institutionalEntryScoreBuy += localFlushBuy ? 0.20 : 0.0
    institutionalEntryScoreBuy += hiddenLiquidityBuy ? 0.20 : 0.0
    institutionalEntryScoreBuy += strongLiquidityBuy ? 0.30 : 0.0
    institutionalEntryScoreBuy += strongSupportRejection ? 0.52 : 0.0
    institutionalEntryScoreBuy += trapBuy ? 0.25 : 0.0
    institutionalEntryScoreBuy += tcBuyStrict ? 0.25 : 0.0
    institutionalEntryScoreBuy += bullTrapStrict ? 0.25 : 0.0
    institutionalEntryScoreBuy += lsBuyStrict ? 0.18 : 0.0
    institutionalEntryScoreBuy += marketMemoryBias == 1 ? 0.20 : 0.0
    institutionalEntryScoreBuy += coinDnaCode == COIN_DNA_TREND_DRIVER ? 0.12 : 0.0
    institutionalEntryScoreBuy += htfStructureBias >= 0 ? 0.20 : 0.0
    institutionalEntryScoreBuy += nearTrueLowerPool ? 0.15 : 0.0
    institutionalEntryScoreBuy += volatilityExpansionReady ? 0.15 : 0.0
    institutionalEntryScoreBuy += close <= emaFast + atrValue * 0.25 ? 0.20 : 0.0
    institutionalEntryScoreBuy += riskBuy <= atrValue * 1.05 ? 0.35 : riskBuy <= atrValue * 1.25 ? 0.20 : 0.0
    institutionalEntryScoreBuy += buyConfluenceStrongEff ? 0.22 : buyConfluenceReadyEff ? 0.10 : 0.0
    institutionalEntryScoreBuy += buySeedSoft ? 0.08 : 0.0
    institutionalEntryScoreBuy += math.max(sessionBiasEff, 0.0) * 0.12

    float activeMinRrBuy =
         strongSupportRejection ?
         math.max(0.34, minValidRrDynamic - 0.20) :
         buyNeedsRelaxedBuild ?
         math.max(0.36, minValidRrDynamic - 0.18) :
         useEarlyBuyBuild ?
         math.max(0.40, minValidRrDynamic - EARLY_RR_RELAX - math.min(earlyBuildQualityBuy * 0.03, 0.08)) :
         minValidRrDynamic

    validBuy := (slBuy < entryBuy) and (tp1Buy > entryBuy) and (riskBuy >= minRisk) and (riskBuy <= maxRisk) and (rrBuy >= activeMinRrBuy) and spaceBuyOk and (institutionalEntryScoreBuy >= 0.10)


    float tp2CapBuy =
         strongSupportRejection ? 1.85 :
         candidateSetupTypeBuy == SETUP_CONTINUATION ? 2.10 :
         candidateSetupTypeBuy == SETUP_RECLAIM ? 1.95 :
         candidateSetupTypeBuy == SETUP_SWEEP ? 1.85 :
         candidateSetupTypeBuy == SETUP_LIQUIDITY_TRAP ? 1.85 :
         candidateSetupTypeBuy == SETUP_BREAKOUT_BUILD ? 2.15 : 1.90

    float tp3CapBuy =
         strongSupportRejection ? 2.35 :
         candidateSetupTypeBuy == SETUP_CONTINUATION ? 2.90 :
         candidateSetupTypeBuy == SETUP_RECLAIM ? 2.55 :
         candidateSetupTypeBuy == SETUP_SWEEP ? 2.35 :
         candidateSetupTypeBuy == SETUP_LIQUIDITY_TRAP ? 2.35 :
         candidateSetupTypeBuy == SETUP_BREAKOUT_BUILD ? 3.00 : 2.45

    tp2CapBuy *= math.max(0.86, math.min(exitTp2MulBuy, 1.35))
    tp3CapBuy *= math.max(0.84, math.min(exitTp3MulBuy, 1.55))

    tp2Buy := math.max(tp1Buy + atrValue * 0.38, entryBuy + riskBuy * math.min(rr2Buy, tp2CapBuy))
    tp3Buy := math.max(tp2Buy + atrValue * 0.55, entryBuy + riskBuy * math.min(rr3Buy, tp3CapBuy))

    [validBuy, entryBuy, slBuy, tp1Buy, tp2Buy, tp3Buy, levBuy, buyRiskPct, buyMarginLossPct, riskBuy, candidateSetupTypeBuy]

//======================================================
// SELL BUILDER
//======================================================
d3_buildSellSetup() =>
    bool validSell = false
    float entrySell = na
    float slSell = na
    float tp1Sell = na
    float tp2Sell = na
    float tp3Sell = na
    float levSell = na
    float sellRiskPct = na
    float sellMarginLossPct = na
    float riskSell = na
    int candidateSetupTypeSell = sellSetupTypeEff

    bool sellIsTrendContinuation =
         candidateSetupTypeSell == SETUP_CONTINUATION or
         candidateSetupTypeSell == SETUP_BREAKOUT_BUILD

    bool sellNeedsRelaxedBuild =
         candidateSetupTypeSell == SETUP_BREAKOUT_BUILD or
         candidateSetupTypeSell == SETUP_CONTINUATION or
         candidateSetupTypeSell == SETUP_SWEEP or
         candidateSetupTypeSell == SETUP_LIQUIDITY_TRAP or
         candidateSetupTypeSell == SETUP_REVERSAL

    bool useEarlySellBuild =
         earlyBuildSell and
         (
             not sellCandidate or
             sellIsTrendContinuation or
             sellSeedSoft or
             strongResistanceRejection
         )

    float earlyBuildQualitySell = 0.0
    earlyBuildQualitySell += useEarlySellBuild ? 0.25 : 0.0
    earlyBuildQualitySell += sellSeedSoft ? 0.10 : 0.0
    earlyBuildQualitySell += sellConfluenceStrongEff ? 0.25 : sellConfluenceReadyEff ? 0.12 : 0.0
    earlyBuildQualitySell += math.max(-sessionBiasEff, 0.0) * EARLY_BUILD_SESSION_BOOST
    earlyBuildQualitySell += liquidityPathBias == 1 ? EARLY_BUILD_PATH_BOOST : 0.0
    earlyBuildQualitySell += sessionReclaimSellRef ? 0.12 : 0.0
    earlyBuildQualitySell += sessionBreakoutPressureSellRef ? 0.10 : 0.0
    earlyBuildQualitySell += strongResistanceRejection ? 0.18 : 0.0

    int executionModeSell = executionModeSellEff

    float entrySellBase =
         strongResistanceRejection ? math.min(close, close - barRange * 0.02) :
         (candidateSetupTypeSell == SETUP_SWEEP or candidateSetupTypeSell == SETUP_LIQUIDITY_TRAP) ?
         math.min(close, close + barRange * 0.02) :
         candidateSetupTypeSell == SETUP_BREAKOUT_BUILD ?
         math.min(close, nz(currentSessionLowRef, nz(prevSessionLowRef, low + barRange * 0.12))) :
         useEarlySellBuild ?
         math.min(close, low + barRange * 0.34) :
         math.min(close, low + barRange * 0.20)

    float entrySellBuffer =
         strongResistanceRejection ? activeEntryBufferSell * 0.35 :
         candidateSetupTypeSell == SETUP_BREAKOUT_BUILD ? activeEntryBufferSell * 0.55 :
         candidateSetupTypeSell == SETUP_CONTINUATION ? activeEntryBufferSell * 0.55 :
         useEarlySellBuild ? activeEntryBufferSell * math.max(0.50, EARLY_ENTRY_BUFFER_MULT - math.min(earlyBuildQualitySell * 0.10, 0.20)) :
         activeEntryBufferSell

    entrySell := entrySellBase - entrySellBuffer

    float scorePadSell   = sellFinalScoreEff >= 9 ? atrValue * 0.08 : sellFinalScoreEff >= 6.8 ? atrValue * 0.05 : atrValue * 0.02
    float profilePadSell = wickinessScore > 1.20 ? atrValue * 0.05 : 0.0
    float fakeoutPadSell = fakeoutScore > 0.35 ? atrValue * 0.04 : 0.0

    float liquidityPadSell = 0.0
    liquidityPadSell += bearTrap ? atrValue * 0.08 : 0.0
    liquidityPadSell += bearTrapEarly ? atrValue * 0.06 : 0.0
    liquidityPadSell += bearTrapStrict ? atrValue * 0.08 : 0.0
    liquidityPadSell += bearSweep ? atrValue * 0.09 : 0.0
    liquidityPadSell += lsSellStrict ? atrValue * 0.08 : 0.0
    liquidityPadSell += strongLiquiditySell ? atrValue * 0.06 : 0.0
    liquidityPadSell += trapSell ? atrValue * 0.06 : 0.0
    liquidityPadSell += hiddenLiquiditySell ? atrValue * 0.05 : 0.0
    liquidityPadSell += sessionReclaimSellRef ? atrValue * 0.08 : 0.0
    liquidityPadSell += sessionRejectSellRef ? atrValue * 0.05 : 0.0
    liquidityPadSell += softResistanceReject ? atrValue * 0.05 : 0.0
    liquidityPadSell += localBlowoffSell ? atrValue * 0.05 : 0.0
    liquidityPadSell += strongResistanceRejection ? atrValue * 0.10 : 0.0
    liquidityPadSell += tcSellStrict ? atrValue * 0.03 : 0.0
    liquidityPadSell += volatilityExpansionReady ? atrValue * 0.03 : 0.0

    float currentUpperWickAtrSell = safeDiv(upperWick, math.max(atrValue, syminfo.mintick), 0.0)
    float currentUpperWickBodySell = safeDiv(upperWick, math.max(bodyBase, syminfo.mintick), 0.0)
    float wickAdaptivePadSell = 0.0
    wickAdaptivePadSell += currentUpperWickAtrSell >= 0.30 ? atrValue * 0.03 : 0.0
    wickAdaptivePadSell += currentUpperWickAtrSell >= 0.55 ? atrValue * 0.04 : 0.0
    wickAdaptivePadSell += currentUpperWickBodySell >= 1.20 ? atrValue * 0.03 : 0.0
    wickAdaptivePadSell += currentUpperWickBodySell >= 1.80 ? atrValue * 0.03 : 0.0

    float executionStopMultSell =
         strongResistanceRejection or sellInstitutionalRejection ? 1.00 :
         executionModeSell == EXEC_MODE_CONT ? 0.74 :
         executionModeSell == EXEC_MODE_RECLAIM ? 0.90 :
         executionModeSell == EXEC_MODE_SWEEP ? 1.02 :
         executionModeSell == EXEC_MODE_BREAKOUT ? 0.86 : 0.86

    float stopPadSell = (adaptiveStopPad + scorePadSell + profilePadSell + fakeoutPadSell + liquidityPadSell + wickAdaptivePadSell) * executionStopMultSell
    stopPadSell := useEarlySellBuild ? stopPadSell * math.max(0.96, EARLY_STOP_PAD_MULT - math.min(earlyBuildQualitySell * 0.04, 0.10)) : stopPadSell
    if is15m
        stopPadSell += atrValue * 0.04

    float wickStopPadSell = stopPadSell * (strongResistanceRejection or sellInstitutionalRejection ? 0.52 : trapSell or bearSweep or bearTrapStrict ? 0.60 : 0.58)
    float levelStopPadSell = stopPadSell * (strongResistanceRejection or sellInstitutionalRejection ? 0.46 : sessionReclaimSellRef or relaySweepAbove ? 0.50 : 0.52)

    float localStructContSell    = ta.highest(high, STRUCT_CONT_LOOKBACK)
    float localStructReclaimSell = ta.highest(high, STRUCT_RECLAIM_LOOKBACK)
    float localStructSweepSell   = ta.highest(high, STRUCT_SWEEP_LOOKBACK)
    float reclaimHighSell        = math.max(high, high[1])
    float breakdownBaseSell      = not na(currentSessionLowRef) ? currentSessionLowRef : not na(prevSessionLowRef) ? prevSessionLowRef : not na(supportTop) ? supportTop : localStructReclaimSell

    float wickAnchorSell = math.max(high, reclaimHighSell)
    float levelAnchorSell = minAbove(entrySell, currentSessionHighRef, prevSessionHighRef, relayHighRef, resistanceBottom, resistanceTop, lastPivotHigh, trueLiquidityHigh, emaSlow)
    float resistanceAnchorSell = minAbove(entrySell, resistanceTop, currentSessionHighRef, relayHighRef, trueLiquidityHigh, prevSessionHighRef, lastPivotHigh, emaSlow, float(na))
    float reclaimAnchorSell = minAbove(entrySell, currentSessionHighRef, prevSessionHighRef, relayHighRef, localStructReclaimSell, reclaimHighSell, resistanceTop, trueLiquidityHigh, emaSlow)
    float sweepAnchorSell = minAbove(entrySell, resistanceTop, high, localStructSweepSell, relayHighRef, currentSessionHighRef, trueLiquidityHigh, lastPivotHigh, emaSlow)
    float breakoutAnchorSell = minAbove(entrySell, currentSessionHighRef, prevSessionHighRef, relayHighRef, resistanceBottom, resistanceTop, lastPivotHigh, trueLiquidityHigh, localStructReclaimSell)

    float slContSell     = localStructContSell + stopPadSell * 0.42
    float slReclaimSell  = (na(reclaimAnchorSell) ? math.max(reclaimHighSell, localStructReclaimSell) : reclaimAnchorSell) + levelStopPadSell
    float slSweepSell    = (na(sweepAnchorSell) ? math.max(high, localStructSweepSell) : sweepAnchorSell) + wickStopPadSell
    float slBreakoutSell = (na(breakoutAnchorSell) ? breakdownBaseSell : breakoutAnchorSell) + stopPadSell * 0.38
    float slRejectSell   = (na(resistanceAnchorSell) ? wickAnchorSell : math.max(wickAnchorSell, resistanceAnchorSell)) + wickStopPadSell

    float rawSLSell = na(levelAnchorSell) ? entrySell + minRisk : levelAnchorSell + levelStopPadSell

    slSell := rawSLSell
    if candidateSetupTypeSell == SETUP_CONTINUATION
        slSell := math.min(rawSLSell, slContSell)
    else if candidateSetupTypeSell == SETUP_RECLAIM
        slSell := math.min(rawSLSell, slReclaimSell)
    else if candidateSetupTypeSell == SETUP_REVERSAL
        slSell := (strongResistanceRejection or sellInstitutionalRejection or trapSell or hiddenLiquiditySell) ? math.min(rawSLSell, slRejectSell) : math.min(rawSLSell, slReclaimSell)
    else if candidateSetupTypeSell == SETUP_SWEEP or candidateSetupTypeSell == SETUP_LIQUIDITY_TRAP
        slSell := math.max(rawSLSell, slSweepSell)
    else if candidateSetupTypeSell == SETUP_BREAKOUT_BUILD
        slSell := math.min(rawSLSell, slBreakoutSell)

    if sessionReclaimSellRef and not na(currentSessionHighRef)
        slSell := math.min(slSell, currentSessionHighRef + levelStopPadSell)
    if relaySweepAbove and not na(relayHighRef)
        slSell := math.min(slSell, relayHighRef + levelStopPadSell)
    if softResistanceReject
        slSell := math.min(slSell, wickAnchorSell + stopPadSell * 0.44)
    if localBlowoffSell
        slSell := math.min(slSell, wickAnchorSell + stopPadSell * 0.52)
    if strongResistanceRejection or sellInstitutionalRejection
        slSell := math.min(slSell, slRejectSell)

    float maxSlAtrSell =
         strongResistanceRejection or sellInstitutionalRejection ? (is15m ? 1.20 : 1.32) :
         candidateSetupTypeSell == SETUP_CONTINUATION ? (is15m ? 1.05 : 1.18) :
         candidateSetupTypeSell == SETUP_RECLAIM ? (is15m ? 1.24 : 1.38) :
         candidateSetupTypeSell == SETUP_SWEEP ? (is15m ? 1.34 : 1.48) :
         candidateSetupTypeSell == SETUP_LIQUIDITY_TRAP ? (is15m ? 1.34 : 1.48) :
         candidateSetupTypeSell == SETUP_BREAKOUT_BUILD ? (is15m ? 1.14 : 1.28) :
         (is15m ? 1.16 : 1.30)

    if slSell - entrySell > atrValue * maxSlAtrSell
        slSell := entrySell + atrValue * maxSlAtrSell

    if slSell - entrySell < minSLDist
        slSell := entrySell + minSLDist

    levSell := d3_resolveLeverage(SIDE_SELL, candidateSetupTypeSell, is5m)
    float maxRiskPctSell       = d3_finalMaxRiskPct(levSell, D3_MAX_MARGIN_LOSS_PCT, D3_LIQUIDATION_BUFFER_PCT)
    float maxRiskDistLeverSell = d3_riskDistFromPct(entrySell, maxRiskPctSell)

    riskSell := slSell - entrySell
    float maxRiskHardSellAtr = atrValue * (is5m ? 2.4 : 2.2)
    float maxRiskHardSell    = D3_ENABLE_LEVER_FIRST_ENGINE ? math.min(maxRiskHardSellAtr, maxRiskDistLeverSell) : maxRiskHardSellAtr

    if riskSell > maxRiskHardSell
        riskSell := maxRiskHardSell
        slSell := entrySell + riskSell

    if riskSell < minSLDist
        riskSell := minSLDist
        slSell := entrySell + riskSell

    sellRiskPct       := d3_priceRiskPctShort(entrySell, slSell)
    sellMarginLossPct := d3_marginLossPct(sellRiskPct, levSell)

    float rrBoostSell = 0.0
    if ENABLE_DYNAMIC_RR_ENGINE
        rrBoostSell += sellFinalScoreEff >= 9 ? 0.22 : sellFinalScoreEff >= 6.8 ? 0.12 : 0.0
        rrBoostSell += tcSellStrict ? 0.10 : 0.0
        rrBoostSell += bearTrapStrict ? 0.08 : 0.0
        rrBoostSell += lsSellStrict ? 0.06 : 0.0
        rrBoostSell += marketMemoryBias == -1 ? 0.08 : 0.0
        rrBoostSell += coinDnaCode == COIN_DNA_TREND_DRIVER ? 0.08 : 0.0
        rrBoostSell += coinDnaCode == COIN_DNA_MOMENTUM_EXPLOSIVE ? 0.10 : 0.0
        rrBoostSell += nearCurrentSessionHigh ? 0.06 : 0.0
        rrBoostSell += nearRelayHigh ? 0.05 : 0.0
        rrBoostSell += sessionReclaimSellRef ? 0.08 : 0.0
        rrBoostSell += strongResistanceRejection ? 0.14 : 0.0
        rrBoostSell += microRangeActive ? -0.10 : 0.0
        rrBoostSell += coinVeryCrowdedMarket ? -0.12 : 0.0
        rrBoostSell += htfStructureBias <= 0 ? 0.08 : 0.0
        rrBoostSell += volatilityExpansionReady ? 0.08 : 0.0
        rrBoostSell += sellConfluenceStrongEff ? 0.10 : sellConfluenceReadyEff ? 0.04 : 0.0
        rrBoostSell += math.max(-sessionBiasEff, 0.0) * 0.05

    [exitTp1MulSell, exitTp2MulSell, exitTp3MulSell, _] = d3_adaptiveExitProfile(regimeCode, sellIntentEff, candidateSetupTypeSell, sellFinalScoreEff, strongResistanceRejection)

    float rr1Sell = 0.95 + rrBoostSell
    rr1Sell += regimeCode == REGIME_TREND_DOWN ? 0.10 : 0.0
    rr1Sell += sellIntentEff == INTENT_EXPANSION ? 0.10 : 0.0
    rr1Sell += sellIntentEff == INTENT_SCALP ? -0.05 : 0.0
    rr1Sell += is15m ? 0.05 : 0.0
    rr1Sell *= exitTp1MulSell

    float rr1SellFloor =
         strongResistanceRejection ? 0.90 :
         candidateSetupTypeSell == SETUP_CONTINUATION ? 1.18 :
         candidateSetupTypeSell == SETUP_RECLAIM ? 1.08 :
         candidateSetupTypeSell == SETUP_SWEEP ? 1.00 :
         candidateSetupTypeSell == SETUP_LIQUIDITY_TRAP ? 1.00 :
         candidateSetupTypeSell == SETUP_BREAKOUT_BUILD ? 1.12 : 0.95

    rr1SellFloor *= math.min(exitTp1MulSell, 1.08)
    rr1Sell := math.max(rr1SellFloor, rr1Sell)

    float rr2Sell = (rr1Sell + 0.65 + math.max(rrBoostSell * 0.45, 0.0)) * math.max(0.86, math.min(exitTp2MulSell, 1.35))
    float rr3Sell = (rr2Sell + 0.72 + math.max(rrBoostSell * 0.55, 0.0)) * math.max(0.84, math.min(exitTp3MulSell, 1.55))

    float tp1RefSell             = maxBelow(entrySell, currentSessionLowRef, prevSessionLowRef, relayLowRef, supportTop, lastPivotLow, trueLiquidityLow, dayLowPrev, weekLowPrev)
    float tp1SessionFallbackSell = not na(sellSessionTargetRef) and sellSessionTargetRef < entrySell ? sellSessionTargetRef + tpBuffer : na
    tp1Sell := not na(tp1RefSell) ? tp1RefSell + tpBuffer : not na(tp1SessionFallbackSell) ? tp1SessionFallbackSell : entrySell - riskSell * rr1Sell

    float maxTp1AtrSell =
         strongResistanceRejection ? (is15m ? 2.20 : 2.45) :
         candidateSetupTypeSell == SETUP_CONTINUATION ? (is15m ? 2.80 : 3.10) :
         candidateSetupTypeSell == SETUP_RECLAIM ? (is15m ? 2.45 : 2.80) :
         candidateSetupTypeSell == SETUP_SWEEP ? (is15m ? 2.30 : 2.60) :
         candidateSetupTypeSell == SETUP_LIQUIDITY_TRAP ? (is15m ? 2.30 : 2.60) :
         candidateSetupTypeSell == SETUP_BREAKOUT_BUILD ? (is15m ? 2.90 : 3.20) :
         (is15m ? 2.50 : 2.80)

    tp1Sell := math.max(tp1Sell, entrySell - atrValue * maxTp1AtrSell)

    bool sellAllowStructuralTp1 =
         candidateSetupTypeSell == SETUP_BREAKOUT_BUILD or
         candidateSetupTypeSell == SETUP_CONTINUATION or
         candidateSetupTypeSell == SETUP_SWEEP or
         candidateSetupTypeSell == SETUP_LIQUIDITY_TRAP or
         useEarlySellBuild or
         strongResistanceRejection

    tp1Sell := sellAllowStructuralTp1 ? tp1Sell : math.min(tp1Sell, entrySell - riskSell * rr1Sell)

    float rrSell = (entrySell - tp1Sell) / math.max(riskSell, syminfo.mintick * 2)
    float spaceSell = not na(tp1RefSell) ? (entrySell - tp1RefSell) : (entrySell - tp1Sell)

    float activeSpaceMultSell =
         strongResistanceRejection ? math.max(0.42, adaptiveSpaceMult * 0.52) :
         sellNeedsRelaxedBuild ? math.max(0.46, adaptiveSpaceMult * 0.60) :
         useEarlySellBuild ? adaptiveSpaceMult * math.max(0.74, EARLY_SPACE_RELAX_MULT - math.min(earlyBuildQualitySell * 0.05, 0.12)) :
         adaptiveSpaceMult

    bool spaceSellOk =
         strongResistanceRejection ?
         (spaceSell >= riskSell * activeSpaceMultSell * 0.72) :
         sellNeedsRelaxedBuild ?
         (spaceSell >= riskSell * activeSpaceMultSell * 0.80) :
         (spaceSell >= riskSell * activeSpaceMultSell and spaceSell >= adaptiveMinSpaceAbs)

    float institutionalEntryScoreSell = 0.0
    institutionalEntryScoreSell += candidateSetupTypeSell == SETUP_LIQUIDITY_TRAP ? 0.35 : 0.0
    institutionalEntryScoreSell += candidateSetupTypeSell == SETUP_SWEEP ? 0.25 : 0.0
    institutionalEntryScoreSell += candidateSetupTypeSell == SETUP_RECLAIM ? 0.22 : 0.0
    institutionalEntryScoreSell += candidateSetupTypeSell == SETUP_CONTINUATION ? 0.18 : 0.0
    institutionalEntryScoreSell += nearCurrentSessionHigh ? 0.24 : 0.0
    institutionalEntryScoreSell += nearRelayHigh ? 0.22 : 0.0
    institutionalEntryScoreSell += sessionReclaimSellRef ? 0.28 : 0.0
    institutionalEntryScoreSell += sessionBreakoutPressureSellRef ? 0.20 : 0.0
    institutionalEntryScoreSell += bearTrap ? 0.50 : 0.0
    institutionalEntryScoreSell += softBearReclaim ? 0.50 : 0.0
    institutionalEntryScoreSell += resistanceZoneQuality >= 2.8 ? 0.40 : 0.0
    institutionalEntryScoreSell += softResistanceReject ? 0.25 : 0.0
    institutionalEntryScoreSell += localBlowoffSell ? 0.20 : 0.0
    institutionalEntryScoreSell += hiddenLiquiditySell ? 0.20 : 0.0
    institutionalEntryScoreSell += strongLiquiditySell ? 0.30 : 0.0
    institutionalEntryScoreSell += strongResistanceRejection ? 0.52 : 0.0
    institutionalEntryScoreSell += trapSell ? 0.25 : 0.0
    institutionalEntryScoreSell += tcSellStrict ? 0.25 : 0.0
    institutionalEntryScoreSell += bearTrapStrict ? 0.25 : 0.0
    institutionalEntryScoreSell += lsSellStrict ? 0.18 : 0.0
    institutionalEntryScoreSell += marketMemoryBias == -1 ? 0.20 : 0.0
    institutionalEntryScoreSell += coinDnaCode == COIN_DNA_TREND_DRIVER ? 0.12 : 0.0
    institutionalEntryScoreSell += htfStructureBias <= 0 ? 0.20 : 0.0
    institutionalEntryScoreSell += nearTrueUpperPool ? 0.15 : 0.0
    institutionalEntryScoreSell += volatilityExpansionReady ? 0.15 : 0.0
    institutionalEntryScoreSell += close >= emaFast - atrValue * 0.25 ? 0.20 : 0.0
    institutionalEntryScoreSell += riskSell <= atrValue * 1.05 ? 0.35 : riskSell <= atrValue * 1.25 ? 0.20 : 0.0
    institutionalEntryScoreSell += sellConfluenceStrongEff ? 0.22 : sellConfluenceReadyEff ? 0.10 : 0.0
    institutionalEntryScoreSell += sellSeedSoft ? 0.08 : 0.0
    institutionalEntryScoreSell += math.max(-sessionBiasEff, 0.0) * 0.12

    float activeMinRrSell =
         strongResistanceRejection ?
         math.max(0.34, minValidRrDynamic - 0.20) :
         sellNeedsRelaxedBuild ?
         math.max(0.36, minValidRrDynamic - 0.18) :
         useEarlySellBuild ?
         math.max(0.40, minValidRrDynamic - EARLY_RR_RELAX - math.min(earlyBuildQualitySell * 0.03, 0.08)) :
         minValidRrDynamic

    validSell := (slSell > entrySell) and (tp1Sell < entrySell) and (riskSell >= minRisk) and (riskSell <= maxRisk) and (rrSell >= activeMinRrSell) and spaceSellOk and (institutionalEntryScoreSell >= 0.10)


    float tp2CapSell =
         strongResistanceRejection ? 1.85 :
         candidateSetupTypeSell == SETUP_CONTINUATION ? 2.10 :
         candidateSetupTypeSell == SETUP_RECLAIM ? 1.95 :
         candidateSetupTypeSell == SETUP_SWEEP ? 1.85 :
         candidateSetupTypeSell == SETUP_LIQUIDITY_TRAP ? 1.85 :
         candidateSetupTypeSell == SETUP_BREAKOUT_BUILD ? 2.15 : 1.90

    float tp3CapSell =
         strongResistanceRejection ? 2.35 :
         candidateSetupTypeSell == SETUP_CONTINUATION ? 2.90 :
         candidateSetupTypeSell == SETUP_RECLAIM ? 2.55 :
         candidateSetupTypeSell == SETUP_SWEEP ? 2.35 :
         candidateSetupTypeSell == SETUP_LIQUIDITY_TRAP ? 2.35 :
         candidateSetupTypeSell == SETUP_BREAKOUT_BUILD ? 3.00 : 2.45

    tp2CapSell *= math.max(0.86, math.min(exitTp2MulSell, 1.35))
    tp3CapSell *= math.max(0.84, math.min(exitTp3MulSell, 1.55))

    tp2Sell := math.min(tp1Sell - atrValue * 0.38, entrySell - riskSell * math.min(rr2Sell, tp2CapSell))
    tp3Sell := math.min(tp2Sell - atrValue * 0.55, entrySell - riskSell * math.min(rr3Sell, tp3CapSell))

    [validSell, entrySell, slSell, tp1Sell, tp2Sell, tp3Sell, levSell, sellRiskPct, sellMarginLossPct, riskSell, candidateSetupTypeSell]

//======================================================
// PRE VISUALIZATION
//======================================================
if barstate.isconfirmed and not pendingActive and not tradeActive
    if preBuyNow
        setupStatus := STATUS_PRE
        setupSide := SIDE_BUY
        setupTypeTxt := setupTypeText(buySetupTypeEff)
        setupIntentTxt := intentText(buyIntentEff)
        setupScore := buyFinalScoreEff
        setupGrade := buyGradeEff
        setupConf := buyConfEff
        setupZoneTxt := buyZoneTxtEff
        setupRegimeTxt := buyRegimeTxtEff
        string preBuyTxt = SHOW_SIGNAL_LABELS ? "BUY PRE | " + setupTypeTxt + " | " + setupIntentTxt + " | " + setupConf + " | " + d3_confText(SIDE_BUY) + " | " + sessionBiasText(sessionBiasEff) : ""
        if na(sigLbl)
            sigLbl := label.new(bar_index, low - atrValue * 0.20, preBuyTxt, xloc=xloc.bar_index, style=label.style_label_up, color=preBuyColor, textcolor=color.black, size=size.small)
        else
            label.set_xy(sigLbl, bar_index, low - atrValue * 0.20)
            label.set_text(sigLbl, preBuyTxt)
            label.set_color(sigLbl, preBuyColor)
            label.set_style(sigLbl, label.style_label_up)
        if na(infoLbl)
            infoLbl := label.new(bar_index + 1, infoStateY, d3_buildInfoText(SIDE_BUY, STATUS_PRE), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.blue, 72), textcolor=color.white, size=size.small)
        else
            label.set_x(infoLbl, bar_index + 1)
            label.set_text(infoLbl, d3_buildInfoText(SIDE_BUY, STATUS_PRE))

    if preSellNow
        setupStatus := STATUS_PRE
        setupSide := SIDE_SELL
        setupTypeTxt := setupTypeText(sellSetupTypeEff)
        setupIntentTxt := intentText(sellIntentEff)
        setupScore := sellFinalScoreEff
        setupGrade := sellGradeEff
        setupConf := sellConfEff
        setupZoneTxt := sellZoneTxtEff
        setupRegimeTxt := sellRegimeTxtEff
        string preSellTxt = SHOW_SIGNAL_LABELS ? "SELL PRE | " + setupTypeTxt + " | " + setupIntentTxt + " | " + setupConf + " | " + d3_confText(SIDE_SELL) + " | " + sessionBiasText(sessionBiasEff) : ""
        if na(sigLbl)
            sigLbl := label.new(bar_index, high + atrValue * 0.20, preSellTxt, xloc=xloc.bar_index, style=label.style_label_down, color=preSellColor, textcolor=color.black, size=size.small)
        else
            label.set_xy(sigLbl, bar_index, high + atrValue * 0.20)
            label.set_text(sigLbl, preSellTxt)
            label.set_color(sigLbl, preSellColor)
            label.set_style(sigLbl, label.style_label_down)
        if na(infoLbl)
            infoLbl := label.new(bar_index + 1, infoStateY, d3_buildInfoText(SIDE_SELL, STATUS_PRE), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.blue, 72), textcolor=color.white, size=size.small)
        else
            label.set_x(infoLbl, bar_index + 1)
            label.set_text(infoLbl, d3_buildInfoText(SIDE_SELL, STATUS_PRE))

//======================================================
// BUILD BUY
//======================================================
if barstate.isconfirmed and buyBuildNow and not pendingActive and not tradeActive
    [validBuyBuilt, entryBuyBuilt, slBuyBuilt, tp1BuyBuilt, tp2BuyBuilt, tp3BuyBuilt, levBuyBuilt, buyRiskPctBuilt, buyMarginLossPctBuilt, riskBuyBuilt, buySetupTypeBuilt] = d3_buildBuySetup()


    if validBuyBuilt
        d3_clearVisuals()

        pendingActive := true
        tradeActive := false
        movedToBE := false
        tp1Taken := false
        tp2Taken := false
        tp3Taken := false

        setupSide := SIDE_BUY
        setupBar := bar_index
        setupStatus := STATUS_READY

        setupEntry := entryBuyBuilt
        setupSL := slBuyBuilt
        setupTP1 := tp1BuyBuilt
        setupTP2 := tp2BuyBuilt
        setupTP3 := tp3BuyBuilt
        setupScore := buyFinalScoreEff

        setupGrade := buyGradeEff
        setupConf := buyConfEff
        setupIntentTxt := intentText(buyIntentEff)
        setupZoneTxt := buyZoneTxtEff
        setupRegimeTxt := buyRegimeTxtEff
        setupTypeTxt := setupTypeText(buySetupTypeBuilt)

        [_, _, _, exitBeOffsetRBuyBuilt] = d3_adaptiveExitProfile(regimeCode, buyIntentEff, buySetupTypeBuilt, buyFinalScoreEff, strongSupportRejection)

        setupLev := levBuyBuilt
        setupRiskPct := buyRiskPctBuilt
        setupMarginLossPct := buyMarginLossPctBuilt
        setupNotionalRisk := riskBuyBuilt
        setupBEOffsetR := exitBeOffsetRBuyBuilt

        int xRightBuy = bar_index + EXTEND_BARS
        int xLabelBuy = xRightBuy + LABEL_COLUMN_OFFSET
        color sigColorBuy = d3_signalColorBySideAndScore(SIDE_BUY, setupScore)

        entryLine := line.new(bar_index, setupEntry, xRightBuy, setupEntry, xloc=xloc.bar_index, color=color.white, width=2)
        slLine    := line.new(bar_index, setupSL, xRightBuy, setupSL, xloc=xloc.bar_index, color=color.red, width=2)
        tp1Line   := line.new(bar_index, setupTP1, xRightBuy, setupTP1, xloc=xloc.bar_index, color=color.lime, width=2)
        tp2Line   := line.new(bar_index, setupTP2, xRightBuy, setupTP2, xloc=xloc.bar_index, color=color.new(color.lime, 15), style=line.style_dashed, width=1)
        tp3Line   := line.new(bar_index, setupTP3, xRightBuy, setupTP3, xloc=xloc.bar_index, color=color.new(color.lime, 35), style=line.style_dashed, width=1)

        sigLbl   := label.new(bar_index, low, SHOW_SIGNAL_LABELS ? "BUY READY | " + setupTypeTxt + " | " + setupGrade + " | " + setupIntentTxt + " | " + setupConf : "", xloc=xloc.bar_index, style=label.style_label_up, color=sigColorBuy, textcolor=color.white, size=size.normal)
        infoLbl  := label.new(bar_index + 1, infoStateY, d3_buildInfoText(SIDE_BUY, STATUS_READY), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.blue, 68), textcolor=color.white, size=size.small)
        entryLbl := label.new(xLabelBuy, setupEntry, "ENTRY " + str.tostring(setupEntry, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.white, textcolor=color.black, size=size.small)
        slLbl    := label.new(xLabelBuy, setupSL, "SL " + str.tostring(setupSL, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)
        tp1Lbl   := label.new(xLabelBuy, setupTP1, "TP1 " + str.tostring(setupTP1, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.lime, textcolor=color.black, size=size.small)
        tp2Lbl   := label.new(xLabelBuy, setupTP2, "TP2 " + str.tostring(setupTP2, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.lime, 15), textcolor=color.black, size=size.small)
        tp3Lbl   := label.new(xLabelBuy, setupTP3, "TP3 " + str.tostring(setupTP3, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.lime, 35), textcolor=color.black, size=size.small)

//======================================================
// BUILD SELL
//======================================================
if barstate.isconfirmed and sellBuildNow and not pendingActive and not tradeActive
    [validSellBuilt, entrySellBuilt, slSellBuilt, tp1SellBuilt, tp2SellBuilt, tp3SellBuilt, levSellBuilt, sellRiskPctBuilt, sellMarginLossPctBuilt, riskSellBuilt, sellSetupTypeBuilt] = d3_buildSellSetup()


    if validSellBuilt
        d3_clearVisuals()

        pendingActive := true
        tradeActive := false
        movedToBE := false
        tp1Taken := false
        tp2Taken := false
        tp3Taken := false

        setupSide := SIDE_SELL
        setupBar := bar_index
        setupStatus := STATUS_READY

        setupEntry := entrySellBuilt
        setupSL := slSellBuilt
        setupTP1 := tp1SellBuilt
        setupTP2 := tp2SellBuilt
        setupTP3 := tp3SellBuilt
        setupScore := sellFinalScoreEff

        setupGrade := sellGradeEff
        setupConf := sellConfEff
        setupIntentTxt := intentText(sellIntentEff)
        setupZoneTxt := sellZoneTxtEff
        setupRegimeTxt := sellRegimeTxtEff
        setupTypeTxt := setupTypeText(sellSetupTypeBuilt)

        [_, _, _, exitBeOffsetRSellBuilt] = d3_adaptiveExitProfile(regimeCode, sellIntentEff, sellSetupTypeBuilt, sellFinalScoreEff, strongResistanceRejection)

        setupLev := levSellBuilt
        setupRiskPct := sellRiskPctBuilt
        setupMarginLossPct := sellMarginLossPctBuilt
        setupNotionalRisk := riskSellBuilt
        setupBEOffsetR := exitBeOffsetRSellBuilt

        int xRightSell = bar_index + EXTEND_BARS
        int xLabelSell = xRightSell + LABEL_COLUMN_OFFSET
        color sigColorSell = d3_signalColorBySideAndScore(SIDE_SELL, setupScore)

        entryLine := line.new(bar_index, setupEntry, xRightSell, setupEntry, xloc=xloc.bar_index, color=color.white, width=2)
        slLine    := line.new(bar_index, setupSL, xRightSell, setupSL, xloc=xloc.bar_index, color=color.red, width=2)
        tp1Line   := line.new(bar_index, setupTP1, xRightSell, setupTP1, xloc=xloc.bar_index, color=color.new(color.green, 0), width=2)
        tp2Line   := line.new(bar_index, setupTP2, xRightSell, setupTP2, xloc=xloc.bar_index, color=color.new(color.green, 15), style=line.style_dashed, width=1)
        tp3Line   := line.new(bar_index, setupTP3, xRightSell, setupTP3, xloc=xloc.bar_index, color=color.new(color.green, 35), style=line.style_dashed, width=1)

        sigLbl   := label.new(bar_index, high, SHOW_SIGNAL_LABELS ? "SELL READY | " + setupTypeTxt + " | " + setupGrade + " | " + setupIntentTxt + " | " + setupConf : "", xloc=xloc.bar_index, style=label.style_label_down, color=sigColorSell, textcolor=color.white, size=size.normal)
        infoLbl  := label.new(bar_index + 1, infoStateY, d3_buildInfoText(SIDE_SELL, STATUS_READY), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.blue, 68), textcolor=color.white, size=size.small)
        entryLbl := label.new(xLabelSell, setupEntry, "ENTRY " + str.tostring(setupEntry, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.white, textcolor=color.black, size=size.small)
        slLbl    := label.new(xLabelSell, setupSL, "SL " + str.tostring(setupSL, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)
        tp1Lbl   := label.new(xLabelSell, setupTP1, "TP1 " + str.tostring(setupTP1, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.green, 0), textcolor=color.black, size=size.small)
        tp2Lbl   := label.new(xLabelSell, setupTP2, "TP2 " + str.tostring(setupTP2, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.green, 15), textcolor=color.black, size=size.small)
        tp3Lbl   := label.new(xLabelSell, setupTP3, "TP3 " + str.tostring(setupTP3, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.green, 35), textcolor=color.black, size=size.small)

//======================================================
// PRE LABELS
//======================================================
plotshape(preBuyNow and not pendingActive and not tradeActive, title="PRE BUY", style=shape.arrowup, location=location.belowbar, color=preBuyColor, size=size.tiny, text="PRE", textcolor=color.new(color.aqua, 10))
plotshape(preSellNow and not pendingActive and not tradeActive, title="PRE SELL", style=shape.arrowdown, location=location.abovebar, color=preSellColor, size=size.tiny, text="PRE", textcolor=color.new(color.orange, 10))

//======================================================
// TRIGGER ELIGIBILITY
//======================================================
bool d3_buyStillEligible =
     not buyHardInvalidation and
     (d3_buyLockAlive or preBuyBase or buyBuildCandidate or buySeedSoft)

bool d3_sellStillEligible =
     not sellHardInvalidation and
     (d3_sellLockAlive or preSellBase or sellBuildCandidate or sellSeedSoft)

//======================================================
// TRIGGERS
//======================================================
// barstate.isconfirmed gates trigger to the closed bar, preventing intrabar
// label flicker in realtime (label could appear/disappear within the same bar).
bool buyTriggered  = barstate.isconfirmed and pendingActive and not tradeActive and setupSide == SIDE_BUY and d3_buyStillEligible and ((bar_index > setupBar) or (ENABLE_SAME_BAR_ENTRY and bar_index == setupBar and (setupScore >= SAME_BAR_MIN_SCORE or setupGrade == "A+"))) and high >= setupEntry
bool sellTriggered = barstate.isconfirmed and pendingActive and not tradeActive and setupSide == SIDE_SELL and d3_sellStillEligible and ((bar_index > setupBar) or (ENABLE_SAME_BAR_ENTRY and bar_index == setupBar and (setupScore >= SAME_BAR_MIN_SCORE or setupGrade == "A+"))) and low <= setupEntry

if buyTriggered
    tradeActive := true
    pendingActive := false
    setupStatus := STATUS_ACTIVE
    if not na(sigLbl)
        label.set_text(sigLbl, "BUY ACTIVE | " + setupTypeTxt + " | " + setupGrade + " | " + setupIntentTxt + " | " + d3_confText(SIDE_BUY) + " | " + sessionBiasText(sessionBiasEff))
        label.set_color(sigLbl, d3_signalColorBySideAndScore(SIDE_BUY, setupScore))
    if not na(infoLbl)
        label.set_text(infoLbl, d3_buildInfoText(SIDE_BUY, STATUS_ACTIVE))

if sellTriggered
    tradeActive := true
    pendingActive := false
    setupStatus := STATUS_ACTIVE
    if not na(sigLbl)
        label.set_text(sigLbl, "SELL ACTIVE | " + setupTypeTxt + " | " + setupGrade + " | " + setupIntentTxt + " | " + d3_confText(SIDE_SELL) + " | " + sessionBiasText(sessionBiasEff))
        label.set_color(sigLbl, d3_signalColorBySideAndScore(SIDE_SELL, setupScore))
    if not na(infoLbl)
        label.set_text(infoLbl, d3_buildInfoText(SIDE_SELL, STATUS_ACTIVE))

//======================================================
// TRADE MANAGEMENT
//======================================================
if not tradeActive
    movedToBE := false

bool closeTradeNow = false

if tradeActive
    float prevSL = setupSL
    bool slChangedThisBar = false
    float setupRiskAbs = math.max(nz(setupNotionalRisk, 0.0), syminfo.mintick * 2)

    if setupSide == SIDE_BUY
        bool buyTp1Now = high >= setupTP1
        bool buyTp2Now = high >= setupTP2
        bool buyTp3Now = high >= setupTP3
        float bePriceBuy = setupEntry + setupRiskAbs * setupBEOffsetR

        if buyTp1Now and not tp1Taken
            tp1Taken := true
            if MOVE_SL_TO_BE_AFTER_TP1 and not movedToBE
                movedToBE := true
                float beTargetBuy = math.max(setupEntry, bePriceBuy)
                if beTargetBuy > setupSL
                    setupSL := beTargetBuy
                    slChangedThisBar := true
                if not na(slLine)
                    line.set_y1(slLine, setupSL)
                    line.set_y2(slLine, setupSL)
                if not na(slLbl)
                    label.set_y(slLbl, setupSL)
                    label.set_text(slLbl, "BE " + str.tostring(setupSL, format.mintick))

        if buyTp2Now and not tp2Taken
            tp2Taken := true

        if buyTp3Now and not tp3Taken
            tp3Taken := true
            closeTradeNow := true

        bool buyStopNow =
             (
                 setupTypeTxt == "RECLAIM" or
                 setupTypeTxt == "REVERSAL" or
                 setupTypeTxt == "TRAP"
             )
             ? (close < (slChangedThisBar ? prevSL : setupSL) and low < (slChangedThisBar ? prevSL : setupSL))
             : (low <= (slChangedThisBar ? prevSL : setupSL))
        if buyStopNow
            closeTradeNow := true

    if setupSide == SIDE_SELL
        bool sellTp1Now = low <= setupTP1
        bool sellTp2Now = low <= setupTP2
        bool sellTp3Now = low <= setupTP3
        float bePriceSell = setupEntry - setupRiskAbs * setupBEOffsetR

        if sellTp1Now and not tp1Taken
            tp1Taken := true
            if MOVE_SL_TO_BE_AFTER_TP1 and not movedToBE
                movedToBE := true
                float beTargetSell = math.min(setupEntry, bePriceSell)
                if beTargetSell < setupSL
                    setupSL := beTargetSell
                    slChangedThisBar := true
                if not na(slLine)
                    line.set_y1(slLine, setupSL)
                    line.set_y2(slLine, setupSL)
                if not na(slLbl)
                    label.set_y(slLbl, setupSL)
                    label.set_text(slLbl, "BE " + str.tostring(setupSL, format.mintick))

        if sellTp2Now and not tp2Taken
            tp2Taken := true

        if sellTp3Now and not tp3Taken
            tp3Taken := true
            closeTradeNow := true

        bool sellStopNow =
             (
                 setupTypeTxt == "RECLAIM" or
                 setupTypeTxt == "REVERSAL" or
                 setupTypeTxt == "TRAP"
             )
             ? (close > (slChangedThisBar ? prevSL : setupSL) and high > (slChangedThisBar ? prevSL : setupSL))
             : (high >= (slChangedThisBar ? prevSL : setupSL))
        if sellStopNow
            closeTradeNow := true

if closeTradeNow
    d3_clearVisuals()

    d2_snapshotActive      := false
    d2_snapshotSide        := 0
    d2_snapshotSetupType   := SETUP_NONE
    d2_snapshotIntent      := INTENT_NONE
    d2_snapshotExecMode    := EXEC_MODE_SKIP
    d2_snapshotScore       := na
    d2_snapshotGrade       := ""
    d2_snapshotConf        := ""
    d2_snapshotZoneTxt     := ""
    d2_snapshotRegimeTxt   := ""
    d2_snapshotBuyConfl    := na
    d2_snapshotSellConfl   := na
    d2_snapshotSessionBias := na

    pendingActive := false
    tradeActive := false
    movedToBE := false
    tp1Taken := false
    tp2Taken := false
    tp3Taken := false

    setupSide := 0
    setupBar := na
    setupStatus := STATUS_NONE

    setupEntry := na
    setupSL := na
    setupTP1 := na
    setupTP2 := na
    setupTP3 := na
    setupScore := na

    setupGrade := ""
    setupConf := ""
    setupIntentTxt := ""
    setupZoneTxt := ""
    setupRegimeTxt := ""
    setupTypeTxt := ""

    setupLev := na
    setupRiskPct := na
    setupMarginLossPct := na
    setupNotionalRisk := na
    setupBEOffsetR := 0.0

//======================================================
// FOLLOW RIGHT
//======================================================
if pendingActive or tradeActive
    int xRightNow = bar_index + EXTEND_BARS
    int xLabelNow = xRightNow + LABEL_COLUMN_OFFSET

    if not na(entryLine)
        line.set_x2(entryLine, xRightNow)
    if not na(slLine)
        line.set_x2(slLine, xRightNow)
    if not na(tp1Line)
        line.set_x2(tp1Line, xRightNow)
    if not na(tp2Line)
        line.set_x2(tp2Line, xRightNow)
    if not na(tp3Line)
        line.set_x2(tp3Line, xRightNow)

    if not na(entryLbl)
        label.set_x(entryLbl, xLabelNow)
    if not na(slLbl)
        label.set_x(slLbl, xLabelNow)
    if not na(tp1Lbl)
        label.set_x(tp1Lbl, xLabelNow)
    if not na(tp2Lbl)
        label.set_x(tp2Lbl, xLabelNow)
    if not na(tp3Lbl)
        label.set_x(tp3Lbl, xLabelNow)

//======================================================
// INFO BAR
//======================================================
if barstate.islast
    if na(regimeInfo)
        regimeInfo := label.new(bar_index + 4, infoRegimeY, d3_buildRegimeInfoText(), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.navy, 60), textcolor=color.white, size=size.small)
    else
        label.set_x(regimeInfo, bar_index + 4)
        label.set_text(regimeInfo, d3_buildRegimeInfoText())

//======================================================
// EXTRA VISUALS
//======================================================
plotshape(lsBuyStrict, title="Liquidity Sweep Buy", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.tiny, text="LS")
plotshape(lsSellStrict, title="Liquidity Sweep Sell", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny, text="LS")

plotshape(bullTrapStrict, title="Bull Trap", style=shape.circle, location=location.belowbar, color=color.new(color.aqua, 0), size=size.tiny, text="TRAP")
plotshape(bullTrapEarly and not bullTrapStrict, title="Bull Trap Early", style=shape.circle, location=location.belowbar, color=color.new(color.aqua, 50), size=size.tiny, text="TRAP?")
plotshape(bearTrapStrict, title="Bear Trap", style=shape.circle, location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny, text="TRAP")
plotshape(bearTrapEarly and not bearTrapStrict, title="Bear Trap Early", style=shape.circle, location=location.abovebar, color=color.new(color.orange, 50), size=size.tiny, text="TRAP?")

plotshape(tcBuyStrict, title="Trend Continuation Buy", style=shape.diamond, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny, text="TC")
plotshape(tcSellStrict, title="Trend Continuation Sell", style=shape.diamond, location=location.abovebar, color=color.new(color.maroon, 0), size=size.tiny, text="TC")

plotshape(ENABLE_WHALE_VOLUME_ENGINE and whaleBullEvent, title="Whale Bull", style=shape.square, location=location.belowbar, color=color.new(color.lime, 0), size=size.tiny, text="W")
plotshape(ENABLE_WHALE_VOLUME_ENGINE and whaleBearEvent, title="Whale Bear", style=shape.square, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny, text="W")

plotshape(showLmBuyStrong, title="LM Buy Strong", style=shape.circle, location=location.belowbar, color=color.new(color.lime, 15), size=size.tiny, text="LM")
plotshape(showLmSellStrong, title="LM Sell Strong", style=shape.circle, location=location.abovebar, color=color.new(color.red, 15), size=size.tiny, text="LM")
plotshape(showLpBuyStrong and not showLmBuyStrong, title="Liquidity Path Up", style=shape.diamond, location=location.abovebar, color=color.new(color.aqua, 0), size=size.tiny, text="LP")
plotshape(showLpSellStrong and not showLmSellStrong, title="Liquidity Path Down", style=shape.diamond, location=location.belowbar, color=color.new(color.orange, 0), size=size.tiny, text="LP")

plotshape(sessionReclaimBuyRef, title="Session Reclaim Buy", style=shape.triangleup, location=location.belowbar, color=color.new(color.aqua, 0), size=size.tiny, text="SR")
plotshape(sessionReclaimSellRef, title="Session Reclaim Sell", style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny, text="SR")

plotshape(sessionBreakoutPressureBuyRef, title="Session Breakout Build Buy", style=shape.square, location=location.belowbar, color=color.new(color.green, 15), size=size.tiny, text="B+")
plotshape(sessionBreakoutPressureSellRef, title="Session Breakout Build Sell", style=shape.square, location=location.abovebar, color=color.new(color.red, 15), size=size.tiny, text="B+")

plotshape(SHOW_SECONDARY_SIGNALS and ENABLE_SESSION_BIAS_ENGINE and sessionBiasScore >= 0.85 and barstate.isconfirmed, title="Session Bias Strong Buy", style=shape.flag, location=location.belowbar, color=color.new(color.green, 15), size=size.tiny, text="SB+")
plotshape(SHOW_SECONDARY_SIGNALS and ENABLE_SESSION_BIAS_ENGINE and sessionBiasScore <= -0.85 and barstate.isconfirmed, title="Session Bias Strong Sell", style=shape.flag, location=location.abovebar, color=color.new(color.red, 15), size=size.tiny, text="SB-")

plotshape(SHOW_SECONDARY_SIGNALS and ENABLE_CONFLUENCE_ENGINE and buyConfluenceStrong, title="Buy Confluence Strong", style=shape.square, location=location.belowbar, color=color.new(color.aqua, 10), size=size.tiny, text="CF")
plotshape(SHOW_SECONDARY_SIGNALS and ENABLE_CONFLUENCE_ENGINE and sellConfluenceStrong, title="Sell Confluence Strong", style=shape.square, location=location.abovebar, color=color.new(color.orange, 10), size=size.tiny, text="CF")

plotshape(SHOW_SECONDARY_SIGNALS and volatilityExpansionReady, title="Vol Expansion Ready", style=shape.square, location=location.top, color=color.new(color.yellow, 10), size=size.tiny, text="VEXP")
bgcolor(microRangeActive ? color.new(color.yellow, 92) : na, title="Micro Range Background")

//======================================================
// ALERTS
//======================================================
alertcondition(buyTriggered, title="BUY ACTIVE", message="BUY setup triggered")
alertcondition(sellTriggered, title="SELL ACTIVE", message="SELL setup triggered")
alertcondition(preBuyNow, title="PRE BUY", message="PRE BUY detected")
alertcondition(preSellNow, title="PRE SELL", message="PRE SELL detected")
alertcondition(showLmBuyStrong, title="LM BUY", message="Elite LM BUY detected")
alertcondition(showLmSellStrong, title="LM SELL", message="Elite LM SELL detected")

alertcondition(lsBuyStrict, title="Liquidity Sweep Buy", message="Bullish liquidity sweep detected")
alertcondition(lsSellStrict, title="Liquidity Sweep Sell", message="Bearish liquidity sweep detected")
alertcondition(bullTrapStrict or bullTrapEarly, title="Bull Trap", message="Bull trap detected (check chart for early vs confirmed)")
alertcondition(bearTrapStrict or bearTrapEarly, title="Bear Trap", message="Bear trap detected (check chart for early vs confirmed)")
alertcondition(tcBuyStrict, title="Trend Continuation Buy", message="Trend continuation buy detected")
alertcondition(tcSellStrict, title="Trend Continuation Sell", message="Trend continuation sell detected")

alertcondition(sessionReclaimBuyRef or sessionBreakoutPressureBuyRef, title="SESSION BUY SIGNAL", message="Session reclaim or breakout build buy detected")
alertcondition(sessionReclaimSellRef or sessionBreakoutPressureSellRef, title="SESSION SELL SIGNAL", message="Session reclaim or breakout build sell detected")

alertcondition(strongSupportRejection, title="STRONG SUPPORT REJECTION", message="Strong bullish rejection from support detected")
alertcondition(strongResistanceRejection, title="STRONG RESISTANCE REJECTION", message="Strong bearish rejection from resistance detected")

alertcondition(ENABLE_WHALE_VOLUME_ENGINE and (whaleBullEvent or whaleAbsorptionBuy), title="WHALE BULL", message="Whale bull activity detected")
alertcondition(ENABLE_WHALE_VOLUME_ENGINE and (whaleBearEvent or whaleAbsorptionSell), title="WHALE BEAR", message="Whale bear activity detected")

alertcondition(showLpBuyStrong or (ENABLE_SESSION_BIAS_ENGINE and sessionBiasScore >= 0.85) or (ENABLE_CONFLUENCE_ENGINE and buyConfluenceStrong), title="BUY CONFLUENCE SIGNAL", message="Strong buy: LP/Session Bias/Confluence active")
alertcondition(showLpSellStrong or (ENABLE_SESSION_BIAS_ENGINE and sessionBiasScore <= -0.85) or (ENABLE_CONFLUENCE_ENGINE and sellConfluenceStrong), title="SELL CONFLUENCE SIGNAL", message="Strong sell: LP/Session Bias/Confluence active")

alertcondition(ENABLE_FALSE_BREAKOUT_FILTER and (falseBreakoutRiskBuy or falseBreakoutRiskSell), title="FALSE BREAKOUT RISK", message="High false breakout risk detected - check direction on chart")
alertcondition(preSweepBias != 0 or volatilityExpansionReady, title="MARKET CONDITION ALERT", message="Pre-sweep bias or volatility expansion detected")